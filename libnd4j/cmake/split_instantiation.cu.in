//
// GENERATED per-type split translation unit (do not edit).
// Defines SD_SPLIT_TYPE_INDEX and includes the op source, whose
// BUILD_*_TEMPLATE bulk instantiation is `#ifdef SD_SPLIT_TYPE_INDEX`-guarded to
// instantiate exactly the one corresponding type slice instead of the whole
// SD_COMMON_TYPES matrix. Generic across all split ops — the per-op detail
// (namespace, class, signature, secondary type list) stays in the op's own .cu.
// See cmake/SplitHeavyInstantiations.cmake.
//
#define SD_SPLIT_TYPE_INDEX @SD_SPLIT_IDX@
#define SD_SPLIT_TYPE_LIST SD_COMMON_TYPES_@SD_SPLIT_IDX@
#include <@OP_INCLUDE@>
