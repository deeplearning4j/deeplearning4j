#include <ops/impl/specials_single.hpp> // Original include
#include <system/type_boilerplate.h> // For type lists like SD_NUMERIC_TYPES_PART_X
#include <loops/pairwise_instantiations.h> // For ITERATE_COMBINATIONS macro
// Note: Instantiations are generated to prevent compiler memory issues

namespace sd {

#if defined(SD_CUDA)
// CUDA/ZLUDA only needs the two host sort entry points referenced by
// NativeOpExecutioner. Instantiating the complete SpecialMethods class here
// makes the Windows CUDA image exceed the PE/COFF 2 GiB limit.
#define SPECIAL_METHODS_DECL(T)                                                        \
  template void SpecialMethods<GET_SECOND(T)>::sortGeneric(NDArray *, bool);          \
  template void SpecialMethods<GET_SECOND(T)>::sortTadGeneric(                        \
      NDArray *, sd::LongType *, int, bool);
#else
#define SPECIAL_METHODS_DECL(T) template class SpecialMethods<GET_SECOND(T)>;
#endif
ITERATE_LIST(
    SD_COMMON_TYPES_PART_@COMB1@,
    SPECIAL_METHODS_DECL

)

} // namespace sd