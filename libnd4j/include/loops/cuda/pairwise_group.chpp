#ifndef LIBND4J_CUDA_PAIRWISE_GROUP_CU
#define LIBND4J_CUDA_PAIRWISE_GROUP_CU

// Group implementation translation units define the same helper template and
// instantiate one distinct operation group. The public dispatcher translation
// units include pairwise.chpp directly and therefore see declarations only.
#define PAIRWISE_DEFINE_GROUP_HELPERS 1
#include <loops/cuda/pairwise.chpp>

#endif  // LIBND4J_CUDA_PAIRWISE_GROUP_CU
