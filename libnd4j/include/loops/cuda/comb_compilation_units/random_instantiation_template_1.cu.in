// MEMORY OPTIMIZATION: Define op group to compile only a subset of operations
#define RANDOM_OP_GROUP @OP_GROUP@

#include <loops/cuda/random.chpp>
#include <system/type_boilerplate.h>
#include <loops/pairwise_instantiations_single.h>

/*
 * Function instantiation for RandomFunction::executeCudaSingle,
 * ::executeCudaDouble and ::executeCudaTriple instantiated for the single
 * type in @COMB1@ (float-family types only — random distributions use float
 * math), mirroring scalar_exec_cuda_shaped.cu.in.
 */

#define LIST_CALLBACK_RANDOM_SINGLE(OUTER_ELEMENT, INNER_ELEMENT, THIRD, FUNC_NAME, ARGS) \
    template void functions::random::RandomFunction<INNER_ELEMENT>::executeCudaSingle( \
        dim3& launchDims, \
        cudaStream_t* stream, \
        int opNum, \
        sd::Pointer stateHost, \
        void* vz, \
        sd::LongType const* zShapeBuffer, \
        void* vextraArguments);

#define LIST_CALLBACK_RANDOM_DOUBLE(OUTER_ELEMENT, INNER_ELEMENT, THIRD, FUNC_NAME, ARGS) \
    template void functions::random::RandomFunction<INNER_ELEMENT>::executeCudaDouble( \
        dim3& launchDims, \
        cudaStream_t* stream, \
        int opNum, \
        sd::Pointer stateHost, \
        void const* vx, \
        sd::LongType const* xShapeBuffer, \
        void* vz, \
        sd::LongType const* zShapeBuffer, \
        void* vextraParams_unused);

#define LIST_CALLBACK_RANDOM_TRIPLE(OUTER_ELEMENT, INNER_ELEMENT, THIRD, FUNC_NAME, ARGS) \
    template void functions::random::RandomFunction<INNER_ELEMENT>::executeCudaTriple( \
        dim3& launchDims, \
        cudaStream_t* stream, \
        int opNum, \
        sd::Pointer stateHost, \
        void const* vx, \
        sd::LongType const* xShapeBuffer, \
        void const* vy, \
        sd::LongType const* yShapeBuffer, \
        void* vz, \
        sd::LongType const* zShapeBuffer, \
        void* vextraArguments);

ITERATE_COMBINATIONS(
    SD_FLOAT_TYPES_PART_@COMB1@,
    SD_FLOAT_TYPES_PART_@COMB1@,
    LIST_CALLBACK_RANDOM_SINGLE,
    functions::random::RandomFunction,
    ::executeCudaSingle(
        dim3& launchDims,
        cudaStream_t* stream,
        int opNum,
        sd::Pointer stateHost,
        void* vz,
        sd::LongType const* zShapeBuffer,
        void* vextraArguments);
);

ITERATE_COMBINATIONS(
    SD_FLOAT_TYPES_PART_@COMB1@,
    SD_FLOAT_TYPES_PART_@COMB1@,
    LIST_CALLBACK_RANDOM_DOUBLE,
    functions::random::RandomFunction,
    ::executeCudaDouble(
        dim3& launchDims,
        cudaStream_t* stream,
        int opNum,
        sd::Pointer stateHost,
        void const* vx,
        sd::LongType const* xShapeBuffer,
        void* vz,
        sd::LongType const* zShapeBuffer,
        void* vextraArguments);
);

ITERATE_COMBINATIONS(
    SD_FLOAT_TYPES_PART_@COMB1@,
    SD_FLOAT_TYPES_PART_@COMB1@,
    LIST_CALLBACK_RANDOM_TRIPLE,
    functions::random::RandomFunction,
    ::executeCudaTriple(
        dim3& launchDims,
        cudaStream_t* stream,
        int opNum,
        sd::Pointer stateHost,
        void const* vx,
        sd::LongType const* xShapeBuffer,
        void const* vy,
        sd::LongType const* yShapeBuffer,
        void* vz,
        sd::LongType const* zShapeBuffer,
        void* vextraArguments);
);
