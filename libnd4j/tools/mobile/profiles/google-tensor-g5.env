# Google Tensor G5 direct NPU build. Paths are supplied by the caller.
SDX_VARIANT=google-tensor-g5
SDX_PROVIDER=litert-lm
SDX_ACCELERATOR=GOOGLE_TENSOR_G5_TPU
SDX_CHIP=arm64
SDX_ANDROID_ABI=arm64-v8a
SDX_ANDROID_API=28

LITERTLM_VERSION=0.14.0
LITERTLM_GIT_TAG=v0.14.0
LITERTLM_GIT_COMMIT=80f301ff9a3b02c2c1e7be2dd1a567752f7b51b6
LITERTLM_REPOSITORY=https://github.com/google-ai-edge/LiteRT-LM.git
LITERTLM_BACKEND=npu
LITERTLM_BAZEL_VERSION=7.6.1
LITERTLM_BAZELISK_VERSION=1.28.1

GOOGLE_TENSOR_SOC=Tensor_G5
SDX_AOT_ONLY=1
SDX_DEVICE_ONLY=1
SDX_ALLOW_HOST_FALLBACK=0
SDX_ALLOW_SLOT_FALLBACK=0
SDX_EXPECT_BLAS=0
SDX_EXPECT_JIT=0
SDX_MODEL_FORMAT=litertlm
SDX_MODEL_QUANTIZATION=int8-per-channel
