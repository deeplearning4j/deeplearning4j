# Google Tensor G3 NNAPI accelerator with ACL/NEON construction-time replay.
SDX_VARIANT=tensor-g3
SDX_PROVIDER=nnapi
SDX_NATIVE_LIBRARY=nd4jnnapi
SDX_ACCELERATOR=NNAPI_ACCELERATOR_ONLY
SDX_CHIP=nnapi
SDX_ANDROID_ABI=arm64-v8a
SDX_ANDROID_API=31
SDX_REQUIRED_ACCELERATOR_DEVICE=google-edgetpu

SDX_AOT_ONLY=0
SDX_DEVICE_ONLY=1
SDX_ALLOW_HOST_FALLBACK=0
SDX_ALLOW_SLOT_FALLBACK=0
SDX_EXPECT_BLAS=0
SDX_EXPECT_JIT=0
