# Android ARM64 Vulkan GPU SDX build profile.
# The runtime is device-only, BLAS-free, and loads only bundle-owned AOT SPIR-V.
SDX_VARIANT=vulkan
SDX_CHIP=vulkan
SDX_NATIVE_LIBRARY=nd4jvulkan
SDX_ACCELERATOR=NONE
SDX_GPU_TARGET=VULKAN
SDX_ANDROID_API=28
SDX_ANDROID_ABI=arm64-v8a
SDX_DEVICE_ONLY=1
SDX_AOT_ONLY=1
SDX_ALLOW_HOST_FALLBACK=0
SDX_EXPECT_BLAS=0
SDX_DATATYPES="${SDX_DATATYPES:-}"
SDX_OPERATIONS="${SDX_OPERATIONS:-}"
