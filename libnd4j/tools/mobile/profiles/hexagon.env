# Qualcomm Hexagon/HTP Android ARM64 SDX build profile.
# Values can be overridden in the environment before invoking the build script.
SDX_VARIANT=hexagon
SDX_CHIP=hexagon
SDX_NATIVE_LIBRARY=nd4jhexagon
SDX_ACCELERATOR=QUALCOMM_HEXAGON_HTP
SDX_GPU_TARGET=AUTO
SDX_ANDROID_API=24
SDX_ANDROID_ABI=arm64-v8a
SDX_DEVICE_ONLY=1
SDX_AOT_ONLY=1
SDX_ALLOW_HOST_FALLBACK=0
SDX_EXPECT_BLAS=0
SDX_ADAPTER_LIBRARY_NAME=libhexagon_mlir_runtime.so
SDX_DATATYPES="${SDX_DATATYPES:-}"
SDX_OPERATIONS="${SDX_OPERATIONS:-}"
HEXAGON_ADAPTER_LIBRARY="${HEXAGON_ADAPTER_LIBRARY:-}"
