# =============================================================================
# Common Valgrind false positives in JVM
# =============================================================================

# JIT-compiled code in anonymous memory regions
{
   suppress_jit_anonymous
   Memcheck:Cond
   ...
   obj:*
   fun:*JavaThread*
}

# JVM internal allocations
{
   suppress_jvm_malloc
   Memcheck:Leak
   match-leak-kinds: possible
   fun:malloc
   ...
   obj:*/libjvm.so
}

{
   suppress_jvm_realloc
   Memcheck:Leak
   match-leak-kinds: possible
   fun:realloc
   ...
   obj:*/libjvm.so
}

{
   suppress_jvm_calloc
   Memcheck:Leak
   match-leak-kinds: possible
   fun:calloc
   ...
   obj:*/libjvm.so
}

# =============================================================================
# END OF SUPPRESSION FILE
# =============================================================================
