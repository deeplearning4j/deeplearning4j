#
# /* ******************************************************************************
#  *
#  * Valgrind Suppression File for libnd4j Testing
#  *
#  * This file suppresses all errors from non-libnd4j libraries, allowing
#  * Valgrind to focus only on memory issues in libnd4j code.
#  *
#  * Usage:
#  *   valgrind --suppressions=valgrind_libnd4j.supp ...
#  *
#  * Or with the java wrapper:
#  *   TEST_RUNNER_PREFIX="valgrind" VALGRIND_LIBND4J_ONLY=1 mvn test
#  *
#  * terms of the apache license, version 2.0 which is available at
#  * https://www.apache.org/licenses/license-2.0.
#  *
#  * spdx-license-identifier: apache-2.0
#  ******************************************************************************/
#

# =============================================================================
# JVM / HotSpot Suppressions
# =============================================================================

# Suppress all errors from libjvm.so (JVM core)
{
   suppress_libjvm_cond
   Memcheck:Cond
   ...
   obj:*/libjvm.so
}
{
   suppress_libjvm_value1
   Memcheck:Value1
   ...
   obj:*/libjvm.so
}
{
   suppress_libjvm_value2
   Memcheck:Value2
   ...
   obj:*/libjvm.so
}
{
   suppress_libjvm_value4
   Memcheck:Value4
   ...
   obj:*/libjvm.so
}
{
   suppress_libjvm_value8
   Memcheck:Value8
   ...
   obj:*/libjvm.so
}
{
   suppress_libjvm_addr1
   Memcheck:Addr1
   ...
   obj:*/libjvm.so
}
{
   suppress_libjvm_addr2
   Memcheck:Addr2
   ...
   obj:*/libjvm.so
}
{
   suppress_libjvm_addr4
   Memcheck:Addr4
   ...
   obj:*/libjvm.so
}
{
   suppress_libjvm_addr8
   Memcheck:Addr8
   ...
   obj:*/libjvm.so
}
{
   suppress_libjvm_jump
   Memcheck:Jump
   ...
   obj:*/libjvm.so
}
{
   suppress_libjvm_leak_definite
   Memcheck:Leak
   match-leak-kinds: definite
   ...
   obj:*/libjvm.so
}
{
   suppress_libjvm_leak_possible
   Memcheck:Leak
   match-leak-kinds: possible
   ...
   obj:*/libjvm.so
}
{
   suppress_libjvm_leak_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   obj:*/libjvm.so
}

# =============================================================================
# JDK Native Libraries Suppressions
# =============================================================================

# libjava.so - Core Java native code
{
   suppress_libjava_all
   Memcheck:Cond
   ...
   obj:*/libjava.so
}
{
   suppress_libjava_leak
   Memcheck:Leak
   ...
   obj:*/libjava.so
}

