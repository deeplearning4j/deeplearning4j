#  * distributed under the license is distributed on an "as is" basis, without
#  * warranties or conditions of any kind, either express or implied. see the
#  * license for the specific language governing permissions and limitations
#  * under the license.
#  *
#  * spdx-license-identifier: apache-2.0
#  ******************************************************************************/
#

set -exo pipefail
echo "TEST RUNNER PREFIX: $test_runner_prefix"
echo "TEST_RUNNER_PREFIX (uppercase): $TEST_RUNNER_PREFIX"
echo "test_runner_prefix (lowercase): $test_runner_prefix"

java_call="java "
script_dir=$( cd -- "$( dirname -- "${bash_source[0]}" )" &> /dev/null && pwd )
echo "RUNNING WITH CUSTOM JVM"
echo "TEST RUNNER PREFIX: $test_runner_prefix"
#source "${script_dir}/env.sh"
# find libjvm.so
if [[ -n $libjvm_so ]]; then
    libjvm_path=$libjvm_so
else
    java_real_path=$(readlink -f $(which java))
    java_home=$(dirname $(dirname $java_real_path))
    libjvm_path=$(find $java_home -type f -name "libjvm.so" | grep "/server/" | head -n 1)
fi

# if libjvm.so not found, terminate
if [[ -z $libjvm_path ]]; then
    echo "libjvm.so not found"
    exit 1
fi

# if test_runner_prefix is not empty and contains "valgrind"
if [[ -n $TEST_RUNNER_PREFIX && $TEST_RUNNER_PREFIX =~ "valgrind" ]]; then
    # path to the comprehensive suppression file (same directory as this script)
    libnd4j_supp_file="${script_dir}/valgrind_libnd4j.supp"

    # create a file to store the dynamic suppression information (for libjvm.so path)
    dynamic_suppression_file="/tmp/valgrind_dynamic_$$.supp"

    # generate dynamic suppression file for the actual libjvm.so path
    echo "generating dynamic valgrind suppression file at $dynamic_suppression_file..."
    for error_type in Addr1 Addr2 Addr4 Addr8 Value1 Value2 Value4 Value8 Jump Cond
    do
        cat << EOF >> $dynamic_suppression_file
{
    suppress_libjvm_dynamic_${error_type}
    Memcheck:${error_type}
    ...
    obj:$libjvm_path
}
EOF
    done

    # add leak suppressions for libjvm.so
    for leak_kind in definite possible reachable indirect
    do
        cat << EOF >> $dynamic_suppression_file
{
    suppress_libjvm_leak_${leak_kind}
    Memcheck:Leak
    match-leak-kinds: ${leak_kind}
    ...
    obj:$libjvm_path
}
EOF
    done

    echo "valgrind dynamic suppression file has been generated."

    # build valgrind options - focus on libnd4j only by default
    valgrind_opts="--error-limit=no --track-origins=yes --keep-stacktraces=alloc-and-free"
    valgrind_opts="${valgrind_opts} --suppressions=${dynamic_suppression_file}"

    # add comprehensive suppression file to focus on libnd4j
    if [[ -f "$libnd4j_supp_file" ]]; then
        echo "Valgrind configured to focus on libnd4j errors only"
        valgrind_opts="${valgrind_opts} --suppressions=${libnd4j_supp_file}"
    else
        echo "WARNING: libnd4j suppression file not found at $libnd4j_supp_file"
    fi

    # check if "--suppressions" already exists in test_runner_prefix (user override)
    if [[ $TEST_RUNNER_PREFIX != *"--suppressions"* ]]; then
        TEST_RUNNER_PREFIX="$TEST_RUNNER_PREFIX ${valgrind_opts}"
    fi

    java_call="${java_call} -Djava.compiler=none"

    # store suppression file path for cleanup
    VALGRIND_DYNAMIC_SUPP="$dynamic_suppression_file"
fi

# if test_runner_prefix is not empty and contains "asan" (AddressSanitizer)
if [[ -n $TEST_RUNNER_PREFIX && $TEST_RUNNER_PREFIX =~ "asan" ]]; then
    echo "Running with AddressSanitizer (ASAN)"
    
    # Find libasan.so
    libasan_path=$(find /usr/lib* /lib* -name "libasan.so.*" 2>/dev/null | head -n 1)
    
    if [[ -z $libasan_path ]]; then
        echo "ERROR: libasan.so not found. Install with: sudo dnf install libasan (Fedora/RHEL) or sudo apt-get install libasan6 (Ubuntu/Debian)"
        exit 1
    fi
    
    echo "Found AddressSanitizer library: $libasan_path"
    
    # Set up ASAN environment
    export LD_PRELOAD="$libasan_path"
    export ASAN_OPTIONS="alloc_dealloc_mismatch=0:detect_leaks=1:new_delete_type_mismatch=0:halt_on_error=0:exitcode=0:report_objects=1:use_stacks=1:use_registers=1:leak_check_at_exit=1:fast_unwind_on_malloc=0:log_path=/tmp/asan.log"
    
    echo "ASAN_OPTIONS: $ASAN_OPTIONS"
    echo "Leak reports will be written to: /tmp/asan.log.<pid>"
    
    # Disable JIT compilation for better stack traces
    java_call="${java_call} -Djava.compiler=none"
    
    # Clear TEST_RUNNER_PREFIX since we're using LD_PRELOAD
    TEST_RUNNER_PREFIX=""
fi

# if test_runner_prefix is not empty and contains "compute-sanitizer"
if [[ -n $TEST_RUNNER_PREFIX && $TEST_RUNNER_PREFIX =~ "compute-sanitizer" ]]; then
    TEST_RUNNER_PREFIX="$TEST_RUNNER_PREFIX  --print-limit=0  --show-backtrace=yes"
    # add jvm option to disable jit compilation to help with debugging
    java_call="${java_call}  -Djava.compiler=none"

    echo "running with cuda compute-sanitizer"
fi

# if test_runner_prefix is not empty and contains "nsys" (NVIDIA Nsight Systems)
if [[ -n $TEST_RUNNER_PREFIX && $TEST_RUNNER_PREFIX =~ "nsys" ]]; then
    echo "Running with NVIDIA Nsight Systems (nsys) profiler"

    # Use nsys from CUDA installation (newer version)
    NSYS_BIN="/usr/local/cuda/bin/nsys"
    if [[ ! -x "$NSYS_BIN" ]]; then
        NSYS_BIN="nsys"  # fallback to PATH
    fi

    # Generate output filename with timestamp
    nsys_output="/tmp/nsys_profile_$(date +%Y%m%d_%H%M%S)"

    # Default nsys options for CUDA profiling
    nsys_opts="profile --stats=true --cuda-memory-usage=true"
    nsys_opts="${nsys_opts} --trace=cuda,nvtx,osrt,cublas,cudnn"
    nsys_opts="${nsys_opts} --cudabacktrace=all"
    nsys_opts="${nsys_opts} --output=${nsys_output}"
    nsys_opts="${nsys_opts} --force-overwrite=true"

    # Check if user provided custom options
    if [[ $TEST_RUNNER_PREFIX == *"nsys profile"* ]]; then
        # User provided full nsys command, use as-is but add output
        if [[ $TEST_RUNNER_PREFIX != *"--output"* ]]; then
            TEST_RUNNER_PREFIX="${TEST_RUNNER_PREFIX} --output=${nsys_output}"
        fi
    else
        # Replace "nsys" with full nsys profile command
        TEST_RUNNER_PREFIX="${NSYS_BIN} ${nsys_opts}"
    fi

    echo "nsys output will be written to: ${nsys_output}.nsys-rep"
    echo "After run, analyze with: nsys stats ${nsys_output}.nsys-rep"
    echo "Or open in Nsight Systems GUI: nsys-ui ${nsys_output}.nsys-rep"

    # Store output path for post-run message
    NSYS_OUTPUT="${nsys_output}"
fi
# Temporarily disable device remapping to debug kernel loading issues
# export CUDA_VISIBLE_DEVICES=1
# print the final command
echo "$TEST_RUNNER_PREFIX $java_call $@"
$TEST_RUNNER_PREFIX $java_call "$@"

# if valgrind was used, remove the dynamic suppression file
if [[ -n $VALGRIND_DYNAMIC_SUPP && -f $VALGRIND_DYNAMIC_SUPP ]]; then
    rm -f "$VALGRIND_DYNAMIC_SUPP"
fi

# if asan was used, print location of reports
if [[ -n $LD_PRELOAD && $LD_PRELOAD =~ "asan" ]]; then
    echo ""
    echo "====================================================="
    echo "ASAN leak reports (if any) written to: /tmp/asan.log.*"
    echo "Use: cat /tmp/asan.log.* to view reports"
    echo "====================================================="
fi

# if nsys was used, print analysis instructions
if [[ -n $NSYS_OUTPUT ]]; then
    echo ""
    echo "====================================================="
    echo "NVIDIA Nsight Systems profile written to: ${NSYS_OUTPUT}.nsys-rep"
    echo ""
    echo "Quick stats:  nsys stats ${NSYS_OUTPUT}.nsys-rep"
    echo "CUDA summary: nsys stats --report cuda_gpu_kern_sum ${NSYS_OUTPUT}.nsys-rep"
    echo "Memory ops:   nsys stats --report cuda_mem_time_sum ${NSYS_OUTPUT}.nsys-rep"
    echo "API calls:    nsys stats --report cuda_api_sum ${NSYS_OUTPUT}.nsys-rep"
    echo "GUI:          nsys-ui ${NSYS_OUTPUT}.nsys-rep"
    echo "====================================================="
fi
