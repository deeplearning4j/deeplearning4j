    @Test
    fun testReshapeExport() {
        val sd = SameDiff.create()
        val x = sd.placeHolder("x", DataType.FLOAT, 2, 6)

        val reshaped = sd.reshape("reshaped", x, 3, 4)

        val onnxFile = tempDir.resolve("reshape.onnx").toFile()
        sd.exportToOnnx(onnxFile)

        assertTrue(onnxFile.exists())
    }

    @Test
    fun testConcatExport() {
        val sd = SameDiff.create()
        val x = sd.placeHolder("x", DataType.FLOAT, 2, 3)
        val y = sd.placeHolder("y", DataType.FLOAT, 2, 3)

        val concat = sd.concat("concat", 1, x, y)

