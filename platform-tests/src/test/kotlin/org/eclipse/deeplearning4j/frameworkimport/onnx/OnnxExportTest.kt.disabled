    // ========================================
    // Constants and Variables Tests
    // ========================================

    @Test
    fun testExportWithConstants() {
        val sd = SameDiff.create()

        val x = sd.placeHolder("x", DataType.FLOAT, 2, 3)
        val weights = sd.constant("weights", Nd4j.randn(3, 4).castTo(DataType.FLOAT))
        val bias = sd.constant("bias", Nd4j.zeros(4).castTo(DataType.FLOAT))

        val mm = sd.mmul(x, weights)
        val result = mm.add(bias)
        result.rename("output")

        val onnxFile = tempDir.resolve("with_constants.onnx").toFile()
        sd.exportToOnnx(onnxFile)

        val modelProto = parseOnnxModel(onnxFile)

        // Should have initializers for weights and bias
        assertTrue(modelProto.graph.initializerCount >= 2, "Should have initializers for constants")

        // Verify initializer names
        val initializerNames = modelProto.graph.initializerList.map { it.name }.toSet()
        assertTrue(initializerNames.contains("weights"), "Should have weights initializer")
        assertTrue(initializerNames.contains("bias"), "Should have bias initializer")
    }

    @Test
    fun testExportWithVariables() {
        val sd = SameDiff.create()

        val x = sd.placeHolder("x", DataType.FLOAT, -1, 10)
        val w = sd.variable("w", Nd4j.randn(10, 5).castTo(DataType.FLOAT))
        val b = sd.variable("b", Nd4j.zeros(5).castTo(DataType.FLOAT))

        val result = sd.mmul(x, w).add(b)
        result.rename("output")

        val onnxFile = tempDir.resolve("with_variables.onnx").toFile()
        sd.exportToOnnx(onnxFile)

        val modelProto = parseOnnxModel(onnxFile)
        assertTrue(modelProto.graph.initializerCount >= 2, "Should have initializers for variables")
    }

    // ========================================
    // Neural Network Architecture Tests
    // ========================================

    @Test
    fun testExportMLP() {
        val sd = SameDiff.create()

        // Simple MLP: input -> dense -> relu -> dense -> softmax
        val input = sd.placeHolder("input", DataType.FLOAT, -1, 10)
        val w1 = sd.variable("w1", Nd4j.randn(10, 20).castTo(DataType.FLOAT))
        val b1 = sd.variable("b1", Nd4j.zeros(20).castTo(DataType.FLOAT))
        val w2 = sd.variable("w2", Nd4j.randn(20, 5).castTo(DataType.FLOAT))
        val b2 = sd.variable("b2", Nd4j.zeros(5).castTo(DataType.FLOAT))

        var x = sd.mmul(input, w1).add(b1)
        x = sd.math.relu(x)
        x = sd.mmul(x, w2).add(b2)
        val output = sd.nn.softmax("output", x)

        val onnxFile = tempDir.resolve("mlp.onnx").toFile()
        sd.exportToOnnx(onnxFile)

        assertTrue(onnxFile.exists())

        val modelProto = parseOnnxModel(onnxFile)
        assertNotNull(modelProto.graph)
        assertTrue(modelProto.graph.nodeCount >= 5, "MLP should have multiple nodes")

        // Verify it has expected ops
        val opTypes = modelProto.graph.nodeList.map { it.opType }.toSet()
        assertTrue(opTypes.contains("MatMul"), "Should have MatMul op")
        assertTrue(opTypes.contains("Add"), "Should have Add op")
        assertTrue(opTypes.contains("Relu"), "Should have Relu op")
        assertTrue(opTypes.contains("Softmax"), "Should have Softmax op")
    }

    @Test
    fun testExportDeepNetwork() {
        val sd = SameDiff.create()

        val input = sd.placeHolder("input", DataType.FLOAT, -1, 784)

        var x = input
        val layerSizes = listOf(784, 512, 256, 128, 10)

        for (i in 0 until layerSizes.size - 1) {
            val inSize = layerSizes[i]
            val outSize = layerSizes[i + 1]

            val w = sd.variable("w$i", Nd4j.randn(inSize.toLong(), outSize.toLong()).mul(0.01).castTo(DataType.FLOAT))
            val b = sd.variable("b$i", Nd4j.zeros(outSize.toLong()).castTo(DataType.FLOAT))

            x = sd.mmul(x, w).add(b)

            if (i < layerSizes.size - 2) {
                x = sd.math.relu(x)
            }
        }

        val output = sd.nn.softmax("output", x)

        val onnxFile = tempDir.resolve("deep_network.onnx").toFile()
        sd.exportToOnnx(onnxFile)

        val modelProto = parseOnnxModel(onnxFile)
        assertTrue(modelProto.graph.initializerCount >= 8, "Should have weights and biases for all layers")
    }

    // ========================================
    // Validation Tests
    // ========================================

    @Test
    fun testCanExportToOnnx() {
        val sd = SameDiff.create()

        val x = sd.placeHolder("x", DataType.FLOAT, 2, 3)
        val y = sd.placeHolder("y", DataType.FLOAT, 2, 3)
        val sum = x.add(y)
        val result = sd.math.relu(sum)
        result.rename("output")

        assertTrue(sd.canExportToOnnx(), "Simple graph should be exportable")
    }

    @Test
    fun testGetUnsupportedOps() {
        val sd = SameDiff.create()
        val x = sd.placeHolder("x", DataType.FLOAT, 2, 3)
        val result = sd.math.relu(x)
        result.rename("output")

        val unsupported = sd.getUnsupportedOnnxOps()
        assertTrue(unsupported.isEmpty(), "Should have no unsupported ops for simple relu graph")
    }

    @Test
    fun testValidateForExport() {
        val sd = SameDiff.create()
        val x = sd.placeHolder("x", DataType.FLOAT, 2, 3)
        val y = sd.constant("y", Nd4j.ones(2, 3))
        val result = x.add(y)
        result.rename("output")

        val unsupported = OnnxExporter.validateForExport(sd)
        assertTrue(unsupported.isEmpty(), "Add op should be supported")
    }

    // ========================================
    // Op Mapper Tests
    // ========================================

    @Test
    fun testOpMapperMappings() {
        // Verify basic mappings exist
        assertEquals("Add", SameDiffToOnnxOpMapper.getOnnxOpName("add"))
        assertEquals("Sub", SameDiffToOnnxOpMapper.getOnnxOpName("subtract"))
        assertEquals("Mul", SameDiffToOnnxOpMapper.getOnnxOpName("multiply"))
        assertEquals("Div", SameDiffToOnnxOpMapper.getOnnxOpName("divide"))
        assertEquals("Relu", SameDiffToOnnxOpMapper.getOnnxOpName("relu"))
        assertEquals("Sigmoid", SameDiffToOnnxOpMapper.getOnnxOpName("sigmoid"))
        assertEquals("Tanh", SameDiffToOnnxOpMapper.getOnnxOpName("tanh"))
        assertEquals("Softmax", SameDiffToOnnxOpMapper.getOnnxOpName("softmax"))
        assertEquals("MatMul", SameDiffToOnnxOpMapper.getOnnxOpName("matmul"))
        assertEquals("Reshape", SameDiffToOnnxOpMapper.getOnnxOpName("reshape"))
    }

    @Test
    fun testOpMapperTrigFunctions() {
        assertEquals("Sin", SameDiffToOnnxOpMapper.getOnnxOpName("sin"))
        assertEquals("Cos", SameDiffToOnnxOpMapper.getOnnxOpName("cos"))
        assertEquals("Tan", SameDiffToOnnxOpMapper.getOnnxOpName("tan"))
        assertEquals("Asin", SameDiffToOnnxOpMapper.getOnnxOpName("asin"))
        assertEquals("Acos", SameDiffToOnnxOpMapper.getOnnxOpName("acos"))
        assertEquals("Atan", SameDiffToOnnxOpMapper.getOnnxOpName("atan"))
        assertEquals("Sinh", SameDiffToOnnxOpMapper.getOnnxOpName("sinh"))
        assertEquals("Cosh", SameDiffToOnnxOpMapper.getOnnxOpName("cosh"))
    }

    @Test
    fun testOpMapperReductions() {
        assertEquals("ReduceSum", SameDiffToOnnxOpMapper.getOnnxOpName("reduce_sum"))
        assertEquals("ReduceMean", SameDiffToOnnxOpMapper.getOnnxOpName("reduce_mean"))
        assertEquals("ReduceMax", SameDiffToOnnxOpMapper.getOnnxOpName("reduce_max"))
        assertEquals("ReduceMin", SameDiffToOnnxOpMapper.getOnnxOpName("reduce_min"))
        assertEquals("ReduceProd", SameDiffToOnnxOpMapper.getOnnxOpName("reduce_prod"))
    }

    @Test
    fun testSupportedOps() {
        val supportedOps = SameDiffToOnnxOpMapper.getSupportedOps()

        assertTrue(supportedOps.contains("add"), "add should be supported")
        assertTrue(supportedOps.contains("relu"), "relu should be supported")
        assertTrue(supportedOps.contains("softmax"), "softmax should be supported")
        assertTrue(supportedOps.contains("reshape"), "reshape should be supported")
        assertTrue(supportedOps.contains("concat"), "concat should be supported")
        assertTrue(supportedOps.contains("reduce_sum"), "reduce_sum should be supported")
    }

    @Test
    fun testIsSupported() {
        assertTrue(SameDiffToOnnxOpMapper.isSupported("add"))
        assertTrue(SameDiffToOnnxOpMapper.isSupported("relu"))
        assertTrue(SameDiffToOnnxOpMapper.isSupported("matmul"))
        assertFalse(SameDiffToOnnxOpMapper.isSupported("nonexistent_op"))
    }

    // ========================================
    // Round Trip Tests
    // ========================================

    @Test
    fun testRoundTripSimpleAdd() {
        val sd = SameDiff.create()
        val x = sd.placeHolder("x", DataType.FLOAT, 2, 3)
        val y = sd.constant("y", Nd4j.ones(2, 3).castTo(DataType.FLOAT))
        val result = x.add(y)
        result.rename("output")

        val onnxFile = tempDir.resolve("roundtrip_add.onnx").toFile()
        sd.exportToOnnx(onnxFile)

        // Import the exported model
        val importer = OnnxFrameworkImporter()
        val importedSd = importer.runImport(onnxFile.absolutePath, emptyMap())

        assertNotNull(importedSd, "Imported SameDiff should not be null")
        assertTrue(importedSd.variables.isNotEmpty(), "Should have variables")
        assertTrue(importedSd.ops.isNotEmpty(), "Should have ops")
    }

    @Test
    fun testRoundTripWithMultipleOps() {
        val sd = SameDiff.create()

        val x = sd.placeHolder("x", DataType.FLOAT, -1, 4)
        val w = sd.variable("w", Nd4j.randn(4, 3).castTo(DataType.FLOAT))
        val b = sd.variable("b", Nd4j.zeros(3).castTo(DataType.FLOAT))

        var result = sd.mmul(x, w)
        result = result.add(b)
        result = sd.math.relu(result)
        result.rename("output")

        val onnxFile = tempDir.resolve("roundtrip_multi.onnx").toFile()
        sd.exportToOnnx(onnxFile)

        val importer = OnnxFrameworkImporter()
        val importedSd = importer.runImport(onnxFile.absolutePath, emptyMap())

        assertNotNull(importedSd)
        assertTrue(importedSd.ops.isNotEmpty())
    }

    // ========================================
    // Training State Tests
    // ========================================

    @Test
    fun testTrainingStateExport() {
        val sd = SameDiff.create()

        val x = sd.placeHolder("x", DataType.FLOAT, -1, 4)
        val labels = sd.placeHolder("labels", DataType.FLOAT, -1, 2)
        val w = sd.variable("w", Nd4j.randn(4, 2).castTo(DataType.FLOAT))

        val pred = sd.mmul(x, w)
        val loss = sd.loss.meanSquaredError("loss", labels, pred, null)

        val config = TrainingConfig.builder()
            .updater(Adam(0.001))
            .dataSetFeatureMapping("x")
            .dataSetLabelMapping("labels")
            .build()

        sd.trainingConfig = config

        val trainingFile = tempDir.resolve("training_state.training").toFile()
        TrainingStateExporter.export(sd, trainingFile)

        assertTrue(trainingFile.exists(), "Training state file should be created")
        assertTrue(trainingFile.length() > 0, "Training state file should have content")
    }

    @Test
    fun testExportWithTrainingState() {
        val sd = SameDiff.create()

        val x = sd.placeHolder("x", DataType.FLOAT, -1, 4)
        val labels = sd.placeHolder("labels", DataType.FLOAT, -1, 2)
        val w = sd.variable("w", Nd4j.randn(4, 2).castTo(DataType.FLOAT))

        val pred = sd.mmul(x, w)
        sd.loss.meanSquaredError("loss", labels, pred, null)

        val config = TrainingConfig.builder()
            .updater(Sgd(0.01))
            .dataSetFeatureMapping("x")
            .dataSetLabelMapping("labels")
            .build()

        sd.trainingConfig = config

        val onnxFile = tempDir.resolve("model_with_training.onnx").toFile()
        sd.exportToOnnxWithTraining(onnxFile)

        assertTrue(onnxFile.exists(), "ONNX file should exist")

        val trainingFile = File(onnxFile.absolutePath + ".training")
        assertTrue(trainingFile.exists(), "Training state file should exist")
    }

    // ========================================
    // Data Type Tests
    // ========================================

    @ParameterizedTest
    @ValueSource(strings = ["FLOAT", "DOUBLE"])
    fun testExportWithDifferentDataTypes(dataTypeStr: String) {
        val dataType = DataType.valueOf(dataTypeStr)

        val sd = SameDiff.create()
        val x = sd.placeHolder("x", dataType, 2, 3)
        val y = sd.constant("y", Nd4j.ones(dataType, 2, 3))
        val result = x.add(y)
        result.rename("output")

        val onnxFile = tempDir.resolve("datatype_${dataTypeStr.lowercase()}.onnx").toFile()
        sd.exportToOnnx(onnxFile)

        val modelProto = parseOnnxModel(onnxFile)
        assertNotNull(modelProto.graph)
    }

    // ========================================
    // Edge Cases Tests
    // ========================================

    @Test
    fun testExportEmptyGraph() {
        val sd = SameDiff.create()
        val x = sd.placeHolder("x", DataType.FLOAT, 2, 3)
        x.rename("output")  // Just a passthrough

        val onnxFile = tempDir.resolve("empty_graph.onnx").toFile()
        sd.exportToOnnx(onnxFile)

        assertTrue(onnxFile.exists())
    }

    @Test
    fun testExportWithLongVariableNames() {
        val sd = SameDiff.create()

        val longName = "a".repeat(100)
        val x = sd.placeHolder(longName, DataType.FLOAT, 2, 3)
        val result = sd.math.relu(x)
        result.rename("output_with_very_long_name_that_should_still_work")

        val onnxFile = tempDir.resolve("long_names.onnx").toFile()
        sd.exportToOnnx(onnxFile)

        val modelProto = parseOnnxModel(onnxFile)
        assertNotNull(modelProto.graph)
    }

    @Test
    fun testExportScalarOperations() {
        val sd = SameDiff.create()

        val x = sd.placeHolder("x", DataType.FLOAT, 2, 3)
        val scaled = x.mul(2.0)
        val shifted = scaled.add(1.0)
        shifted.rename("output")

        val onnxFile = tempDir.resolve("scalar_ops.onnx").toFile()
        sd.exportToOnnx(onnxFile)

        assertTrue(onnxFile.exists())
    }

    // ========================================
    // Helper Methods
    // ========================================

    private fun parseOnnxModel(file: File): Onnx.ModelProto {
        return file.inputStream().use { Onnx.ModelProto.parseFrom(it) }
    }
}
