    @Test
    fun testTransposeExport() {
        val sd = SameDiff.create()
        val x = sd.placeHolder("x", DataType.FLOAT, 2, 3, 4)

        val transposed = sd.permute("transposed", x, 0, 2, 1)

        val onnxFile = tempDir.resolve("transpose.onnx").toFile()
        sd.exportToOnnx(onnxFile)

