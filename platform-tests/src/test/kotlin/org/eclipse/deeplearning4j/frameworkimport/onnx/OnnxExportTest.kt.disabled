package org.eclipse.deeplearning4j.frameworkimport.onnx

import onnx.Onnx
import org.junit.jupiter.api.Assertions.*
import org.junit.jupiter.api.Test
import org.junit.jupiter.api.io.TempDir
import org.junit.jupiter.params.ParameterizedTest
import org.junit.jupiter.params.provider.ValueSource
import org.nd4j.autodiff.samediff.SameDiff
import org.nd4j.autodiff.samediff.TrainingConfig
import org.nd4j.linalg.api.buffer.DataType
import org.nd4j.linalg.factory.Nd4j
import org.nd4j.linalg.learning.config.Adam
import org.nd4j.linalg.learning.config.Sgd
import org.nd4j.samediff.frameworkimport.onnx.export.OnnxExportConfig
import org.nd4j.samediff.frameworkimport.onnx.export.OnnxExporter
import org.nd4j.samediff.frameworkimport.onnx.export.SameDiffToOnnxOpMapper
import org.nd4j.samediff.frameworkimport.onnx.export.TrainingStateExporter
import org.nd4j.samediff.frameworkimport.onnx.importer.OnnxFrameworkImporter
import java.io.ByteArrayOutputStream
import java.io.File
import java.nio.file.Path

/**
 * Comprehensive tests for ONNX export functionality.
 *
 * @author Adam Gibson
 */
class OnnxExportTest {

    @TempDir
    lateinit var tempDir: Path

    // ========================================
    // Basic Export Tests
    // ========================================

    @Test
    fun testSimpleAddExport() {
        val sd = SameDiff.create()

        val x = sd.placeHolder("x", DataType.FLOAT, -1, 3)
        val y = sd.placeHolder("y", DataType.FLOAT, -1, 3)
        val sum = x.add(y)
        sum.rename("output")

        val onnxFile = tempDir.resolve("simple_add.onnx").toFile()
        sd.exportToOnnx(onnxFile)

        assertTrue(onnxFile.exists(), "ONNX file should be created")
        assertTrue(onnxFile.length() > 0, "ONNX file should have content")

        val modelProto = parseOnnxModel(onnxFile)
        assertNotNull(modelProto.graph)
        assertEquals(2, modelProto.graph.inputCount, "Should have 2 inputs")
        assertTrue(modelProto.graph.nodeCount >= 1, "Should have at least 1 node")
    }

    @Test
    fun testExportToStream() {
        val sd = SameDiff.create()
        val x = sd.placeHolder("x", DataType.FLOAT, 2, 3)
        val result = sd.math.abs(x)
        result.rename("output")

        val baos = ByteArrayOutputStream()
        sd.exportToOnnx(baos)

        val bytes = baos.toByteArray()
        assertTrue(bytes.isNotEmpty(), "Should have output bytes")

        val modelProto = Onnx.ModelProto.parseFrom(bytes)
        assertNotNull(modelProto.graph)
    }

    @Test
    fun testToOnnxBytes() {
        val sd = SameDiff.create()
        val x = sd.placeHolder("x", DataType.FLOAT, 2, 2)
        val y = sd.constant("y", Nd4j.ones(2, 2))
        val result = x.mul(y)
        result.rename("output")

        val bytes = sd.toOnnxBytes()
        assertNotNull(bytes)
        assertTrue(bytes.isNotEmpty(), "Should have bytes")

        val modelProto = Onnx.ModelProto.parseFrom(bytes)
        assertNotNull(modelProto.graph)
    }

    // ========================================
    // Configuration Tests
    // ========================================

    @Test
    fun testExportWithConfig() {
        val sd = SameDiff.create()
        val x = sd.placeHolder("x", DataType.FLOAT, 2, 3)
        val result = sd.math.relu(x)
        result.rename("output")

        val config = OnnxExportConfig.builder()
            .opsetVersion(13)
            .producerName("test-producer")
            .producerVersion("1.0.0")
            .graphName("test-graph")
            .docString("Test model documentation")
            .build()

        val onnxFile = tempDir.resolve("relu_with_config.onnx").toFile()
        sd.exportToOnnx(onnxFile, config)

        val modelProto = parseOnnxModel(onnxFile)
        assertEquals("test-producer", modelProto.producerName)
        assertEquals("1.0.0", modelProto.producerVersion)
        assertEquals("test-graph", modelProto.graph.name)
        assertEquals("Test model documentation", modelProto.docString)
    }

    @Test
    fun testDefaultConfig() {
        val config = OnnxExportConfig.DEFAULT
        assertEquals(13L, config.opsetVersion)
        assertEquals(7L, config.irVersion)
        assertEquals("nd4j-samediff", config.producerName)
        assertFalse(config.includeTrainingState)
        assertEquals("main", config.graphName)
    }

    @Test
    fun testCompatibleConfig() {
        val config = OnnxExportConfig.COMPATIBLE
        assertEquals(9L, config.opsetVersion)
        assertEquals(4L, config.irVersion)
    }

    @Test
    fun testWithTrainingConfig() {
        val config = OnnxExportConfig.WITH_TRAINING
        assertTrue(config.includeTrainingState)
    }

    @Test
    fun testConfigBuilder() {
        val config = OnnxExportConfig.builder()
            .opsetVersion(12)
            .irVersion(6)
            .producerName("custom-producer")
            .producerVersion("2.0.0")
            .domain("com.example")
            .modelVersion(2)
            .graphName("custom-graph")
            .includeTrainingState(true)
            .build()

        assertEquals(12L, config.opsetVersion)
        assertEquals(6L, config.irVersion)
        assertEquals("custom-producer", config.producerName)
        assertEquals("2.0.0", config.producerVersion)
        assertEquals("com.example", config.domain)
        assertEquals(2L, config.modelVersion)
        assertEquals("custom-graph", config.graphName)
        assertTrue(config.includeTrainingState)
    }

    // ========================================
    // Arithmetic Operations Tests
    // ========================================

    @Test
    fun testArithmeticOpsExport() {
        val sd = SameDiff.create()
        val x = sd.placeHolder("x", DataType.FLOAT, 2, 3)
        val y = sd.placeHolder("y", DataType.FLOAT, 2, 3)

        val add = x.add(y)
        val sub = x.sub(y)
        val mul = x.mul(y)
        val div = x.div(y)

        add.rename("add_out")
        sub.rename("sub_out")
        mul.rename("mul_out")
        div.rename("div_out")

        val onnxFile = tempDir.resolve("arithmetic.onnx").toFile()
        sd.exportToOnnx(onnxFile)

        val modelProto = parseOnnxModel(onnxFile)
        assertTrue(modelProto.graph.nodeCount >= 4, "Should have arithmetic nodes")

        // Verify operation types
        val opTypes = modelProto.graph.nodeList.map { it.opType }.toSet()
        assertTrue(opTypes.contains("Add"), "Should have Add op")
        assertTrue(opTypes.contains("Sub"), "Should have Sub op")
        assertTrue(opTypes.contains("Mul"), "Should have Mul op")
        assertTrue(opTypes.contains("Div"), "Should have Div op")
    }

    @Test
    fun testMathFunctionsExport() {
        val sd = SameDiff.create()
        val x = sd.placeHolder("x", DataType.FLOAT, 2, 3)

        val abs = sd.math.abs("abs", x)
        val sqrt = sd.math.sqrt("sqrt", sd.math.abs(x))  // abs to ensure positive
        val exp = sd.math.exp("exp", x)
        val log = sd.math.log("log", sd.math.abs(x).add(1.0))  // log(|x|+1) to avoid log(0)
        val neg = sd.math.neg("neg", x)
        val floor = sd.math.floor("floor", x)
        val ceil = sd.math.ceil("ceil", x)

        val onnxFile = tempDir.resolve("math_funcs.onnx").toFile()
        sd.exportToOnnx(onnxFile)

        val modelProto = parseOnnxModel(onnxFile)
        assertTrue(modelProto.graph.nodeCount >= 5, "Should have math function nodes")
    }

    // ========================================
    // Activation Functions Tests
    // ========================================

    @Test
    fun testActivationFunctionsExport() {
        val sd = SameDiff.create()
        val x = sd.placeHolder("x", DataType.FLOAT, 2, 3)

        val relu = sd.math.relu("relu", x)
        val sigmoid = sd.nn.sigmoid("sigmoid", x)
        val tanh = sd.math.tanh("tanh", x)
        val softplus = sd.math.softplus("softplus", x)
        val softsign = sd.math.softsign("softsign", x)

        val onnxFile = tempDir.resolve("activations.onnx").toFile()
        sd.exportToOnnx(onnxFile)

        val modelProto = parseOnnxModel(onnxFile)
        assertTrue(modelProto.graph.nodeCount >= 5, "Should have activation nodes")

        val opTypes = modelProto.graph.nodeList.map { it.opType }.toSet()
        assertTrue(opTypes.contains("Relu"), "Should have Relu op")
        assertTrue(opTypes.contains("Sigmoid"), "Should have Sigmoid op")
        assertTrue(opTypes.contains("Tanh"), "Should have Tanh op")
    }

    @Test
    fun testLeakyReluExport() {
        val sd = SameDiff.create()
        val x = sd.placeHolder("x", DataType.FLOAT, 2, 3)

        val leakyRelu = sd.nn.leakyRelu("leaky_relu", x, 0.1)

        val onnxFile = tempDir.resolve("leaky_relu.onnx").toFile()
        sd.exportToOnnx(onnxFile)

        val modelProto = parseOnnxModel(onnxFile)
        val leakyReluNode = modelProto.graph.nodeList.find { it.opType == "LeakyRelu" }
        assertNotNull(leakyReluNode, "Should have LeakyRelu node")

        // Verify alpha attribute
        val alphaAttr = leakyReluNode?.attributeList?.find { it.name == "alpha" }
        if (alphaAttr != null) {
            assertEquals(0.1f, alphaAttr.f, 0.001f, "Alpha should be 0.1")
        }
    }

    @Test
    fun testSoftmaxExport() {
        val sd = SameDiff.create()
        val x = sd.placeHolder("x", DataType.FLOAT, 2, 5)

        val softmax = sd.nn.softmax("softmax", x, 1)

        val onnxFile = tempDir.resolve("softmax.onnx").toFile()
        sd.exportToOnnx(onnxFile)

        val modelProto = parseOnnxModel(onnxFile)
        val softmaxNode = modelProto.graph.nodeList.find { it.opType == "Softmax" }
        assertNotNull(softmaxNode, "Should have Softmax node")
    }

