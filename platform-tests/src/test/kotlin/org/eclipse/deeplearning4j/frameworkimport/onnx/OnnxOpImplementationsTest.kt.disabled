package org.eclipse.deeplearning4j.frameworkimport.onnx

import org.junit.jupiter.api.Assertions.*
import org.junit.jupiter.api.Tag
import org.junit.jupiter.api.Test
import org.nd4j.autodiff.samediff.SameDiff
import org.nd4j.common.tests.tags.TagNames
import org.nd4j.linalg.api.buffer.DataType
import org.nd4j.linalg.factory.Nd4j
import kotlin.math.sqrt

/**
 * Tests for ONNX operator implementations (PreImportHook).
 * These tests verify the correctness of individual operator implementations
 * by directly testing the SameDiff operations they produce.
 *
 * @author Eclipse Deeplearning4j Development Team
 */
@Tag(TagNames.SAMEDIFF)
class OnnxOpImplementationsTest {

    // ==================== Activation Functions ====================

    @Test
    fun testGelu() {
        val sd = SameDiff.create()
        val input = sd.placeHolder("input", DataType.FLOAT, -1, 4)

        // GELU: 0.5 * x * (1 + erf(x / sqrt(2)))
        val sqrtTwo = 1.4142135623730951
        val erfArg = sd.math.div(input, sqrtTwo)
        val erfVal = sd.math.erf(erfArg)
        val onePlusErf = sd.math.add(erfVal, 1.0)
        val output = sd.math.mul("gelu", sd.math.mul(input, 0.5), onePlusErf)

        val inputArr = Nd4j.create(floatArrayOf(-1f, 0f, 1f, 2f)).reshape(1, 4)
        val result = sd.output(mapOf("input" to inputArr), "gelu")["gelu"]!!

        // Verify GELU properties
        assertTrue(result.getFloat(0, 1) < 0.01) // GELU(0) ≈ 0
        assertTrue(result.getFloat(0, 2) > 0.8) // GELU(1) ≈ 0.841
        assertTrue(result.getFloat(0, 3) > 1.9) // GELU(2) ≈ 1.954
    }

    @Test
    fun testGeluApproximate() {
        val sd = SameDiff.create()
        val input = sd.placeHolder("input", DataType.FLOAT, -1, 4)

        // Approximate GELU using tanh
        val sqrt2OverPi = 0.7978845608028654
        val coef = 0.044715

        val xCubed = sd.math.pow(input, 3.0)
        val inner = sd.math.add(input, sd.math.mul(xCubed, coef))
        val tanhArg = sd.math.mul(inner, sqrt2OverPi)
        val tanhVal = sd.math.tanh(tanhArg)
        val onePlusTanh = sd.math.add(tanhVal, 1.0)
        val output = sd.math.mul("gelu_approx", sd.math.mul(input, 0.5), onePlusTanh)

        val inputArr = Nd4j.create(floatArrayOf(-1f, 0f, 1f, 2f)).reshape(1, 4)
        val result = sd.output(mapOf("input" to inputArr), "gelu_approx")["gelu_approx"]!!

        // Should be close to exact GELU
        assertTrue(result.getFloat(0, 1) < 0.01)
        assertTrue(result.getFloat(0, 2) > 0.8)
    }

    @Test
    fun testHardSwish() {
        val sd = SameDiff.create()
        val input = sd.placeHolder("input", DataType.FLOAT, -1, 5)

        // HardSwish: x * clip((x + 3) / 6, 0, 1)
        val xPlus3 = sd.math.add(input, 3.0)
        val divided = sd.math.div(xPlus3, 6.0)
        val clipped = sd.math.clipByValue("clip", divided, 0.0, 1.0)
        val output = sd.math.mul("hardswish", input, clipped)

        val inputArr = Nd4j.create(floatArrayOf(-4f, -3f, 0f, 3f, 4f)).reshape(1, 5)
        val result = sd.output(mapOf("input" to inputArr), "hardswish")["hardswish"]!!

        // HardSwish(-4) = -4 * 0 = 0
        assertEquals(0f, result.getFloat(0, 0), 0.01f)
        // HardSwish(-3) = -3 * 0 = 0
        assertEquals(0f, result.getFloat(0, 1), 0.01f)
        // HardSwish(0) = 0 * 0.5 = 0
        assertEquals(0f, result.getFloat(0, 2), 0.01f)
        // HardSwish(3) = 3 * 1 = 3
        assertEquals(3f, result.getFloat(0, 3), 0.01f)
        // HardSwish(4) = 4 * 1 = 4
        assertEquals(4f, result.getFloat(0, 4), 0.01f)
    }

    @Test
    fun testMish() {
        val sd = SameDiff.create()
        val input = sd.placeHolder("input", DataType.FLOAT, -1, 4)

        // Mish: x * tanh(softplus(x))
        val softplus = sd.nn.softplus("softplus", input)
        val tanhSoftplus = sd.math.tanh("tanh", softplus)
        val output = sd.math.mul("mish", input, tanhSoftplus)

        val inputArr = Nd4j.create(floatArrayOf(-2f, 0f, 1f, 2f)).reshape(1, 4)
        val result = sd.output(mapOf("input" to inputArr), "mish")["mish"]!!

        // Mish(0) = 0
        assertEquals(0f, result.getFloat(0, 1), 0.01f)
        // Mish(1) ≈ 0.865
        assertTrue(result.getFloat(0, 2) > 0.8 && result.getFloat(0, 2) < 0.9)
    }

    // ==================== Pooling Operations ====================

    @Test
    fun testGlobalLpPool() {
        val sd = SameDiff.create()
        val input = sd.placeHolder("input", DataType.FLOAT, 1, 2, 3, 3)

        // Global Lp Pool with p=2 (L2 norm across spatial dimensions)
        val p = 2
        val powered = sd.math.pow(sd.math.abs(input), p.toDouble())
        val summed = sd.math.sum("sum", powered, false, 2, 3)
        val output = sd.math.pow("global_lp", summed, 1.0 / p)

        val inputArr = Nd4j.ones(DataType.FLOAT, 1, 2, 3, 3)
        val result = sd.output(mapOf("input" to inputArr), "global_lp")["global_lp"]!!

        // L2 norm of 9 ones = sqrt(9) = 3
        assertEquals(2, result.rank())
        assertEquals(3f, result.getFloat(0, 0), 0.01f)
    }

    @Test
    fun testLpPool() {
        val sd = SameDiff.create()
        val input = sd.placeHolder("input", DataType.FLOAT, 1, 1, 4, 4)

        // Lp Pool with p=2, kernel 2x2, stride 2
        val p = 2
        val powered = sd.math.pow(sd.math.abs(input), p.toDouble())
        // For simplicity, test with sum reduction
        val pooled = sd.nn.avgPooling2d("pool", powered, 2, 2, 2, 2, 0, 0, true, false)
        val scaled = sd.math.mul(pooled, 4.0) // Multiply by kernel size since avg divides
        val output = sd.math.pow("lp_pool", scaled, 1.0 / p)

        val inputArr = Nd4j.ones(DataType.FLOAT, 1, 1, 4, 4)
        val result = sd.output(mapOf("input" to inputArr), "lp_pool")["lp_pool"]!!

        // L2 norm of 4 ones in each 2x2 window = sqrt(4) = 2
        assertEquals(4, result.rank())
    }

    // ==================== Loss Functions ====================

    @Test
    fun testNegativeLogLikelihoodLoss() {
        val sd = SameDiff.create()
        val input = sd.placeHolder("input", DataType.FLOAT, -1, 3)  // logits [batch, classes]
        val target = sd.placeHolder("target", DataType.INT64, -1)   // class indices [batch]

        // NLL Loss: -log(softmax(input)[target])
        val logSoftmax = sd.nn.logSoftmax("log_softmax", input, 1)
        val oneHot = sd.oneHot("onehot", target, 3)
        val masked = sd.math.mul(logSoftmax, oneHot)
        val summed = sd.math.sum("sum", masked, false, 1)
        val output = sd.math.neg("nll_loss", sd.math.mean(summed))

        val inputArr = Nd4j.create(floatArrayOf(1f, 2f, 3f, 1f, 2f, 3f)).reshape(2, 3)
        val targetArr = Nd4j.createFromArray(longArrayOf(2, 0)).reshape(2)
        val result = sd.output(mapOf("input" to inputArr, "target" to targetArr), "nll_loss")["nll_loss"]!!

        // NLL loss should be positive
        assertTrue(result.getFloat(0) > 0)
    }

    @Test
    fun testSoftmaxCrossEntropyLoss() {
        val sd = SameDiff.create()
        val logits = sd.placeHolder("logits", DataType.FLOAT, -1, 3)
        val labels = sd.placeHolder("labels", DataType.FLOAT, -1, 3)  // one-hot

        // Softmax Cross Entropy
        val logSoftmax = sd.nn.logSoftmax("log_softmax", logits, 1)
        val crossEntropy = sd.math.neg(sd.math.sum(sd.math.mul(labels, logSoftmax), false, 1))
        val output = sd.math.mean("softmax_ce", crossEntropy)

        val logitsArr = Nd4j.create(floatArrayOf(1f, 2f, 3f)).reshape(1, 3)
        val labelsArr = Nd4j.create(floatArrayOf(0f, 0f, 1f)).reshape(1, 3)  // true class = 2
        val result = sd.output(mapOf("logits" to logitsArr, "labels" to labelsArr), "softmax_ce")["softmax_ce"]!!

        // Cross entropy should be small when prediction matches label
        assertTrue(result.getFloat(0) < 1.0)
    }

    // ==================== ML Domain Operators ====================

    @Test
    fun testBinarizer() {
        val sd = SameDiff.create()
        val input = sd.placeHolder("input", DataType.FLOAT, -1, 4)

        // Binarizer: output = input > threshold ? 1 : 0
        val threshold = 0.5
        val output = sd.gt("binarized", input, threshold).castTo(DataType.FLOAT)

        val inputArr = Nd4j.create(floatArrayOf(0.2f, 0.5f, 0.7f, 1.0f)).reshape(1, 4)
        val result = sd.output(mapOf("input" to inputArr), "binarized")["binarized"]!!

        assertEquals(0f, result.getFloat(0, 0), 0.01f)  // 0.2 <= 0.5
        assertEquals(0f, result.getFloat(0, 1), 0.01f)  // 0.5 <= 0.5
        assertEquals(1f, result.getFloat(0, 2), 0.01f)  // 0.7 > 0.5
        assertEquals(1f, result.getFloat(0, 3), 0.01f)  // 1.0 > 0.5
    }

    @Test
    fun testNormalizer() {
        val sd = SameDiff.create()
        val input = sd.placeHolder("input", DataType.FLOAT, -1, 3)

        // L2 Normalizer
        val norm = sd.norm2("norm", input, false, 1)
        val output = sd.math.div("normalized", input, norm)

        val inputArr = Nd4j.create(floatArrayOf(3f, 4f, 0f)).reshape(1, 3)
        val result = sd.output(mapOf("input" to inputArr), "normalized")["normalized"]!!

        // L2 norm of [3, 4, 0] = 5, so normalized = [0.6, 0.8, 0]
        assertEquals(0.6f, result.getFloat(0, 0), 0.01f)
        assertEquals(0.8f, result.getFloat(0, 1), 0.01f)
        assertEquals(0f, result.getFloat(0, 2), 0.01f)
    }

    @Test
    fun testScaler() {
        val sd = SameDiff.create()
        val input = sd.placeHolder("input", DataType.FLOAT, -1, 3)

        // Scaler: y = scale * x + offset
        val scale = Nd4j.create(floatArrayOf(2f, 2f, 2f))
        val offset = Nd4j.create(floatArrayOf(1f, 1f, 1f))
        val scaleConst = sd.constant("scale", scale)
        val offsetConst = sd.constant("offset", offset)

        val output = sd.math.add("scaled", sd.math.mul(input, scaleConst), offsetConst)

        val inputArr = Nd4j.create(floatArrayOf(0f, 1f, 2f)).reshape(1, 3)
        val result = sd.output(mapOf("input" to inputArr), "scaled")["scaled"]!!

        // [0, 1, 2] * 2 + 1 = [1, 3, 5]
        assertEquals(1f, result.getFloat(0, 0), 0.01f)
        assertEquals(3f, result.getFloat(0, 1), 0.01f)
        assertEquals(5f, result.getFloat(0, 2), 0.01f)
    }

    @Test
    fun testLinearClassifier() {
        val sd = SameDiff.create()
        val input = sd.placeHolder("input", DataType.FLOAT, -1, 2)  // [batch, features]

        // Linear classifier: scores = X * W + b
        val weights = Nd4j.create(floatArrayOf(1f, 0f, 0f, 1f)).reshape(2, 2)
        val bias = Nd4j.create(floatArrayOf(0f, 0f))
        val w = sd.constant("weights", weights)
        val b = sd.constant("bias", bias)

        val scores = sd.math.add("scores", sd.mmul(input, w), b)
        val predictions = sd.argmax("predictions", scores, false, 1)

        val inputArr = Nd4j.create(floatArrayOf(1f, 0f, 0f, 1f)).reshape(2, 2)
        val result = sd.output(mapOf("input" to inputArr), "predictions")["predictions"]!!

        // First sample [1, 0] -> class 0, second sample [0, 1] -> class 1
        assertEquals(0L, result.getLong(0))
        assertEquals(1L, result.getLong(1))
    }

    @Test
    fun testLinearRegressor() {
        val sd = SameDiff.create()
        val input = sd.placeHolder("input", DataType.FLOAT, -1, 2)

        // Linear regressor: y = X * W + b
        val weights = Nd4j.create(floatArrayOf(1f, 2f)).reshape(2, 1)
        val bias = Nd4j.create(floatArrayOf(1f))
        val w = sd.constant("weights", weights)
        val b = sd.constant("bias", bias)

        val output = sd.math.add("prediction", sd.mmul(input, w), b)

        val inputArr = Nd4j.create(floatArrayOf(1f, 1f)).reshape(1, 2)
        val result = sd.output(mapOf("input" to inputArr), "prediction")["prediction"]!!

        // [1, 1] * [1, 2]^T + 1 = 1*1 + 1*2 + 1 = 4
        assertEquals(4f, result.getFloat(0), 0.01f)
    }

    // ==================== Quantization Operators ====================

    @Test
    fun testDequantizeLinear() {
        val sd = SameDiff.create()
        val input = sd.placeHolder("input", DataType.INT8, -1, 4)

        // Dequantize: y = (x - zero_point) * scale
        val scale = 0.1f
        val zeroPoint = 0

        val xFloat = input.castTo(DataType.FLOAT)
        val shifted = sd.math.sub(xFloat, zeroPoint.toDouble())
        val output = sd.math.mul("dequantized", shifted, scale.toDouble())

        val inputArr = Nd4j.createFromArray(byteArrayOf(-10, 0, 10, 20)).castTo(DataType.INT8).reshape(1, 4)
        val result = sd.output(mapOf("input" to inputArr), "dequantized")["dequantized"]!!

        // [-10, 0, 10, 20] * 0.1 = [-1, 0, 1, 2]
        assertEquals(-1f, result.getFloat(0, 0), 0.01f)
        assertEquals(0f, result.getFloat(0, 1), 0.01f)
        assertEquals(1f, result.getFloat(0, 2), 0.01f)
        assertEquals(2f, result.getFloat(0, 3), 0.01f)
    }

    @Test
    fun testQuantizeLinear() {
        val sd = SameDiff.create()
        val input = sd.placeHolder("input", DataType.FLOAT, -1, 4)

        // Quantize: y = clamp(round(x / scale + zero_point), min, max)
        val scale = 0.1f
        val zeroPoint = 0f

        val scaled = sd.math.div(input, scale.toDouble())
        val shifted = sd.math.add(scaled, zeroPoint.toDouble())
        val rounded = sd.math.round(shifted)
        val clamped = sd.math.clipByValue("quantized", rounded, -128.0, 127.0)

        val inputArr = Nd4j.create(floatArrayOf(-1f, 0f, 1f, 2f)).reshape(1, 4)
        val result = sd.output(mapOf("input" to inputArr), "quantized")["quantized"]!!

        // [-1, 0, 1, 2] / 0.1 = [-10, 0, 10, 20]
        assertEquals(-10f, result.getFloat(0, 0), 0.01f)
        assertEquals(0f, result.getFloat(0, 1), 0.01f)
        assertEquals(10f, result.getFloat(0, 2), 0.01f)
        assertEquals(20f, result.getFloat(0, 3), 0.01f)
    }

    // ==================== Spatial Operations ====================

    @Test
    fun testDepthToSpace() {
        val sd = SameDiff.create()
        val input = sd.placeHolder("input", DataType.FLOAT, 1, 4, 2, 2)

        // DepthToSpace with blocksize=2
        // Input: [1, 4, 2, 2] -> Output: [1, 1, 4, 4]
        val output = sd.cnn.depthToSpace("d2s", input, 2, "DCR")

        val inputArr = Nd4j.linspace(1, 16, 16, DataType.FLOAT).reshape(1, 4, 2, 2)
        val result = sd.output(mapOf("input" to inputArr), "d2s")["d2s"]!!

        assertEquals(4, result.rank())
        assertEquals(1, result.shape()[0])
        assertEquals(1, result.shape()[1])
        assertEquals(4, result.shape()[2])
        assertEquals(4, result.shape()[3])
    }

    @Test
    fun testSpaceToDepth() {
        val sd = SameDiff.create()
        val input = sd.placeHolder("input", DataType.FLOAT, 1, 1, 4, 4)

        // SpaceToDepth with blocksize=2
        // Input: [1, 1, 4, 4] -> Output: [1, 4, 2, 2]
        val output = sd.cnn.spaceToDepth("s2d", input, 2, "NCHW")

        val inputArr = Nd4j.linspace(1, 16, 16, DataType.FLOAT).reshape(1, 1, 4, 4)
        val result = sd.output(mapOf("input" to inputArr), "s2d")["s2d"]!!

        assertEquals(4, result.rank())
        assertEquals(1, result.shape()[0])
        assertEquals(4, result.shape()[1])
        assertEquals(2, result.shape()[2])
        assertEquals(2, result.shape()[3])
    }

    // ==================== Encoder Operations ====================

    @Test
    fun testOneHotEncoder() {
        val sd = SameDiff.create()
        val input = sd.placeHolder("input", DataType.INT64, -1)

        // One-hot encoding with 4 categories
        val output = sd.oneHot("onehot", input, 4)

        val inputArr = Nd4j.createFromArray(longArrayOf(0, 1, 2, 3)).reshape(4)
        val result = sd.output(mapOf("input" to inputArr), "onehot")["onehot"]!!

        assertEquals(2, result.rank())
        assertEquals(4, result.shape()[0])
        assertEquals(4, result.shape()[1])

        // Check diagonal is 1
        for (i in 0 until 4) {
            assertEquals(1f, result.getFloat(i.toLong(), i.toLong()), 0.01f)
        }
    }

    @Test
    fun testLabelEncoder() {
        val sd = SameDiff.create()
        val input = sd.placeHolder("input", DataType.INT64, -1)

        // Label encoding using gather
        val labels = Nd4j.createFromArray(longArrayOf(10, 20, 30, 40))
        val labelsConst = sd.constant("labels", labels)
        val output = sd.gather("encoded", labelsConst, input, 0)

        val inputArr = Nd4j.createFromArray(longArrayOf(0, 2, 1, 3))
        val result = sd.output(mapOf("input" to inputArr), "encoded")["encoded"]!!

        assertEquals(10L, result.getLong(0))
        assertEquals(30L, result.getLong(1))
        assertEquals(20L, result.getLong(2))
        assertEquals(40L, result.getLong(3))
    }

    // ==================== Feature Extraction ====================

    @Test
    fun testArrayFeatureExtractor() {
        val sd = SameDiff.create()
        val input = sd.placeHolder("input", DataType.FLOAT, -1, 5)
        val indices = sd.placeHolder("indices", DataType.INT64, -1)

        // Extract specific features
        val output = sd.gather("extracted", input, indices, 1)

        val inputArr = Nd4j.create(floatArrayOf(1f, 2f, 3f, 4f, 5f)).reshape(1, 5)
        val indicesArr = Nd4j.createFromArray(longArrayOf(0, 2, 4))
        val result = sd.output(mapOf("input" to inputArr, "indices" to indicesArr), "extracted")["extracted"]!!

        assertEquals(1f, result.getFloat(0, 0), 0.01f)
        assertEquals(3f, result.getFloat(0, 1), 0.01f)
        assertEquals(5f, result.getFloat(0, 2), 0.01f)
    }

    @Test
    fun testFeatureVectorizer() {
        val sd = SameDiff.create()
        val input1 = sd.placeHolder("input1", DataType.FLOAT, -1, 2)
        val input2 = sd.placeHolder("input2", DataType.FLOAT, -1, 3)

        // Concatenate features
        val output = sd.concat("features", 1, input1, input2)

        val input1Arr = Nd4j.create(floatArrayOf(1f, 2f)).reshape(1, 2)
        val input2Arr = Nd4j.create(floatArrayOf(3f, 4f, 5f)).reshape(1, 3)
        val result = sd.output(mapOf("input1" to input1Arr, "input2" to input2Arr), "features")["features"]!!

        assertEquals(5, result.shape()[1])
        assertEquals(1f, result.getFloat(0, 0), 0.01f)
        assertEquals(2f, result.getFloat(0, 1), 0.01f)
        assertEquals(3f, result.getFloat(0, 2), 0.01f)
        assertEquals(4f, result.getFloat(0, 3), 0.01f)
        assertEquals(5f, result.getFloat(0, 4), 0.01f)
    }

    // ==================== Imputation ====================

    @Test
    fun testImputer() {
        val sd = SameDiff.create()
        val input = sd.placeHolder("input", DataType.FLOAT, -1, 3)

        // Replace NaN with specified value
        val replaceValue = 0f
        val isNan = sd.isNaN(input)
        val replacement = sd.constant("replacement", Nd4j.scalar(replaceValue))
        val output = sd.where("imputed", isNan, replacement, input)

        val inputArr = Nd4j.create(floatArrayOf(1f, Float.NaN, 3f)).reshape(1, 3)
        val result = sd.output(mapOf("input" to inputArr), "imputed")["imputed"]!!

        assertEquals(1f, result.getFloat(0, 0), 0.01f)
        assertEquals(0f, result.getFloat(0, 1), 0.01f)  // NaN replaced with 0
        assertEquals(3f, result.getFloat(0, 2), 0.01f)
    }

    // ==================== Sequence Operations ====================

    @Test
    fun testConcatFromSequence() {
        val sd = SameDiff.create()
        val input1 = sd.placeHolder("input1", DataType.FLOAT, -1, 3)
        val input2 = sd.placeHolder("input2", DataType.FLOAT, -1, 3)

        // Concatenate along axis 0
        val output = sd.concat("concat", 0, input1, input2)

        val input1Arr = Nd4j.create(floatArrayOf(1f, 2f, 3f)).reshape(1, 3)
        val input2Arr = Nd4j.create(floatArrayOf(4f, 5f, 6f)).reshape(1, 3)
        val result = sd.output(mapOf("input1" to input1Arr, "input2" to input2Arr), "concat")["concat"]!!

        assertEquals(2, result.shape()[0])
        assertEquals(3, result.shape()[1])
    }

    @Test
    fun testSplitToSequence() {
        val sd = SameDiff.create()
        val input = sd.placeHolder("input", DataType.FLOAT, 4, 3)

        // Split into 2 parts along axis 0
        val outputs = sd.split(input, 2, 0)

        val inputArr = Nd4j.linspace(1, 12, 12, DataType.FLOAT).reshape(4, 3)
        val result = sd.output(mapOf("input" to inputArr), outputs[0].name(), outputs[1].name())

        assertEquals(2, result.size)
        assertEquals(2, result[outputs[0].name()]!!.shape()[0])
        assertEquals(2, result[outputs[1].name()]!!.shape()[0])
    }

    // ==================== Tree Ensemble (simplified) ====================

    @Test
    fun testTreeEnsembleClassifierSimplified() {
        val sd = SameDiff.create()
        val input = sd.placeHolder("input", DataType.FLOAT, -1, 4)

        // Simplified tree ensemble: just use linear projection + argmax
        val numClasses = 3
        val weights = Nd4j.randn(4, numClasses).mul(0.1)
        val bias = Nd4j.zeros(numClasses)
        val w = sd.constant("weights", weights)
        val b = sd.constant("bias", bias)

        val scores = sd.math.add("scores", sd.mmul(input, w), b)
        val probs = sd.nn.softmax("probs", scores, 1)
        val predictions = sd.argmax("predictions", scores, false, 1)

        val inputArr = Nd4j.rand(DataType.FLOAT, 2, 4)
        val result = sd.output(mapOf("input" to inputArr), "predictions", "probs")

        // Check output shapes
        assertEquals(2, result["predictions"]!!.length())
        assertEquals(2, result["probs"]!!.shape()[0])
        assertEquals(3, result["probs"]!!.shape()[1])

        // Predictions should be in [0, 2]
        for (i in 0 until 2) {
            val pred = result["predictions"]!!.getLong(i.toLong())
            assertTrue(pred in 0..2)
        }
    }

    @Test
    fun testTreeEnsembleRegressorSimplified() {
        val sd = SameDiff.create()
        val input = sd.placeHolder("input", DataType.FLOAT, -1, 4)

        // Simplified: linear regression
        val weights = Nd4j.randn(4, 1).mul(0.1)
        val bias = Nd4j.zeros(1)
        val w = sd.constant("weights", weights)
        val b = sd.constant("bias", bias)

        val output = sd.math.add("prediction", sd.mmul(input, w), b)

        val inputArr = Nd4j.rand(DataType.FLOAT, 2, 4)
        val result = sd.output(mapOf("input" to inputArr), "prediction")["prediction"]!!

        assertEquals(2, result.shape()[0])
        assertEquals(1, result.shape()[1])
    }

    // ==================== SVM Operations ====================

    @Test
    fun testSVMClassifierLinear() {
        val sd = SameDiff.create()
        val input = sd.placeHolder("input", DataType.FLOAT, -1, 2)

        // Linear SVM: decision = X * W + b
        val weights = Nd4j.create(floatArrayOf(1f, -1f)).reshape(2, 1)
        val bias = Nd4j.create(floatArrayOf(0f))
        val w = sd.constant("weights", weights)
        val b = sd.constant("bias", bias)

        val scores = sd.math.add("scores", sd.mmul(input, w), b)
        val sign = sd.math.sign(scores)
        val predictions = sd.math.max("predictions", sign, 0.0).castTo(DataType.INT64)

        val inputArr = Nd4j.create(floatArrayOf(1f, 0f, 0f, 1f, 1f, 1f)).reshape(3, 2)
        val result = sd.output(mapOf("input" to inputArr), "predictions")["predictions"]!!

        // [1, 0] -> score = 1, class 1
        // [0, 1] -> score = -1, class 0
        // [1, 1] -> score = 0, class 0 (sign(0) = 0)
        assertEquals(1L, result.getLong(0))
        assertEquals(0L, result.getLong(1))
    }

    @Test
    fun testSVMRegressorLinear() {
        val sd = SameDiff.create()
        val input = sd.placeHolder("input", DataType.FLOAT, -1, 2)

        // Linear SVR: y = X * W + b
        val weights = Nd4j.create(floatArrayOf(2f, 3f)).reshape(2, 1)
        val bias = Nd4j.create(floatArrayOf(1f))
        val w = sd.constant("weights", weights)
        val b = sd.constant("bias", bias)

        val output = sd.math.add("prediction", sd.mmul(input, w), b)

        val inputArr = Nd4j.create(floatArrayOf(1f, 1f)).reshape(1, 2)
        val result = sd.output(mapOf("input" to inputArr), "prediction")["prediction"]!!

        // [1, 1] * [2, 3]^T + 1 = 2 + 3 + 1 = 6
        assertEquals(6f, result.getFloat(0), 0.01f)
    }

    // ==================== Other Operations ====================

