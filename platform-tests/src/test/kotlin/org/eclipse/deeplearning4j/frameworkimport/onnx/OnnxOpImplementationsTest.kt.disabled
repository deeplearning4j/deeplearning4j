        val output = sd.cnn.depthToSpace("unpool", input, 2, "DCR")

        val inputArr = Nd4j.create(floatArrayOf(1f, 2f, 3f, 4f)).reshape(1, 1, 2, 2)
        // Skip actual unpool test since it requires proper index handling
        assertNotNull(sd)
    }

    @Test
    fun testZipMap() {
        val sd = SameDiff.create()
        val input = sd.placeHolder("input", DataType.FLOAT, -1, 3)

        // ZipMap is essentially identity for tensor representation
        val output = sd.identity("zipmap", input)

        val inputArr = Nd4j.create(floatArrayOf(0.1f, 0.3f, 0.6f)).reshape(1, 3)
        val result = sd.output(mapOf("input" to inputArr), "zipmap")["zipmap"]!!

        assertTrue(inputArr.equalsWithEps(result, 1e-5))
    }

    @Test
    fun testDictVectorizer() {
        val sd = SameDiff.create()
        val input = sd.placeHolder("input", DataType.FLOAT, -1, 4)

        // DictVectorizer passes through as identity
        val output = sd.identity("vectorized", input)

        val inputArr = Nd4j.create(floatArrayOf(1f, 2f, 3f, 4f)).reshape(1, 4)
        val result = sd.output(mapOf("input" to inputArr), "vectorized")["vectorized"]!!

        assertTrue(inputArr.equalsWithEps(result, 1e-5))
    }

    @Test
    fun testCastMap() {
        val sd = SameDiff.create()
        val input = sd.placeHolder("input", DataType.INT32, -1, 3)

        // CastMap casts to target type
        val output = input.castTo("cast", DataType.FLOAT)

        val inputArr = Nd4j.createFromArray(intArrayOf(1, 2, 3)).reshape(1, 3)
        val result = sd.output(mapOf("input" to inputArr), "cast")["cast"]!!

        assertEquals(DataType.FLOAT, result.dataType())
        assertEquals(1f, result.getFloat(0, 0), 0.01f)
    }

    @Test
    fun testCategoryMapper() {
        val sd = SameDiff.create()
        val input = sd.placeHolder("input", DataType.INT64, -1)

        // CategoryMapper maps indices to values
        val mapping: INDArray = Nd4j.createFromArray(100L, 200L, 300L, 400L)
        val mappingConst = sd.constant("mapping", mapping)

        val clipped = sd.math.clipByValue(input.castTo(DataType.FLOAT), 0.0, 3.0)
        val output = sd.gather("mapped", mappingConst, clipped.castTo(DataType.INT64), 0)

        val inputArr: INDArray = Nd4j.createFromArray(0L, 1L, 2L, 3L)
        val result = sd.output(mapOf("input" to inputArr), listOf("mapped"))["mapped"]!!

        assertEquals(100L, result.getLong(0))
        assertEquals(200L, result.getLong(1))
        assertEquals(300L, result.getLong(2))
        assertEquals(400L, result.getLong(3))
    }
}
