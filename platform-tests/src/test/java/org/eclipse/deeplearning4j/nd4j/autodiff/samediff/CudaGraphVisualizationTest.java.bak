package org.eclipse.deeplearning4j.nd4j.autodiff.samediff;

import lombok.extern.slf4j.Slf4j;
import org.bytedeco.javacpp.BytePointer;
import org.bytedeco.javacpp.Pointer;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.io.TempDir;
import org.nd4j.autodiff.samediff.SDVariable;
import org.nd4j.autodiff.samediff.SameDiff;
import org.nd4j.autodiff.samediff.execution.DynamicShapePlan;
import org.nd4j.common.tests.tags.NativeTag;
import org.nd4j.common.tests.tags.TagNames;
import org.nd4j.linalg.BaseNd4jTestWithBackends;
import org.nd4j.linalg.api.buffer.DataType;
import org.nd4j.linalg.api.ndarray.INDArray;
import org.nd4j.linalg.factory.Nd4j;
import org.nd4j.nativeblas.NativeOps;
import org.nd4j.nativeblas.NativeOpsHolder;
import org.nd4j.nativeblas.OpaqueContext;

import java.nio.file.Files;
import java.nio.file.Path;
import java.util.HashMap;
import java.util.Map;

import static org.junit.jupiter.api.Assertions.*;

@Slf4j
@Tag(TagNames.SAMEDIFF)
@NativeTag
public class CudaGraphVisualizationTest extends BaseNd4jTestWithBackends {

    private static final int MIN_CAPTURE_OPS = 10;

    @TempDir
    Path tempDir;

    private Pointer compileNativePlan(DynamicShapePlan plan) {
        NativeOps nativeOps = NativeOpsHolder.getInstance().getDeviceNativeOps();
        byte[] serialized = plan.serialize();
        if (serialized == null || serialized.length == 0) {
            return null;
        }
        BytePointer planBytes = new BytePointer(serialized);
        try {
            return nativeOps.compileDynamicShapePlan(planBytes, serialized.length);
        } catch (UnsupportedOperationException e) {
            log.info("Backend does not support native executor: {}", e.getMessage());
            return null;
        } finally {
            planBytes.close();
        }
    }

    private Map<String, INDArray> executeNativePlan(Pointer planHandle, DynamicShapePlan plan,
                                                     INDArray[] extInputs) {
        NativeOps nativeOps = NativeOpsHolder.getInstance().getDeviceNativeOps();
        OpaqueContext context = nativeOps.createContext();

        for (INDArray input : extInputs) {
            nativeOps.ctxCreateNDArrayFromNative(context, input.data().addressPointer(),
                    input.shapeInfoData().addressPointer());
        }

        String[] outputNames = plan.getOutputNames().toArray(new String[0]);
        for (int i = 0; i < outputNames.length; i++) {
            nativeOps.ctxCreateOutputNDArray(context);
        }

        int result = nativeOps.executeDynamicShapePlan(planHandle, context, null);
        assertEquals(0, result, "Plan execution failed");

        Map<String, INDArray> outputs = new HashMap<>();
        for (int i = 0; i < outputNames.length; i++) {
            OpaqueNDArray outArray = nativeOps.ctxGetResultNDArray(context, i);
            if (outArray != null) {
                INDArray arr = nativeOps.asNDArray(outArray);
                outputs.put(outputNames[i], arr);
            }
        }

        nativeOps.deleteContext(context);
        return outputs;
    }

    private SameDiff buildLargeChain(int numOps) {
        SameDiff sd = SameDiff.create();
        SDVariable x = sd.var("x", DataType.FLOAT, 32, 64);
        SDVariable prev = x;

        for (int i = 0; i < numOps; i++) {
            SDVariable w = sd.var("w" + i, DataType.FLOAT, 64, 64);
            SDVariable b = sd.var("b" + i, DataType.FLOAT, 64);
            prev = sd.nn().relu(prev.mmul(w).add(b), 0.0);
        }

        sd.setOutput("output", prev);
        sd.setOutputNames("output");
        return sd;
    }

    @Test
    public void testCudaGraphVisualizationChromeTrace() throws Exception {
        SameDiff sd = buildLargeChain(MIN_CAPTURE_OPS + 5);
        DynamicShapePlan plan = sd.compilePlan();
        Pointer handle = compileNativePlan(plan);

        if (handle == null) {
            log.info("Skipping test - native executor not available");
            return;
        }

        NativeOps nativeOps = NativeOpsHolder.getInstance().getDeviceNativeOps();

        try {
            nativeOps.setPlanCudaGraphsEnabled(handle, true);

            INDArray x = Nd4j.rand(DataType.FLOAT, 32, 64);
            Map<String, INDArray> ph = new HashMap<>();
            ph.put("x", x);

            INDArray[] inputs = plan.orderInputs(ph);
            for (int i = 0; i < 3; i++) {
                executeNativePlan(handle, plan, inputs);
            }

            Path outputPath = tempDir.resolve("cuda_graph_trace.json");
            boolean success = nativeOps.exportPlanCudaGraphChromeTrace(handle, outputPath.toString());

            if (success) {
                assertTrue(Files.exists(outputPath), "Chrome trace file should exist");
                String content = Files.readString(outputPath);
                assertTrue(content.contains("traceEvents"), "Should contain traceEvents");
                log.info("Exported Chrome trace to: {}", outputPath);
            } else {
                log.info("Chrome trace export not supported or no graph captured");
            }
        } finally {
            nativeOps.freeDynamicShapePlan(handle);
        }
    }

    @Test
    public void testCudaGraphVisualizationHtml() throws Exception {
        SameDiff sd = buildLargeChain(MIN_CAPTURE_OPS + 5);
        DynamicShapePlan plan = sd.compilePlan();
        Pointer handle = compileNativePlan(plan);

        if (handle == null) {
            log.info("Skipping test - native executor not available");
            return;
        }

        NativeOps nativeOps = NativeOpsHolder.getInstance().getDeviceNativeOps();

        try {
            nativeOps.setPlanCudaGraphsEnabled(handle, true);

            INDArray x = Nd4j.rand(DataType.FLOAT, 32, 64);
            Map<String, INDArray> ph = new HashMap<>();
            ph.put("x", x);

            INDArray[] inputs = plan.orderInputs(ph);
            for (int i = 0; i < 3; i++) {
                executeNativePlan(handle, plan, inputs);
            }

            Path outputPath = tempDir.resolve("cuda_graph_viz.html");
            boolean success = nativeOps.exportPlanCudaGraphHtml(handle, outputPath.toString());

            if (success) {
                assertTrue(Files.exists(outputPath), "HTML visualization file should exist");
                String content = Files.readString(outputPath);
                assertTrue(content.contains("<!DOCTYPE html>"), "Should be valid HTML");
                assertTrue(content.contains("CUDA Graph Visualization"), "Should have visualization title");
                log.info("Exported HTML visualization to: {}", outputPath);
            } else {
                log.info("HTML export not supported or no graph captured");
            }
        } finally {
            nativeOps.freeDynamicShapePlan(handle);
        }
    }

    @Test
    public void testCudaGraphDebugDump() throws Exception {
        SameDiff sd = buildLargeChain(MIN_CAPTURE_OPS + 5);
        DynamicShapePlan plan = sd.compilePlan();
        Pointer handle = compileNativePlan(plan);

        if (handle == null) {
            log.info("Skipping test - native executor not available");
            return;
        }

        NativeOps nativeOps = NativeOpsHolder.getInstance().getDeviceNativeOps();

        try {
            nativeOps.setPlanCudaGraphsEnabled(handle, true);

            INDArray x = Nd4j.rand(DataType.FLOAT, 32, 64);
            Map<String, INDArray> ph = new HashMap<>();
            ph.put("x", x);

            INDArray[] inputs = plan.orderInputs(ph);
            for (int i = 0; i < 3; i++) {
                executeNativePlan(handle, plan, inputs);
            }

            Path basePath = tempDir.resolve("cuda_graph_debug");
            boolean success = nativeOps.debugDumpPlanCudaGraph(handle, basePath.toString());

            if (success) {
                log.info("Debug dump created at base path: {}", basePath);
            } else {
                log.info("Debug dump not supported or no graph captured");
            }
        } finally {
            nativeOps.freeDynamicShapePlan(handle);
        }
    }

    @Test
    public void testCudaGraphTimelineJson() throws Exception {
        SameDiff sd = buildLargeChain(MIN_CAPTURE_OPS + 5);
        DynamicShapePlan plan = sd.compilePlan();
        Pointer handle = compileNativePlan(plan);

        if (handle == null) {
            log.info("Skipping test - native executor not available");
            return;
        }

        NativeOps nativeOps = NativeOpsHolder.getInstance().getDeviceNativeOps();

        try {
            nativeOps.setPlanCudaGraphsEnabled(handle, true);

            INDArray x = Nd4j.rand(DataType.FLOAT, 32, 64);
            Map<String, INDArray> ph = new HashMap<>();
            ph.put("x", x);

            INDArray[] inputs = plan.orderInputs(ph);
            for (int i = 0; i < 3; i++) {
                executeNativePlan(handle, plan, inputs);
            }

            String timelineJson = nativeOps.getPlanCudaGraphChromeTraceJson(handle);
            if (timelineJson != null && !timelineJson.isEmpty()) {
                assertTrue(timelineJson.contains("traceEvents"), "Timeline should contain traceEvents");
                log.info("Timeline JSON length: {} chars", timelineJson.length());
            } else {
                log.info("Timeline JSON not available or empty");
            }

            nativeOps.clearPlanCudaGraphTimeline(handle);
            String clearedJson = nativeOps.getPlanCudaGraphChromeTraceJson(handle);
            log.info("After clear, timeline length: {}",
                    clearedJson != null ? clearedJson.length() : "null");
        } finally {
            nativeOps.freeDynamicShapePlan(handle);
        }
    }

    @Test
    public void testCudaGraphReplayStats() throws Exception {
        SameDiff sd = buildLargeChain(MIN_CAPTURE_OPS + 5);
        DynamicShapePlan plan = sd.compilePlan();
        Pointer handle = compileNativePlan(plan);

        if (handle == null) {
            log.info("Skipping test - native executor not available");
            return;
        }

        NativeOps nativeOps = NativeOpsHolder.getInstance().getDeviceNativeOps();

        try {
            nativeOps.setPlanCudaGraphsEnabled(handle, true);

            INDArray x = Nd4j.rand(DataType.FLOAT, 32, 64);
            Map<String, INDArray> ph = new HashMap<>();
            ph.put("x", x);

            INDArray[] inputs = plan.orderInputs(ph);
            for (int i = 0; i < 5; i++) {
                executeNativePlan(handle, plan, inputs);
            }

            int numCaptured = nativeOps.getPlanNumCapturedGraphSegments(handle);
            int totalReplays = nativeOps.getPlanTotalGraphReplays(handle);
            String captureStats = nativeOps.getPlanCaptureStats(handle);

            log.info("Captured segments: {}", numCaptured);
            log.info("Total replays: {}", totalReplays);
            log.info("Capture stats: {}", captureStats);

            if (numCaptured > 0) {
                assertTrue(totalReplays > 0, "Should have graph replays after capture");
            }
        } finally {
            nativeOps.freeDynamicShapePlan(handle);
        }
    }
}
