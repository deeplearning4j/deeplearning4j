        BackendManager.DeviceInfo info = backends.defaultDeviceInfo();

        // Small allocation should be possible
        assertTrue(info.canAllocate(1024), "Should be able to allocate 1KB");

        // Very large allocation likely not possible
        long hugeSize = Long.MAX_VALUE / 2;
        assertFalse(info.canAllocate(hugeSize), "Should not be able to allocate huge amount");

        log.info("canAllocate test passed");
    }

