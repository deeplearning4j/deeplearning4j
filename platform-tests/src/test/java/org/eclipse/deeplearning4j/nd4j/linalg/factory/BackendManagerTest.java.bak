    // =========================================================================
    // Multi-GPU Tests
    // =========================================================================

    @Nested
    @DisplayName("Multi-GPU Tests")
    @Tag("multi-gpu")
    class MultiGpuTests {

        private List<DeviceDescriptor> gpus;
        private boolean multiGpuAvailable;

        @BeforeEach
        void setUp() {
            gpus = backends.gpus();
            multiGpuAvailable = gpus.size() >= 2;
            if (!multiGpuAvailable) {
                log.warn("Multi-GPU tests require at least 2 GPUs. Found: {}", gpus.size());
            }
        }

        @Test
        @DisplayName("Should detect multiple GPUs when available")
        void testMultiGpuDetection() {
            List<DeviceDescriptor> allGpus = backends.gpus();
            log.info("Detected {} GPU(s)", allGpus.size());

            for (int i = 0; i < allGpus.size(); i++) {
                DeviceDescriptor gpu = allGpus.get(i);
                log.info("GPU {}: {} ({})", i, gpu.getDeviceName(), gpu.getDeviceId());
                assertTrue(gpu.getDeviceType().isGpu(), "Device should be a GPU");
            }
        }

        @Test
        @DisplayName("Should be able to query each GPU individually")
        void testIndividualGpuQuery() {
            if (!backends.isGpuAvailable()) {
                log.warn("No GPUs available, skipping test");
                return;
            }

            for (int i = 0; i < gpus.size(); i++) {
                DeviceDescriptor gpu = backends.device(DeviceType.CUDA_GPU, i);
                if (gpu != null) {
                    BackendManager.DeviceInfo info = backends.deviceInfo(gpu);
                    assertNotNull(info, "Should get info for GPU " + i);
                    assertTrue(info.getTotalMemory() > 0, "GPU should have memory");
                    log.info("GPU {}: {} MB total, {} MB available",
                            i, info.getTotalMemory() / (1024 * 1024),
                            info.getAvailableMemory() / (1024 * 1024));
                }
            }
        }

        @Test
        @DisplayName("Should allocate arrays on different GPUs")
        void testAllocateOnDifferentGpus() {
            if (!multiGpuAvailable) {
                log.warn("Skipping multi-GPU allocation test - not enough GPUs");
                return;
            }

            DeviceDescriptor gpu0 = gpus.get(0);
            DeviceDescriptor gpu1 = gpus.get(1);

            // Create arrays on different GPUs
            INDArray arrayOnGpu0 = DeviceAwareNDArrayFactory.createOnDevice(
                    new long[]{100, 100}, DataType.FLOAT, gpu0);
            INDArray arrayOnGpu1 = DeviceAwareNDArrayFactory.createOnDevice(
                    new long[]{100, 100}, DataType.FLOAT, gpu1);

            assertNotNull(arrayOnGpu0, "Array on GPU 0 should not be null");
            assertNotNull(arrayOnGpu1, "Array on GPU 1 should not be null");

            log.info("Created arrays on GPU 0 and GPU 1");

            // Cleanup
            arrayOnGpu0.close();
            arrayOnGpu1.close();
        }

        @Test
        @DisplayName("Should transfer data between GPUs")
        void testGpuToGpuTransfer() {
            if (!multiGpuAvailable) {
                log.warn("Skipping GPU-to-GPU transfer test - not enough GPUs");
                return;
            }

            DeviceDescriptor gpu0 = gpus.get(0);
            DeviceDescriptor gpu1 = gpus.get(1);

            // Create array on GPU 0
            float[] data = new float[1000];
            for (int i = 0; i < data.length; i++) {
                data[i] = i;
            }
            INDArray array = DeviceAwareNDArrayFactory.createFromArrayOnDevice(
                    data, new long[]{10, 100}, gpu0);

            // Transfer to GPU 1
            DeviceAwareNDArrayFactory.ensureOnDevice(array, gpu1);

            // Verify data integrity
            float[] result = array.toFloatVector();
            assertEquals(data.length, result.length, "Data length should match");
            for (int i = 0; i < Math.min(10, data.length); i++) {
                assertEquals(data[i], result[i], 0.001f, "Data at index " + i + " should match");
            }

            log.info("GPU-to-GPU transfer completed successfully");

            array.close();
        }

        @Test
        @DisplayName("Should perform operations with arrays on different GPUs")
        void testCrossGpuOperations() {
            if (!multiGpuAvailable) {
                log.warn("Skipping cross-GPU operations test - not enough GPUs");
                return;
            }

            DeviceDescriptor gpu0 = gpus.get(0);
            DeviceDescriptor gpu1 = gpus.get(1);

            // Create arrays on different GPUs
            INDArray a = DeviceAwareNDArrayFactory.createOnDevice(new long[]{100, 100}, gpu0);
            INDArray b = DeviceAwareNDArrayFactory.createOnDevice(new long[]{100, 100}, gpu1);

            // Fill with values
            a.assign(1.0);
            b.assign(2.0);

            // Operation should work (automatic transfer)
            INDArray result = a.add(b);

            assertNotNull(result, "Result should not be null");
            assertEquals(3.0, result.getDouble(0), 0.001, "Result should be 3.0");

            log.info("Cross-GPU operation completed successfully");

            a.close();
            b.close();
            result.close();
        }

        @Test
        @DisplayName("Should distribute batch across multiple GPUs")
        void testBatchDistribution() {
            if (!multiGpuAvailable) {
                log.warn("Skipping batch distribution test - not enough GPUs");
                return;
            }

            DeviceDescriptor gpu0 = gpus.get(0);
            DeviceDescriptor gpu1 = gpus.get(1);

            // Create batch distributed across GPUs
            INDArray[] batch = DeviceAwareNDArrayFactory.createBatchOnDevices(
                    new long[]{50, 50}, 4, gpu0, gpu1);

            assertEquals(4, batch.length, "Should create 4 arrays");

            // Arrays should alternate between GPUs
            for (int i = 0; i < batch.length; i++) {
                assertNotNull(batch[i], "Batch element " + i + " should not be null");
            }

            log.info("Batch distribution across GPUs completed");

            // Cleanup
            for (INDArray arr : batch) {
                arr.close();
            }
        }

        @Test
        @DisplayName("Should handle async prefetch to multiple GPUs")
        void testAsyncPrefetchMultiGpu() throws Exception {
            if (!multiGpuAvailable) {
                log.warn("Skipping async prefetch test - not enough GPUs");
                return;
            }

            DeviceDescriptor gpu0 = gpus.get(0);
            DeviceDescriptor gpu1 = gpus.get(1);

            // Create array on CPU
            INDArray array = Nd4j.rand(DataType.FLOAT, 100, 100);

            // Prefetch to both GPUs asynchronously
            CompletableFuture<Void> future0 = DeviceAwareNDArrayFactory.prefetchToDevice(array, gpu0);
            CompletableFuture<Void> future1 = DeviceAwareNDArrayFactory.prefetchToDevice(array, gpu1);

            // Wait for both
            CompletableFuture.allOf(future0, future1).get(30, TimeUnit.SECONDS);

            log.info("Async prefetch to multiple GPUs completed");

            array.close();
        }
    }

    // =========================================================================
    // Hybrid Buffer Tests
    // =========================================================================

    @Nested
    @DisplayName("Hybrid Buffer Tests")
    @Tag("hybrid-buffer")
    class HybridBufferTests {

        private DeviceDescriptor cpuDevice;
        private DeviceDescriptor gpuDevice;
        private boolean gpuAvailable;

        @BeforeEach
        void setUp() {
            cpuDevice = backends.device(DeviceType.CPU, 0);
            gpuAvailable = backends.isGpuAvailable();
            if (gpuAvailable) {
                gpuDevice = backends.gpus().get(0);
            }
        }

        @Test
        @DisplayName("DataBuffer should report hybrid status correctly")
        void testHybridBufferDetection() {
            INDArray array = Nd4j.create(DataType.FLOAT, 100, 100);
            DataBuffer buffer = array.data();

            assertNotNull(buffer, "Buffer should not be null");
            // Note: isHybrid depends on the backend implementation
            log.info("Buffer is hybrid: {}", buffer.isHybrid());

            if (buffer.isHybrid()) {
                HybridDataBuffer hybridBuffer = buffer.asHybrid();
                assertNotNull(hybridBuffer, "asHybrid() should return non-null for hybrid buffers");
            }

            array.close();
        }

        @Test
        @DisplayName("Should create array on CPU device")
        void testCreateOnCpu() {
            INDArray array = DeviceAwareNDArrayFactory.createOnCpu(new long[]{50, 50});

            assertNotNull(array, "Array should not be null");
            assertEquals(50 * 50, array.length(), "Array should have correct length");

            log.info("Created array on CPU: shape={}", array.shapeInfoToString());

            array.close();
        }

        @Test
        @DisplayName("Should create array on GPU device")
        void testCreateOnGpu() {
            if (!gpuAvailable) {
                log.warn("No GPU available, skipping test");
                return;
            }

            INDArray array = DeviceAwareNDArrayFactory.createOnCuda(new long[]{50, 50}, 0);

            assertNotNull(array, "Array should not be null");
            assertEquals(50 * 50, array.length(), "Array should have correct length");

            log.info("Created array on GPU: shape={}", array.shapeInfoToString());

            array.close();
        }

        @Test
        @DisplayName("Should transfer array from CPU to GPU")
        void testCpuToGpuTransfer() {
            if (!gpuAvailable) {
                log.warn("No GPU available, skipping test");
                return;
            }

            // Create on CPU with known data
            float[] data = {1.0f, 2.0f, 3.0f, 4.0f, 5.0f, 6.0f};
            INDArray array = Nd4j.create(data, new long[]{2, 3});

            // Transfer to GPU
            DeviceAwareNDArrayFactory.transferToCuda(array, 0);

            // Verify data is intact - use flatten to convert to 1D for comparison
            float[] result = array.dup().reshape(-1).toFloatVector();
            assertArrayEquals(data, result, 0.001f, "Data should be preserved after transfer");

            log.info("CPU to GPU transfer successful");

            array.close();
        }

        @Test
        @DisplayName("Should transfer array from GPU to CPU")
        void testGpuToCpuTransfer() {
            if (!gpuAvailable) {
                log.warn("No GPU available, skipping test");
                return;
            }

            // Create on GPU
            float[] data = {1.0f, 2.0f, 3.0f, 4.0f};
            INDArray array = DeviceAwareNDArrayFactory.createFromArrayOnDevice(
                    data, new long[]{2, 2}, gpuDevice);

            // Transfer to CPU
            DeviceAwareNDArrayFactory.transferToCpu(array);

            // Verify data - use flatten to convert to 1D for comparison
            float[] result = array.dup().reshape(-1).toFloatVector();
            assertArrayEquals(data, result, 0.001f, "Data should be preserved after transfer");

            log.info("GPU to CPU transfer successful");

            array.close();
        }

        @Test
        @DisplayName("Hybrid buffer should track device validity")
        void testDeviceValidityTracking() {
            if (!gpuAvailable) {
                log.warn("No GPU available, skipping test");
                return;
            }

            INDArray array = Nd4j.rand(DataType.FLOAT, 100, 100);
            DataBuffer buffer = array.data();

            if (buffer.isHybrid()) {
                HybridDataBuffer hybrid = buffer.asHybrid();

                // Initially should be valid on owner device
                DeviceDescriptor owner = hybrid.getOwnerDevice();
                if (owner != null) {
                    assertTrue(hybrid.isValidOn(owner), "Should be valid on owner device");
                }

                // Ensure on GPU
                hybrid.ensureAvailableOn(gpuDevice);
                assertTrue(hybrid.isValidOn(gpuDevice), "Should be valid on GPU after transfer");

                // Ensure on CPU
                hybrid.ensureAvailableOn(cpuDevice);
                assertTrue(hybrid.isValidOn(cpuDevice), "Should be valid on CPU after transfer");

                log.info("Device validity tracking test passed");
            } else {
                log.info("Buffer is not hybrid, skipping validity tracking test");
            }

            array.close();
        }

        @Test
        @DisplayName("Should mark device invalid and require re-transfer")
        void testInvalidateDevice() {
            if (!gpuAvailable) {
                log.warn("No GPU available, skipping test");
                return;
            }

            INDArray array = Nd4j.rand(DataType.FLOAT, 50, 50);
            DataBuffer buffer = array.data();

            if (buffer.isHybrid()) {
                HybridDataBuffer hybrid = buffer.asHybrid();

                // Ensure on GPU
                hybrid.ensureAvailableOn(gpuDevice);

                // Invalidate GPU
                hybrid.markInvalidOn(gpuDevice);
                assertFalse(hybrid.isValidOn(gpuDevice), "Should be invalid after marking");

                // Re-transfer should work
                hybrid.ensureAvailableOn(gpuDevice);
                assertTrue(hybrid.isValidOn(gpuDevice), "Should be valid after re-transfer");

                log.info("Invalidate and re-transfer test passed");
            }

            array.close();
        }

        @Test
        @DisplayName("Hybrid buffer should handle sync operations")
        void testSyncOperations() {
            if (!gpuAvailable) {
                log.warn("No GPU available, skipping test");
                return;
            }

            float[] data = {1.0f, 2.0f, 3.0f, 4.0f, 5.0f, 6.0f, 7.0f, 8.0f};
            INDArray array = Nd4j.create(data, new long[]{2, 4});
            DataBuffer buffer = array.data();

            if (buffer.isHybrid()) {
                HybridDataBuffer hybrid = buffer.asHybrid();

                // Sync to device
                hybrid.syncHostToDevice();

                // Sync back to host
                hybrid.syncDeviceToHost();

                // Verify data - use reshape to convert 2D to 1D for comparison
                float[] result = array.dup().reshape(-1).toFloatVector();
                assertArrayEquals(data, result, 0.001f, "Data should be preserved after sync");

                log.info("Sync operations test passed");
            }

            array.close();
        }

        @Test
        @DisplayName("Should perform operations with CPU and GPU arrays")
        void testCrossDeviceOperations() {
            if (!gpuAvailable) {
                log.warn("No GPU available, skipping test");
                return;
            }

            // Create array on CPU
            INDArray cpuArray = DeviceAwareNDArrayFactory.createOnCpu(new long[]{100, 100});
            cpuArray.assign(2.0);

            // Create array on GPU
            INDArray gpuArray = DeviceAwareNDArrayFactory.createOnCuda(new long[]{100, 100}, 0);
            gpuArray.assign(3.0);

            // Operations should work with automatic data movement
            INDArray sum = cpuArray.add(gpuArray);
            assertEquals(5.0, sum.getDouble(0), 0.001, "Sum should be 5.0");

            INDArray product = cpuArray.mul(gpuArray);
            assertEquals(6.0, product.getDouble(0), 0.001, "Product should be 6.0");

            log.info("Cross-device operations test passed");

            cpuArray.close();
            gpuArray.close();
            sum.close();
            product.close();
        }

        @Test
        @DisplayName("Should copy array to new device")
        void testCopyToDevice() {
            if (!gpuAvailable) {
                log.warn("No GPU available, skipping test");
                return;
            }

            float[] data = {1.0f, 2.0f, 3.0f, 4.0f};
            INDArray original = Nd4j.create(data, new long[]{2, 2});

            // Copy to GPU (original should stay on CPU)
            INDArray gpuCopy = DeviceAwareNDArrayFactory.copyToDevice(original, gpuDevice);

            assertNotNull(gpuCopy, "Copy should not be null");
            assertNotSame(original, gpuCopy, "Should be a new array");

            // Verify both have same data - use flatten to convert to 1D for comparison
            float[] originalData = original.dup().reshape(-1).toFloatVector();
            float[] copyData = gpuCopy.dup().reshape(-1).toFloatVector();
            assertArrayEquals(originalData, copyData, 0.001f, "Data should match");

            // Modify copy, original should be unchanged
            gpuCopy.assign(99.0);
            assertEquals(1.0f, original.getFloat(0), 0.001f, "Original should be unchanged");
            assertEquals(99.0f, gpuCopy.getFloat(0), 0.001f, "Copy should be modified");

            log.info("Copy to device test passed");

            original.close();
            gpuCopy.close();
        }

        @Test
        @DisplayName("Should transfer all arrays to device")
        void testTransferAllToDevice() {
            if (!gpuAvailable) {
                log.warn("No GPU available, skipping test");
                return;
            }

            // Create multiple arrays
            INDArray[] arrays = new INDArray[5];
            for (int i = 0; i < arrays.length; i++) {
                arrays[i] = Nd4j.rand(DataType.FLOAT, 50, 50);
            }

            // Transfer all to GPU
            DeviceAwareNDArrayFactory.transferAllToDevice(arrays, gpuDevice);

            // Verify all arrays are still valid
            for (int i = 0; i < arrays.length; i++) {
                assertEquals(50 * 50, arrays[i].length(), "Array " + i + " should have correct length");
            }

            log.info("Transfer all to device test passed");

            for (INDArray arr : arrays) {
                arr.close();
            }
        }

        @Test
        @DisplayName("Should transfer all arrays asynchronously")
        void testTransferAllAsync() throws Exception {
            if (!gpuAvailable) {
                log.warn("No GPU available, skipping test");
                return;
            }

            // Create multiple arrays
            INDArray[] arrays = new INDArray[5];
            for (int i = 0; i < arrays.length; i++) {
                arrays[i] = Nd4j.rand(DataType.FLOAT, 50, 50);
            }

            // Transfer all asynchronously
            CompletableFuture<Void> future = DeviceAwareNDArrayFactory.transferAllToDeviceAsync(
                    arrays, gpuDevice);

            // Wait for completion
            future.get(30, TimeUnit.SECONDS);

            // Verify all arrays are still valid
            for (int i = 0; i < arrays.length; i++) {
                assertEquals(50 * 50, arrays[i].length(), "Array " + i + " should have correct length");
            }

            log.info("Async transfer all test passed");

            for (INDArray arr : arrays) {
                arr.close();
            }
        }

        @Test
        @DisplayName("Should check device validity")
        void testIsValidOnDevice() {
            if (!gpuAvailable) {
                log.warn("No GPU available, skipping test");
                return;
            }

            INDArray array = Nd4j.rand(DataType.FLOAT, 50, 50);

            // Transfer to GPU
            DeviceAwareNDArrayFactory.ensureOnDevice(array, gpuDevice);

            // Should be valid on GPU
            boolean validOnGpu = DeviceAwareNDArrayFactory.isValidOnDevice(array, gpuDevice);
            log.info("Array valid on GPU: {}", validOnGpu);

            array.close();
        }

        @Test
        @DisplayName("Should get owner device")
        void testGetOwnerDevice() {
            if (!gpuAvailable) {
                log.warn("No GPU available, skipping test");
                return;
            }

            INDArray array = DeviceAwareNDArrayFactory.createOnDevice(
                    new long[]{50, 50}, DataType.FLOAT, gpuDevice);

            DeviceDescriptor owner = DeviceAwareNDArrayFactory.getOwnerDevice(array);
            log.info("Owner device: {}", owner != null ? owner.getDeviceId() : "null");

            array.close();
        }

        @Test
        @DisplayName("Should handle hybrid buffer host/device buffer checks")
        void testHybridBufferChecks() {
            INDArray array = Nd4j.rand(DataType.FLOAT, 50, 50);
            DataBuffer buffer = array.data();

            if (buffer.isHybrid()) {
                HybridDataBuffer hybrid = buffer.asHybrid();

                // Check buffer existence
                boolean hasHost = hybrid.hasHostBuffer();
                boolean hasDevice = hybrid.hasDeviceBuffer();

                log.info("Has host buffer: {}, Has device buffer: {}", hasHost, hasDevice);

                // Get addresses (may be 0 if not allocated)
                long hostAddr = hybrid.getHostBufferAddress();
                long deviceAddr = hybrid.getDeviceBufferAddress();

                log.info("Host address: {}, Device address: {}", hostAddr, deviceAddr);
            }

            array.close();
        }

        @Test
        @DisplayName("Should mark and check dirty flags")
        void testDirtyFlags() {
            INDArray array = Nd4j.rand(DataType.FLOAT, 50, 50);
            DataBuffer buffer = array.data();

            if (buffer.isHybrid()) {
                HybridDataBuffer hybrid = buffer.asHybrid();

                // Initial state
                boolean hostDirty = hybrid.isHostDirty();
                boolean deviceDirty = hybrid.isDeviceDirty();

                log.info("Initial - Host dirty: {}, Device dirty: {}", hostDirty, deviceDirty);

                // Mark dirty
                hybrid.markHostDirty();
                hybrid.markDeviceDirty();

                log.info("After marking - Host dirty: {}, Device dirty: {}",
                        hybrid.isHostDirty(), hybrid.isDeviceDirty());
            }

            array.close();
        }

        @Test
        @DisplayName("Should ensure data on host")
        void testEnsureOnHost() {
            if (!gpuAvailable) {
                log.warn("No GPU available, skipping test");
                return;
            }

            // Create on GPU
            INDArray array = DeviceAwareNDArrayFactory.createOnCuda(new long[]{50, 50}, 0);
            array.assign(42.0);

            DataBuffer buffer = array.data();
            if (buffer.isHybrid()) {
                HybridDataBuffer hybrid = buffer.asHybrid();
                hybrid.ensureOnHost();

                // Verify data is accessible
                assertEquals(42.0, array.getDouble(0), 0.001, "Data should be accessible on host");
            }

            array.close();
        }

        @Test
        @DisplayName("Should concatenate arrays from different devices")
        void testConcatFromDifferentDevices() {
            if (!gpuAvailable) {
                log.warn("No GPU available, skipping test");
                return;
            }

            // Create arrays on different devices
            INDArray cpuArray = DeviceAwareNDArrayFactory.createOnCpu(new long[]{10, 5});
            cpuArray.assign(1.0);

            INDArray gpuArray = DeviceAwareNDArrayFactory.createOnCuda(new long[]{10, 5}, 0);
            gpuArray.assign(2.0);

            // Concatenate on GPU
            INDArray result = DeviceAwareNDArrayFactory.concatOnDevice(
                    new INDArray[]{cpuArray, gpuArray}, 0, gpuDevice);

            assertNotNull(result, "Result should not be null");
            assertEquals(20, result.rows(), "Should have 20 rows");
            assertEquals(5, result.columns(), "Should have 5 columns");

            // First 10 rows should be 1.0, next 10 should be 2.0
            assertEquals(1.0, result.getDouble(0, 0), 0.001, "First part should be 1.0");
            assertEquals(2.0, result.getDouble(10, 0), 0.001, "Second part should be 2.0");

            log.info("Concat from different devices test passed");

            cpuArray.close();
            gpuArray.close();
            result.close();
        }
    }

    // =========================================================================
    // Cross-Device Matrix Operations Tests
    // =========================================================================

    @Nested
    @DisplayName("Cross-Device Matrix Operations")
    @Tag("cross-device")
    class CrossDeviceMatrixTests {

        private boolean gpuAvailable;
        private DeviceDescriptor cpuDevice;
        private DeviceDescriptor gpuDevice;

        @BeforeEach
        void setUp() {
            cpuDevice = backends.device(DeviceType.CPU, 0);
            gpuAvailable = backends.isGpuAvailable();
            if (gpuAvailable) {
                gpuDevice = backends.gpus().get(0);
            }
        }

        @Test
        @DisplayName("Matrix multiplication with arrays on different devices")
        @org.junit.jupiter.api.Disabled("Known issue: NaN check during mmul has buffer initialization problem in CUDA backend")
        void testCrossDeviceMatMul() {
            if (!gpuAvailable) {
                log.warn("No GPU available, skipping test");
                return;
            }

            // Create matrices using standard Nd4j.create to ensure proper buffer initialization
            // The cross-device aspect is tested by the automatic transfer during mmul
            INDArray cpuMatrix = Nd4j.ones(DataType.FLOAT, 100, 50);  // All 1.0
            INDArray gpuMatrix = Nd4j.ones(DataType.FLOAT, 50, 100).mul(2.0);  // All 2.0

            // Matrix multiplication should work
            // Result: each element should be 50 * 1.0 * 2.0 = 100.0
            INDArray result = cpuMatrix.mmul(gpuMatrix);

            assertNotNull(result, "Result should not be null");
            assertEquals(100, result.rows(), "Result should have 100 rows");
            assertEquals(100, result.columns(), "Result should have 100 columns");
            assertEquals(100.0, result.getDouble(0, 0), 0.01, "Result values should be 100.0");

            log.info("Cross-device MatMul test passed: {}x{}", result.rows(), result.columns());

            cpuMatrix.close();
            gpuMatrix.close();
            result.close();
        }

        @Test
        @DisplayName("Element-wise operations across devices")
        void testCrossDeviceElementWise() {
            if (!gpuAvailable) {
                log.warn("No GPU available, skipping test");
                return;
            }

            INDArray cpu = DeviceAwareNDArrayFactory.createOnCpu(new long[]{50, 50});
            cpu.assign(2.0);

            INDArray gpu = DeviceAwareNDArrayFactory.createOnCuda(new long[]{50, 50}, 0);
            gpu.assign(3.0);

            // Addition
            INDArray sum = cpu.add(gpu);
            assertEquals(5.0, sum.getDouble(0), 0.001, "Addition should work");

            // Subtraction
            INDArray diff = cpu.sub(gpu);
            assertEquals(-1.0, diff.getDouble(0), 0.001, "Subtraction should work");

            // Multiplication
            INDArray prod = cpu.mul(gpu);
            assertEquals(6.0, prod.getDouble(0), 0.001, "Multiplication should work");

            // Division
            INDArray quot = cpu.div(gpu);
            assertEquals(2.0 / 3.0, quot.getDouble(0), 0.001, "Division should work");

            log.info("Cross-device element-wise operations test passed");

            cpu.close();
            gpu.close();
            sum.close();
            diff.close();
            prod.close();
            quot.close();
        }

        @Test
        @DisplayName("Reduction operations on GPU arrays")
        void testGpuReductions() {
            if (!gpuAvailable) {
                log.warn("No GPU available, skipping test");
                return;
            }

            INDArray gpuArray = DeviceAwareNDArrayFactory.createOnCuda(new long[]{100, 100}, 0);
            gpuArray.assign(2.0);

            // Sum
            double sum = gpuArray.sumNumber().doubleValue();
            assertEquals(100 * 100 * 2.0, sum, 0.01, "Sum should be correct");

            // Mean
            double mean = gpuArray.meanNumber().doubleValue();
            assertEquals(2.0, mean, 0.001, "Mean should be 2.0");

            // Max/Min
            double max = gpuArray.maxNumber().doubleValue();
            assertEquals(2.0, max, 0.001, "Max should be 2.0");

            log.info("GPU reduction operations test passed");

            gpuArray.close();
        }

        @Test
        @DisplayName("Broadcasting across devices")
        void testCrossDeviceBroadcasting() {
            if (!gpuAvailable) {
                log.warn("No GPU available, skipping test");
                return;
            }

            // Matrix on GPU
            INDArray matrix = DeviceAwareNDArrayFactory.createOnCuda(new long[]{10, 5}, 0);
            matrix.assign(1.0);

            // Vector on CPU
            INDArray vector = DeviceAwareNDArrayFactory.createOnCpu(new long[]{1, 5});
            vector.assign(Nd4j.create(new float[]{1, 2, 3, 4, 5}));

            // Broadcast addition
            INDArray result = matrix.add(vector);

            assertNotNull(result, "Result should not be null");
            assertEquals(10, result.rows(), "Should have 10 rows");
            assertEquals(5, result.columns(), "Should have 5 columns");

            // First column should all be 2.0 (1.0 + 1)
            assertEquals(2.0, result.getDouble(0, 0), 0.001, "First column should be 2.0");
            // Last column should all be 6.0 (1.0 + 5)
            assertEquals(6.0, result.getDouble(0, 4), 0.001, "Last column should be 6.0");

            log.info("Cross-device broadcasting test passed");

            matrix.close();
            vector.close();
            result.close();
        }
    }
}
