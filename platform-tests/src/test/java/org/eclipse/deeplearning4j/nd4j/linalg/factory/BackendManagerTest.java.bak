import java.util.concurrent.TimeUnit;

import static org.junit.jupiter.api.Assertions.*;

/**
 * Tests for the unified BackendManager API.
 *
 * This test class verifies:
 * - Auto-initialization works correctly
 * - Device queries return expected results
 * - Memory statistics are tracked
 * - Scoped device forcing works
 * - Fluent configuration API works
 *
 * @author Eclipse Deeplearning4j Development Team
 */
@Tag("multi-backend")
@DisplayName("BackendManager Tests")
public class BackendManagerTest {

    private static final Logger log = LoggerFactory.getLogger(BackendManagerTest.class);

    private BackendManager backends;

    @BeforeEach
    void setUp() {
        backends = Nd4j.backends();
    }

    // =========================================================================
    // Initialization Tests
    // =========================================================================

    @Test
    @DisplayName("BackendManager should be accessible via Nd4j.backends()")
    void testBackendManagerAccessible() {
        assertNotNull(backends, "Nd4j.backends() should not return null");
        assertSame(backends, Nd4j.backends(), "Should return same instance");
    }

    @Test
    @DisplayName("BackendManager should be auto-initialized")
    void testAutoInitialization() {
        assertTrue(backends.isInitialized(), "BackendManager should be auto-initialized");
    }

    @Test
    @DisplayName("At least one device should be available (CPU at minimum)")
    void testAtLeastOneDeviceAvailable() {
        List<DeviceDescriptor> devices = backends.devices();
        assertNotNull(devices, "devices() should not return null");
        assertFalse(devices.isEmpty(), "At least CPU device should be available");
    }

    // =========================================================================
    // Device Query Tests
    // =========================================================================

    @Test
    @DisplayName("Default device should be available")
    void testDefaultDevice() {
        DeviceDescriptor defaultDevice = backends.defaultDevice();
        assertNotNull(defaultDevice, "Default device should not be null");
        assertNotNull(defaultDevice.getDeviceId(), "Device ID should not be null");
        assertNotNull(defaultDevice.getDeviceType(), "Device type should not be null");

        log.info("Default device: {} ({})", defaultDevice.getDeviceId(), defaultDevice.getDeviceType());
    }

    @Test
    @DisplayName("isGpuAvailable should reflect actual GPU availability")
    void testIsGpuAvailable() {
        boolean gpuAvailable = backends.isGpuAvailable();
        List<DeviceDescriptor> gpus = backends.gpus();

        assertEquals(!gpus.isEmpty(), gpuAvailable,
                "isGpuAvailable should match whether GPU devices exist");

        log.info("GPU available: {}, GPU count: {}", gpuAvailable, gpus.size());
    }

    @Test
    @DisplayName("All devices should have valid properties")
    void testDeviceProperties() {
        for (DeviceDescriptor device : backends.devices()) {
            assertNotNull(device.getDeviceId(), "Device ID should not be null");
            assertNotNull(device.getDeviceType(), "Device type should not be null");
            assertTrue(device.getTotalMemory() > 0, "Total memory should be positive");

            log.info("Device {}: type={}, memory={} MB",
                    device.getDeviceId(),
                    device.getDeviceType(),
                    device.getTotalMemory() / (1024 * 1024));
        }
    }

    // =========================================================================
    // Memory Statistics Tests
    // =========================================================================

    @Test
    @DisplayName("Memory statistics should be available for all devices")
    void testMemoryStats() {
        Map<String, DeviceMemoryManager.DeviceMemoryStats> stats = backends.memoryStats();
        assertNotNull(stats, "Memory stats should not be null");
        assertFalse(stats.isEmpty(), "Memory stats should not be empty");

        for (Map.Entry<String, DeviceMemoryManager.DeviceMemoryStats> entry : stats.entrySet()) {
            DeviceMemoryManager.DeviceMemoryStats s = entry.getValue();
            assertNotNull(s.deviceId, "Device ID should not be null");
            assertTrue(s.total > 0, "Total memory should be positive");
            assertTrue(s.utilization >= 0 && s.utilization <= 1,
                    "Utilization should be between 0 and 1");

            log.info("Memory stats for {}: {}/{} MB used ({:.1f}%)",
                    s.deviceId,
                    s.allocated / (1024 * 1024),
                    s.total / (1024 * 1024),
                    s.utilization * 100);
        }
    }

    @Test
    @DisplayName("Allocation should be tracked in memory stats")
    void testAllocationTracking() {
        // Get initial stats
        Map<String, DeviceMemoryManager.DeviceMemoryStats> beforeStats = backends.memoryStats();

        // Create an array
        INDArray array = Nd4j.create(DataType.FLOAT, 1000, 1000);  // 4MB

        // Get stats after allocation
        Map<String, DeviceMemoryManager.DeviceMemoryStats> afterStats = backends.memoryStats();

        // Verify allocation was tracked (on at least one device)
        boolean allocationTracked = false;
        for (String deviceId : afterStats.keySet()) {
            long before = beforeStats.containsKey(deviceId) ? beforeStats.get(deviceId).allocated : 0;
            long after = afterStats.get(deviceId).allocated;
            if (after > before) {
                allocationTracked = true;
                log.info("Allocation tracked on {}: {} -> {} bytes",
                        deviceId, before, after);
            }
        }

        // Note: Allocation tracking may not work perfectly in all backends
        // This is more of a smoke test
        log.info("Allocation tracking verified: {}", allocationTracked);

        // Cleanup
        array.close();
    }

    // =========================================================================
    // Device Selection Tests
    // =========================================================================

    @Test
    @DisplayName("selectForAllocation should return a valid device")
    void testSelectForAllocation() {
        long bytes = 1024 * 1024;  // 1MB
        DeviceDescriptor device = backends.selectForAllocation(bytes);

        assertNotNull(device, "Selected device should not be null");
        assertNotNull(device.getDeviceId(), "Device ID should not be null");

        log.info("Selected device for {} bytes: {}", bytes, device.getDeviceId());
    }

    @Test
    @DisplayName("Array allocation should go to selected device")
    void testArrayDeviceAllocation() {
        INDArray array = Nd4j.create(DataType.FLOAT, 100, 100);
        DeviceDescriptor arrayDevice = backends.getArrayDevice(array);

        assertNotNull(arrayDevice, "Array device should not be null");

        log.info("Array allocated on: {}", arrayDevice.getDeviceId());

        array.close();
    }

    // =========================================================================
    // Scoped Device Tests
    // =========================================================================

    @Test
    @DisplayName("forceDevice scope should work")
    void testForceDeviceScope() {
        DeviceDescriptor cpuDevice = null;
        for (DeviceDescriptor d : backends.devices()) {
            if (d.getDeviceType() == DeviceType.CPU) {
                cpuDevice = d;
                break;
            }
        }

        if (cpuDevice != null) {
            try (BackendManager.DeviceScope scope = backends.forceDevice(DeviceType.CPU)) {
                assertNotNull(scope, "Scope should not be null");
                assertEquals(DeviceType.CPU, scope.getDevice().getDeviceType(),
                        "Scope should be for CPU");
            }
            log.info("forceDevice scope test passed");
        } else {
            log.warn("No CPU device found, skipping forceDevice test");
        }
    }

    @Test
    @DisplayName("withDevice should execute code in device context")
    void testWithDevice() {
        DeviceDescriptor defaultDevice = backends.defaultDevice();

        String result = backends.withDevice(defaultDevice, () -> {
            // Create array in this context
            INDArray array = Nd4j.create(10);
            return "Created array with " + array.length() + " elements";
        });

        assertNotNull(result);
        assertTrue(result.contains("10 elements"));
        log.info("withDevice result: {}", result);
    }

    // =========================================================================
    // Configuration Tests
    // =========================================================================

    @Test
    @DisplayName("Fluent configuration should not throw")
    void testFluentConfiguration() {
        assertDoesNotThrow(() -> {
            backends
                    .memoryFallback(true)
                    .autoTransfer(true)
                    .gpuMemoryFraction(0.9)
                    .cpuMemoryFraction(0.8)
                    .apply();
        });

        log.info("Fluent configuration applied successfully");
    }

    @Test
    @DisplayName("Priority configuration should be accepted")
    void testPriorityConfiguration() {
        assertDoesNotThrow(() -> {
            backends
                    .priority(DeviceType.CUDA_GPU, DeviceType.CPU)
                    .apply();
        });

        log.info("Priority configuration applied successfully");
    }

    // =========================================================================
    // Info and Summary Tests
    // =========================================================================

    @Test
    @DisplayName("info() should not throw")
    void testInfo() {
        assertDoesNotThrow(() -> backends.info());
    }

    @Test
    @DisplayName("summary() should return a valid string")
    void testSummary() {
        String summary = backends.summary();
        assertNotNull(summary);
        assertFalse(summary.isEmpty());
        assertTrue(summary.contains("BackendManager"));

        log.info("Summary: {}", summary);
    }

    @Test
    @DisplayName("toString() should return summary")
    void testToString() {
        String str = backends.toString();
