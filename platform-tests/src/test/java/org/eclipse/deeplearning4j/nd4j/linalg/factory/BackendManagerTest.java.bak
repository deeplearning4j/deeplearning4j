    @Test
    @DisplayName("DeviceInfo toString should provide compact representation")
    void testDeviceInfoToString() {
        BackendManager.DeviceInfo info = backends.defaultDeviceInfo();
        String str = info.toString();

        assertNotNull(str, "toString should not return null");
        assertTrue(str.contains("DeviceInfo"), "Should contain class name");
