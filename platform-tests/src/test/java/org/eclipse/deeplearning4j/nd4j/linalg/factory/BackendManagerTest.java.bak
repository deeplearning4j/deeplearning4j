    @Test
    @DisplayName("defaultDeviceInfo should return info for default device")
    void testDefaultDeviceInfo() {
        BackendManager.DeviceInfo defaultInfo = backends.defaultDeviceInfo();

        assertNotNull(defaultInfo, "Default device info should not be null");
        assertEquals(backends.defaultDevice().getDeviceId(), defaultInfo.getDeviceId(),
                "Should be info for default device");

        log.info("Default device info: {}", defaultInfo);
    }

    @Test
    @DisplayName("DeviceInfo should expose all device properties")
    void testDeviceInfoProperties() {
        BackendManager.DeviceInfo info = backends.defaultDeviceInfo();

        // Basic properties
        assertNotNull(info.getDevice(), "Underlying device should be accessible");
        assertTrue(info.getDeviceIndex() >= 0, "Device index should be non-negative");
        assertNotNull(info.getBackendId(), "Backend ID should not be null");

        // Memory properties
        assertTrue(info.getTotalMemory() > 0, "Total memory should be positive");
        assertTrue(info.getAvailableMemory() >= 0, "Available memory should be non-negative");
        assertTrue(info.getAllocatedMemory() >= 0, "Allocated memory should be non-negative");
        assertTrue(info.getMemoryCap() >= 0, "Memory cap should be non-negative");
        assertTrue(info.getUtilization() >= 0 && info.getUtilization() <= 1,
                "Utilization should be between 0 and 1");

        // Status
        assertTrue(info.isEnabled(), "Default device should be enabled");
        assertFalse(info.isDisabled(), "Default device should not be disabled");
        assertTrue(info.isAvailable(), "Default device should be available");

        // Compute properties
        assertTrue(info.getComputeUnits() >= 0, "Compute units should be non-negative");
        assertTrue(info.getComputeCapability() >= 0, "Compute capability should be non-negative");

        log.info("DeviceInfo properties test passed for: {}", info.getDeviceId());
    }

    @Test
