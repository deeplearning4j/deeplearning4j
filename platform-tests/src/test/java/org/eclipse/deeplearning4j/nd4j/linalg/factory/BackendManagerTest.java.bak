    // =========================================================================
    // Device Management Tests
    // =========================================================================

    @Test
    @DisplayName("disableDevice and enableDevice should work")
    void testDisableEnableDevice() {
        List<DeviceDescriptor> devices = backends.devices();
        if (devices.size() < 1) {
            log.warn("No devices available, skipping disable/enable test");
            return;
        }

        DeviceDescriptor device = devices.get(0);

        // Initially should be enabled
        assertTrue(backends.isDeviceEnabled(device), "Device should be enabled initially");

        // Disable
        backends.disableDevice(device);
        assertFalse(backends.isDeviceEnabled(device), "Device should be disabled after disableDevice");

        // Enable again
        backends.enableDevice(device);
        assertTrue(backends.isDeviceEnabled(device), "Device should be enabled after enableDevice");

        log.info("Disable/enable device test passed for: {}", device.getDeviceId());
    }

    @Test
    @DisplayName("enabledDevices and disabledDevices should reflect state")
    void testEnabledDisabledDeviceLists() {
        List<DeviceDescriptor> allDevices = backends.devices();
        if (allDevices.size() < 1) {
            log.warn("No devices available, skipping enabled/disabled lists test");
            return;
        }

        // Reset to clean state
        backends.resetDeviceConfigurations();

        // All devices should be enabled initially
        List<DeviceDescriptor> enabled = backends.enabledDevices();
        List<DeviceDescriptor> disabled = backends.disabledDevices();

        assertEquals(allDevices.size(), enabled.size(), "All devices should be enabled initially");
        assertTrue(disabled.isEmpty(), "No devices should be disabled initially");

        // Disable first device
        DeviceDescriptor firstDevice = allDevices.get(0);
        backends.disableDevice(firstDevice);

        enabled = backends.enabledDevices();
        disabled = backends.disabledDevices();

        assertEquals(allDevices.size() - 1, enabled.size(), "One less device should be enabled");
        assertEquals(1, disabled.size(), "One device should be disabled");
        assertTrue(disabled.stream().anyMatch(d -> d.getDeviceId().equals(firstDevice.getDeviceId())),
                "Disabled list should contain the disabled device");

        // Re-enable
        backends.enableDevice(firstDevice);

        log.info("Enabled/disabled device lists test passed");
    }

    @Test
    @DisplayName("DeviceInfo should reflect disabled state")
    void testDeviceInfoReflectsDisabledState() {
        DeviceDescriptor device = backends.defaultDevice();

        // Initially enabled
        BackendManager.DeviceInfo info = backends.deviceInfo(device);
        assertTrue(info.isEnabled(), "Should be enabled initially");
        assertFalse(info.isDisabled(), "Should not be disabled initially");

        // Disable
        backends.disableDevice(device);
        info = backends.deviceInfo(device);
        assertFalse(info.isEnabled(), "Should be disabled after disableDevice");
        assertTrue(info.isDisabled(), "isDisabled should return true");

        // Re-enable
        backends.enableDevice(device);
        info = backends.deviceInfo(device);
        assertTrue(info.isEnabled(), "Should be enabled after enableDevice");

        log.info("DeviceInfo disabled state test passed");
    }

    @Test
    @DisplayName("setDeviceMemoryCap should update memory cap")
    void testSetDeviceMemoryCap() {
        DeviceDescriptor device = backends.defaultDevice();
        long newCap = 512 * 1024 * 1024L; // 512 MB

        backends.setDeviceMemoryCap(device, newCap);

        BackendManager.DeviceInfo info = backends.deviceInfo(device);
        assertEquals(newCap, info.getMemoryCap(), "Memory cap should be updated");

        // Reset
        backends.setDeviceMemoryCap(device, 0); // 0 = unlimited

        log.info("setDeviceMemoryCap test passed");
    }

    @Test
    @DisplayName("setDeviceMemoryFraction should set cap as fraction of total")
    void testSetDeviceMemoryFraction() {
        DeviceDescriptor device = backends.defaultDevice();
        double fraction = 0.5;

        backends.setDeviceMemoryFraction(device, fraction);

        BackendManager.DeviceInfo info = backends.deviceInfo(device);
        long expectedCap = (long) (device.getTotalMemory() * fraction);
        // Allow some tolerance due to rounding
        assertTrue(Math.abs(info.getMemoryCap() - expectedCap) < 1024 * 1024,
                "Memory cap should be approximately 50% of total");

        // Reset
        backends.resetDeviceConfigurations();

        log.info("setDeviceMemoryFraction test passed");
    }

    @Test
    @DisplayName("setDevicePriority should update device priority")
    void testSetDevicePriority() {
        DeviceDescriptor device = backends.defaultDevice();
        int newPriority = 100;

        backends.setDevicePriority(device, newPriority);

        BackendManager.DeviceInfo info = backends.deviceInfo(device);
        assertEquals(newPriority, info.getPriority(), "Priority should be updated");

        // Reset
        backends.resetDeviceConfigurations();

        log.info("setDevicePriority test passed");
    }

    @Test
    @DisplayName("setDefaultDevice should change default device")
    void testSetDefaultDevice() {
        List<DeviceDescriptor> devices = backends.devices();
        if (devices.size() < 1) {
            log.warn("No devices available, skipping setDefaultDevice test");
            return;
        }

        DeviceDescriptor device = devices.get(0);
        backends.setDefaultDevice(device);

        // Note: This test mainly verifies the method doesn't throw
        // The actual effect depends on backend implementation
        assertDoesNotThrow(() -> backends.setDefaultDevice(device));

        log.info("setDefaultDevice test passed");
    }

    @Test
    @DisplayName("setDefaultDevice by type and index should work")
    void testSetDefaultDeviceByTypeAndIndex() {
        // Find a CPU device
        DeviceDescriptor cpuDevice = backends.device(DeviceType.CPU, 0);
        if (cpuDevice != null) {
            assertDoesNotThrow(() -> backends.setDefaultDevice(DeviceType.CPU, 0));
            log.info("setDefaultDevice(CPU, 0) test passed");
        } else {
            log.warn("No CPU device found, skipping setDefaultDevice by type test");
        }
    }

    @Test
    @DisplayName("disableDevice by type and index should work")
    void testDisableDeviceByTypeAndIndex() {
        DeviceDescriptor cpuDevice = backends.device(DeviceType.CPU, 0);
        if (cpuDevice != null) {
            backends.disableDevice(DeviceType.CPU, 0);
            assertFalse(backends.isDeviceEnabled(cpuDevice), "CPU device should be disabled");

            backends.enableDevice(DeviceType.CPU, 0);
            assertTrue(backends.isDeviceEnabled(cpuDevice), "CPU device should be enabled");

            log.info("disable/enable device by type and index test passed");
        } else {
            log.warn("No CPU device found, skipping test");
        }
    }

    @Test
    @DisplayName("resetDeviceConfigurations should reset all settings")
    void testResetDeviceConfigurations() {
        // Make some changes
        DeviceDescriptor device = backends.defaultDevice();
        backends.disableDevice(device);
        backends.setDeviceMemoryCap(device, 256 * 1024 * 1024L);
        backends.setDevicePriority(device, 999);

        // Reset
        backends.resetDeviceConfigurations();

        // Verify reset
        assertTrue(backends.isDeviceEnabled(device), "Device should be enabled after reset");
        assertTrue(backends.disabledDevices().isEmpty(), "No devices should be disabled after reset");

        log.info("resetDeviceConfigurations test passed");
    }

    @Test
    @DisplayName("Device management should be fluent (chainable)")
    void testFluentDeviceManagement() {
        DeviceDescriptor device = backends.defaultDevice();

        // Chain multiple operations
        BackendManager result = backends
                .disableDevice(device)
                .enableDevice(device)
                .setDeviceMemoryCap(device, 1024 * 1024 * 1024L)
                .setDevicePriority(device, 50)
                .resetDeviceConfigurations();

        assertSame(backends, result, "Fluent methods should return same instance");

        log.info("Fluent device management test passed");
    }

    @Test
    @DisplayName("DeviceInfo.getCapabilities should return capabilities set")
    void testDeviceInfoCapabilities() {
        BackendManager.DeviceInfo info = backends.defaultDeviceInfo();

        // Capabilities may be empty but should not be null
        assertNotNull(info.getCapabilities(), "Capabilities should not be null");

        // hasCapability should not throw
        assertDoesNotThrow(() -> info.hasCapability("fp16"));
        assertDoesNotThrow(() -> info.hasCapability("avx2"));

        log.info("Device capabilities: {}", info.getCapabilities());
    }

    @Test
    @DisplayName("DeviceInfo.getProperties should return properties map")
    void testDeviceInfoProperties2() {
        BackendManager.DeviceInfo info = backends.defaultDeviceInfo();

        // Properties may be empty but should not be null
        assertNotNull(info.getProperties(), "Properties should not be null");

        // getProperty should not throw for non-existent key
        assertDoesNotThrow(() -> info.getProperty("nonexistent"));

