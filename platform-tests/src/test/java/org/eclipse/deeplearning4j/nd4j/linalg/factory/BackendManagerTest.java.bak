    @Test
    @DisplayName("deviceInfo should return valid info for a device")
    void testDeviceInfo() {
        DeviceDescriptor device = backends.defaultDevice();
        BackendManager.DeviceInfo info = backends.deviceInfo(device);

        assertNotNull(info, "DeviceInfo should not be null");
        assertNotNull(info.getDeviceId(), "Device ID should not be null");
        assertNotNull(info.getDeviceName(), "Device name should not be null");
        assertNotNull(info.getDeviceType(), "Device type should not be null");
        assertEquals(device.getDeviceId(), info.getDeviceId(), "Device IDs should match");

        log.info("DeviceInfo for {}: {}", device.getDeviceId(), info);
    }

    @Test
    @DisplayName("deviceInfos should return info for all devices")
    void testDeviceInfos() {
        List<BackendManager.DeviceInfo> infos = backends.deviceInfos();

        assertNotNull(infos, "DeviceInfos should not be null");
        assertFalse(infos.isEmpty(), "Should have at least one device info");
        assertEquals(backends.devices().size(), infos.size(), "Should have info for all devices");

        for (BackendManager.DeviceInfo info : infos) {
            assertNotNull(info.getDeviceId(), "Device ID should not be null");
            assertNotNull(info.getDeviceType(), "Device type should not be null");
            assertTrue(info.getTotalMemory() > 0, "Total memory should be positive");
        }

        log.info("Got device info for {} devices", infos.size());
