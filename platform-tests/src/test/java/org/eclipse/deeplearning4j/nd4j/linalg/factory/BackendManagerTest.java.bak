        assertEquals(backends.summary(), str);
    }

    // =========================================================================
    // Integration Tests
    // =========================================================================

    @Test
    @DisplayName("Full workflow: configure, create, execute, query")
    void testFullWorkflow() {
        // Configure
        backends
                .memoryFallback(true)
                .autoTransfer(true)
                .apply();

        // Create arrays
        INDArray a = Nd4j.create(DataType.FLOAT, 100, 100);
        INDArray b = Nd4j.create(DataType.FLOAT, 100, 100);

        // Execute operation
        INDArray c = a.add(b);

        // Query device
        DeviceDescriptor device = backends.getArrayDevice(c);
        assertNotNull(device);

        log.info("Full workflow completed. Result on: {}", device.getDeviceId());

        // Cleanup
        a.close();
        b.close();
        c.close();
    }

    @Test
    @DisplayName("GC should not throw")
    void testGc() {
        // Create some arrays
        INDArray a = Nd4j.create(1000, 1000);
        INDArray b = Nd4j.create(1000, 1000);

        // Close them
        a.close();
        b.close();

        // Trigger GC
        assertDoesNotThrow(() -> backends.gc());

        log.info("GC completed successfully");
    }

    // =========================================================================
    // Device Info Tests
