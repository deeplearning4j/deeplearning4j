package org.eclipse.deeplearning4j.vlm;

import lombok.extern.slf4j.Slf4j;
import org.eclipse.deeplearning4j.llm.generation.DecoderUtils;
import org.junit.jupiter.api.*;
import org.nd4j.autodiff.samediff.SameDiff;
import org.nd4j.linalg.api.buffer.DataType;
import org.nd4j.linalg.api.ndarray.INDArray;
import org.nd4j.linalg.factory.Nd4j;
import org.nd4j.linalg.indexing.NDArrayIndex;

import java.util.*;

import static org.junit.jupiter.api.Assertions.*;

/**
 * Compares manual decode (full KV dup per step, no _causal_mask — the working path)
 * with static KV decode (scatter + views + _causal_mask — the StaticKvCacheDecodeLoop path)
 * using the ACTUAL SmolDocling decoder model.
 *
 * This test loads the real model and runs both paths with identical inputs to find
 * where they diverge. If they produce different tokens, the bug is in how
 * StaticKvCacheDecodeLoop constructs inputs vs how testManualMultiStepDecode does.
 */
@Slf4j
@DisplayName("TestStaticKvVsManualDecode")
@TestMethodOrder(MethodOrderer.OrderAnnotation.class)
public class TestStaticKvVsManualDecode {

    private static SameDiff decoder;
    private static SameDiff embedTokens;
    private static INDArray embeddingTable;
    private static String logitsName;
    private static List<String> kvOutputNames;
    private static List<String> allOutputNames;
    private static final int MAX_STEPS = 30;

    @BeforeAll
    static void loadModel() throws Exception {
        // Use same model loading as TestVLMDecodeQuality
        String modelDir = System.getProperty("vlm.model.dir",
                System.getProperty("user.home") + "/.nd4j/vlm/SmolDocling-256M-preview");
        java.io.File decoderSdz = new java.io.File(modelDir, "decoder.sdz");
        java.io.File embedSdz = new java.io.File(modelDir, "embed_tokens.sdz");

        Assumptions.assumeTrue(decoderSdz.exists(),
                "Decoder model not found at " + decoderSdz + ". Skip.");
        Assumptions.assumeTrue(embedSdz.exists(),
                "Embed model not found at " + embedSdz + ". Skip.");

        decoder = SameDiff.load(decoderSdz, true);
        embedTokens = SameDiff.load(embedSdz, true);

        // Find embedding table
        embeddingTable = extractEmbeddingTable(embedTokens);
        assertNotNull(embeddingTable, "Could not find embedding table");

        // Find output names
        kvOutputNames = new ArrayList<>();
        for (String name : decoder.outputs()) {
            if (name.contains("logit")) {
                logitsName = name;
            } else if (name.startsWith("present")) {
                kvOutputNames.add(name);
            }
        }
        if (logitsName == null) logitsName = decoder.outputs().get(0);

        allOutputNames = new ArrayList<>();
        allOutputNames.add(logitsName);
        allOutputNames.addAll(kvOutputNames);

        log.info("Model loaded: decoder inputs={}, outputs={}", decoder.inputs(), decoder.outputs());
        log.info("Logits: {}, KV outputs: {}", logitsName, kvOutputNames.size());
    }

    @AfterAll
    static void cleanup() {
        if (decoder != null) decoder.close();
        if (embedTokens != null) embedTokens.close();
    }

    private static INDArray extractEmbeddingTable(SameDiff model) {
        INDArray best = null;
        long bestRows = 0;
        for (org.nd4j.autodiff.samediff.SDVariable var : model.variables()) {
            INDArray arr = model.getArrForVarName(var.name());
            if (arr != null && arr.rank() == 2 && arr.size(0) > bestRows) {
                bestRows = arr.size(0);
                best = arr;
            }
        }
        return best;
    }

    /**
     * Test 1: Manual decode (reference path — known working).
     * No _causal_mask. Full KV dup each step. All output().
     */
    @Test
    @Order(1)
    @DisplayName("1. Manual decode (reference)")
    public void testManualDecode() {
        long hiddenSize = embeddingTable.size(1);

        // Prefill with a simple token sequence
        int[] promptTokens = {0, 44, 2692, 46}; // some arbitrary tokens
        INDArray prefillEmbeds = buildPrefillEmbeddings(promptTokens, hiddenSize);
        long seqLen = prefillEmbeds.shape()[1];

        Map<String, INDArray> inputs = new HashMap<>();
        for (String name : decoder.inputs()) {
            if (name.equals("inputs_embeds")) {
                inputs.put(name, prefillEmbeds);
            } else if (name.equals("attention_mask")) {
                inputs.put(name, Nd4j.ones(DataType.LONG, 1, seqLen));
            } else if (name.equals("position_ids")) {
                inputs.put(name, Nd4j.arange(seqLen).reshape(1, seqLen).castTo(DataType.LONG));
            } else if (name.startsWith("past_key_values.")) {
                inputs.put(name, Nd4j.zeros(DataType.FLOAT, 1, 3, 0, 64));
            }
            // DELIBERATELY do NOT include _causal_mask — matches testManualMultiStepDecode
        }

        Map<String, INDArray> result = decoder.output(inputs, allOutputNames.toArray(new String[0]));

        INDArray logits = result.get(logitsName);
        INDArray lastLogits = logits.get(NDArrayIndex.point(0),
                NDArrayIndex.point(seqLen - 1), NDArrayIndex.all());
        int firstToken = lastLogits.argMax().getInt(0);

        List<Integer> generated = new ArrayList<>();
        generated.add(firstToken);

        Map<String, INDArray> kvCache = new HashMap<>();
        for (String kvName : kvOutputNames) {
            String pastName = kvName.replace("present", "past_key_values");
            kvCache.put(pastName, result.get(kvName).dup());
        }
        long pastLen = seqLen;

        for (int step = 1; step < MAX_STEPS; step++) {
            int prevToken = generated.get(generated.size() - 1);
            INDArray tokenEmbed = embeddingTable.getRow(prevToken).reshape(1, 1, hiddenSize);

            Map<String, INDArray> decInputs = new HashMap<>();
            for (String name : decoder.inputs()) {
                if (name.equals("inputs_embeds")) {
                    decInputs.put(name, tokenEmbed);
                } else if (name.equals("input_ids")) {
                    decInputs.put(name, Nd4j.createFromArray(new int[]{prevToken}).reshape(1, 1).castTo(DataType.LONG));
                } else if (name.equals("attention_mask")) {
                    decInputs.put(name, Nd4j.ones(DataType.LONG, 1, pastLen + 1));
                } else if (name.equals("position_ids")) {
                    decInputs.put(name, Nd4j.createFromArray(new long[]{pastLen}).reshape(1, 1));
                } else if (name.startsWith("past_key_values.") && kvCache.containsKey(name)) {
                    decInputs.put(name, kvCache.get(name));
                }
            }

            result = decoder.output(decInputs, allOutputNames.toArray(new String[0]));
            logits = result.get(logitsName);
            int nextToken = logits.get(NDArrayIndex.point(0), NDArrayIndex.point(0), NDArrayIndex.all())
                    .argMax().getInt(0);
            generated.add(nextToken);

            for (String kvName : kvOutputNames) {
                String pastName = kvName.replace("present", "past_key_values");
                kvCache.put(pastName, result.get(kvName).dup());
            }
            pastLen++;
        }

        log.info("Manual decode: {} tokens generated", generated.size());
        log.info("Tokens: {}", generated.subList(0, Math.min(15, generated.size())));
        Set<Integer> unique = new HashSet<>(generated);
        log.info("Unique tokens: {}/{}", unique.size(), generated.size());
        assertTrue(unique.size() >= 5, "Manual decode should produce diverse tokens, got " + unique.size());
    }

    /**
     * Test 2: Static KV decode (StaticKvCacheDecodeLoop path).
     * Uses buildDecoderInputMap, padKvCacheToStaticSize, scatterNewKvEntries.
     * Includes _causal_mask if model declares it.
     */
    @Test
    @Order(2)
    @DisplayName("2. Static KV decode (loop path)")
    public void testStaticKvDecode() {
        long hiddenSize = embeddingTable.size(1);
        List<String> decoderInputNames = decoder.inputs();

        // Check if model uses _causal_mask
        boolean hasCausalMask = decoderInputNames.contains("_causal_mask");
        log.info("Model uses _causal_mask: {}", hasCausalMask);

        // Prefill
        int[] promptTokens = {0, 44, 2692, 46};
        INDArray prefillEmbeds = buildPrefillEmbeddings(promptTokens, hiddenSize);
        long seqLen = prefillEmbeds.shape()[1];

        // Use buildDecoderInputMap for prefill (no static KV yet)
        Map<String, INDArray> inputs = DecoderUtils.buildDecoderInputMap(
                decoderInputNames, decoder,
                prefillEmbeds, null,
                0, seqLen,
                null, 0, 0,
                false, hiddenSize);

        Map<String, INDArray> result = decoder.output(inputs, allOutputNames.toArray(new String[0]));

        INDArray logits = result.get(logitsName);
        INDArray lastLogits = logits.get(NDArrayIndex.point(0),
                NDArrayIndex.point(seqLen - 1), NDArrayIndex.all());
        int firstToken = lastLogits.argMax().getInt(0);

        List<Integer> generated = new ArrayList<>();
        generated.add(firstToken);

        // Transition to static KV
        List<String> keyNames = new ArrayList<>();
        List<String> valueNames = new ArrayList<>();
        for (String kvName : kvOutputNames) {
            if (kvName.contains(".key")) keyNames.add(kvName);
            else if (kvName.contains(".value")) valueNames.add(kvName);
        }

        long maxKvLen = seqLen + MAX_STEPS;
        Map<String, INDArray> staticKvBuffers = DecoderUtils.padKvCacheToStaticSize(
                result, keyNames, valueNames, maxKvLen);
        Nd4j.getExecutioner().commit();
        long cachePos = seqLen;
        long pastSeqLen = seqLen;

        for (int step = 1; step < MAX_STEPS; step++) {
            int prevToken = generated.get(generated.size() - 1);
            INDArray tokenEmbed = embeddingTable.getRow(prevToken).reshape(1, 1, hiddenSize);
            INDArray inputIds = Nd4j.createFromArray(new int[]{prevToken}).reshape(1, 1).castTo(DataType.LONG);

            // Use buildDecoderInputMap with static KV, dspActive=false (view-based)
            Map<String, INDArray> decInputs = DecoderUtils.buildDecoderInputMap(
                    decoderInputNames, decoder,
                    tokenEmbed, inputIds,
                    pastSeqLen, 1,
                    staticKvBuffers, maxKvLen, cachePos,
                    true, hiddenSize,
                    null, false);

            result = decoder.output(decInputs, allOutputNames.toArray(new String[0]));

            logits = result.get(logitsName);
            int nextToken = logits.get(NDArrayIndex.point(0), NDArrayIndex.point(0), NDArrayIndex.all())
                    .argMax().getInt(0);
            generated.add(nextToken);

            // Scatter new KV entries
            DecoderUtils.scatterNewKvEntries(staticKvBuffers, result,
                    keyNames, valueNames, maxKvLen, cachePos);
            cachePos++;
            pastSeqLen++;

            if (step <= 5) {
                log.info("Static KV step {}: token={}", step, nextToken);
            }
        }

        log.info("Static KV decode: {} tokens generated", generated.size());
        log.info("Tokens: {}", generated.subList(0, Math.min(15, generated.size())));
        Set<Integer> unique = new HashSet<>(generated);
        log.info("Unique tokens: {}/{}", unique.size(), generated.size());
        assertTrue(unique.size() >= 5, "Static KV decode should produce diverse tokens, got " + unique.size());
    }

    /**
     * Test 3: Head-to-head comparison.
     * Both paths use IDENTICAL prompt tokens. Compare output token-by-token.
     * If they diverge, the bug is in how static KV + buildDecoderInputMap differs
     * from the manual approach.
     */
    @Test
    @Order(3)
    @DisplayName("3. Manual vs Static KV token comparison")
    public void testManualVsStaticKvTokenComparison() {
        long hiddenSize = embeddingTable.size(1);
        List<String> decoderInputNames = decoder.inputs();
        int[] promptTokens = {0, 44, 2692, 46};
        INDArray prefillEmbeds = buildPrefillEmbeddings(promptTokens, hiddenSize);
        long seqLen = prefillEmbeds.shape()[1];

        // ===== MANUAL PATH =====
        List<Integer> manualTokens = runManualDecode(prefillEmbeds, seqLen, hiddenSize);

        // Reset session to avoid stale state
        decoder.resetSession();

        // ===== STATIC KV PATH =====
        List<Integer> staticTokens = runStaticKvDecode(prefillEmbeds, seqLen, hiddenSize, decoderInputNames);

        // Compare
        log.info("Manual tokens:    {}", manualTokens);
        log.info("Static KV tokens: {}", staticTokens);

        int firstDivergence = -1;
        for (int i = 0; i < Math.min(manualTokens.size(), staticTokens.size()); i++) {
            if (!manualTokens.get(i).equals(staticTokens.get(i))) {
                firstDivergence = i;
                break;
            }
        }

        if (firstDivergence >= 0) {
            log.error("DIVERGENCE at step {}: manual={} static={}", firstDivergence,
                    manualTokens.get(firstDivergence), staticTokens.get(firstDivergence));
        } else {
            log.info("All {} tokens match!", manualTokens.size());
        }

        assertEquals(manualTokens, staticTokens,
                "Manual and static KV decode should produce identical token sequences. " +
                        "First divergence at step " + firstDivergence);
    }

    /**
     * Test 4: Static KV with outputDirect (the actual fast path from step 2+).
     */
    @Test
    @Order(4)
    @DisplayName("4. Static KV with outputDirect after step 1")
    public void testStaticKvWithOutputDirect() {
        long hiddenSize = embeddingTable.size(1);
        List<String> decoderInputNames = decoder.inputs();
        int[] promptTokens = {0, 44, 2692, 46};
        INDArray prefillEmbeds = buildPrefillEmbeddings(promptTokens, hiddenSize);
        long seqLen = prefillEmbeds.shape()[1];

        // Reset session
        decoder.resetSession();

        List<String> keyNames = new ArrayList<>();
        List<String> valueNames = new ArrayList<>();
        for (String kvName : kvOutputNames) {
            if (kvName.contains(".key")) keyNames.add(kvName);
            else if (kvName.contains(".value")) valueNames.add(kvName);
        }

        // Prefill
        Map<String, INDArray> inputs = DecoderUtils.buildDecoderInputMap(
                decoderInputNames, decoder,
                prefillEmbeds, null,
                0, seqLen,
                null, 0, 0,
                false, hiddenSize);

        Map<String, INDArray> result = decoder.output(inputs, allOutputNames.toArray(new String[0]));

        INDArray logits = result.get(logitsName);
        int firstToken = logits.get(NDArrayIndex.point(0), NDArrayIndex.point(seqLen - 1), NDArrayIndex.all())
                .argMax().getInt(0);

        List<Integer> generated = new ArrayList<>();
        generated.add(firstToken);

        long maxKvLen = seqLen + MAX_STEPS;
        Map<String, INDArray> staticKvBuffers = DecoderUtils.padKvCacheToStaticSize(
                result, keyNames, valueNames, maxKvLen);
        Nd4j.getExecutioner().commit();
        long cachePos = seqLen;
        long pastSeqLen = seqLen;

        for (int step = 1; step < MAX_STEPS; step++) {
            int prevToken = generated.get(generated.size() - 1);
            INDArray tokenEmbed = embeddingTable.getRow(prevToken).reshape(1, 1, hiddenSize);
            INDArray inputIds = Nd4j.createFromArray(new int[]{prevToken}).reshape(1, 1).castTo(DataType.LONG);

            Map<String, INDArray> decInputs = DecoderUtils.buildDecoderInputMap(
                    decoderInputNames, decoder,
                    tokenEmbed, inputIds,
                    pastSeqLen, 1,
                    staticKvBuffers, maxKvLen, cachePos,
                    true, hiddenSize,
                    null, false);

            // Use outputDirect for step >= 2 (like StaticKvCacheDecodeLoop)
            boolean useDirect = step >= 2;
            if (useDirect) {
                result = decoder.outputDirect(decInputs, allOutputNames.toArray(new String[0]));
            } else {
                result = decoder.output(decInputs, allOutputNames.toArray(new String[0]));
            }

            logits = result.get(logitsName);
            int nextToken = logits.get(NDArrayIndex.point(0), NDArrayIndex.point(0), NDArrayIndex.all())
                    .argMax().getInt(0);
            generated.add(nextToken);

            DecoderUtils.scatterNewKvEntries(staticKvBuffers, result,
                    keyNames, valueNames, maxKvLen, cachePos);
            cachePos++;
            pastSeqLen++;

            if (step <= 5 || step % 10 == 0) {
                log.info("Step {} (direct={}): token={}", step, useDirect, nextToken);
            }
        }

        log.info("Static KV + outputDirect: {} tokens", generated.size());
        log.info("Tokens: {}", generated.subList(0, Math.min(15, generated.size())));
        Set<Integer> unique = new HashSet<>(generated);
        log.info("Unique: {}/{}", unique.size(), generated.size());
        assertTrue(unique.size() >= 5,
                "Static KV + outputDirect should produce diverse tokens, got " + unique.size());
    }

    /**
     * Test 5: Isolate _causal_mask impact.
     * Manual decode WITH _causal_mask added — does adding it break output?
     */
    @Test
    @Order(5)
    @DisplayName("5. Manual decode WITH _causal_mask")
    public void testManualDecodeWithCausalMask() {
        if (!decoder.inputs().contains("_causal_mask")) {
            log.info("Model does not use _causal_mask — skipping");
            return;
        }

        long hiddenSize = embeddingTable.size(1);

        int[] promptTokens = {0, 44, 2692, 46};
        INDArray prefillEmbeds = buildPrefillEmbeddings(promptTokens, hiddenSize);
        long seqLen = prefillEmbeds.shape()[1];

        decoder.resetSession();

        // Prefill — with _causal_mask
        Map<String, INDArray> inputs = new HashMap<>();
        for (String name : decoder.inputs()) {
            if (name.equals("inputs_embeds")) {
                inputs.put(name, prefillEmbeds);
            } else if (name.equals("attention_mask")) {
                inputs.put(name, Nd4j.ones(DataType.LONG, 1, seqLen));
            } else if (name.equals("position_ids")) {
                inputs.put(name, Nd4j.arange(seqLen).reshape(1, seqLen).castTo(DataType.LONG));
            } else if (name.equals("_causal_mask")) {
                inputs.put(name, DecoderUtils.buildCausalMask(seqLen, seqLen));
            } else if (name.startsWith("past_key_values.")) {
                inputs.put(name, Nd4j.zeros(DataType.FLOAT, 1, 3, 0, 64));
            }
        }

        Map<String, INDArray> result = decoder.output(inputs, allOutputNames.toArray(new String[0]));

        INDArray logits = result.get(logitsName);
        int firstToken = logits.get(NDArrayIndex.point(0), NDArrayIndex.point(seqLen - 1), NDArrayIndex.all())
                .argMax().getInt(0);

        List<Integer> generated = new ArrayList<>();
        generated.add(firstToken);

        Map<String, INDArray> kvCache = new HashMap<>();
        for (String kvName : kvOutputNames) {
            String pastName = kvName.replace("present", "past_key_values");
            kvCache.put(pastName, result.get(kvName).dup());
        }
        long pastLen = seqLen;

        for (int step = 1; step < MAX_STEPS; step++) {
            int prevToken = generated.get(generated.size() - 1);
            INDArray tokenEmbed = embeddingTable.getRow(prevToken).reshape(1, 1, hiddenSize);

            Map<String, INDArray> decInputs = new HashMap<>();
            for (String name : decoder.inputs()) {
                if (name.equals("inputs_embeds")) {
                    decInputs.put(name, tokenEmbed);
                } else if (name.equals("input_ids")) {
                    decInputs.put(name, Nd4j.createFromArray(new int[]{prevToken}).reshape(1, 1).castTo(DataType.LONG));
                } else if (name.equals("attention_mask")) {
                    decInputs.put(name, Nd4j.ones(DataType.LONG, 1, pastLen + 1));
                } else if (name.equals("position_ids")) {
                    decInputs.put(name, Nd4j.createFromArray(new long[]{pastLen}).reshape(1, 1));
                } else if (name.equals("_causal_mask")) {
                    decInputs.put(name, DecoderUtils.buildCausalMask(1, pastLen + 1));
                } else if (name.startsWith("past_key_values.") && kvCache.containsKey(name)) {
                    decInputs.put(name, kvCache.get(name));
                }
            }

            result = decoder.output(decInputs, allOutputNames.toArray(new String[0]));
            logits = result.get(logitsName);
            int nextToken = logits.get(NDArrayIndex.point(0), NDArrayIndex.point(0), NDArrayIndex.all())
                    .argMax().getInt(0);
            generated.add(nextToken);

            for (String kvName : kvOutputNames) {
                String pastName = kvName.replace("present", "past_key_values");
                kvCache.put(pastName, result.get(kvName).dup());
            }
            pastLen++;
        }

        log.info("Manual + _causal_mask: {} tokens", generated.size());
        log.info("Tokens: {}", generated.subList(0, Math.min(15, generated.size())));
        Set<Integer> unique = new HashSet<>(generated);
        log.info("Unique: {}/{}", unique.size(), generated.size());
        assertTrue(unique.size() >= 5,
                "Manual decode WITH _causal_mask should produce diverse tokens, got " + unique.size());
    }

    // ==================== Helpers ====================

    private INDArray buildPrefillEmbeddings(int[] tokens, long hiddenSize) {
        INDArray result = Nd4j.create(DataType.FLOAT, 1, tokens.length, hiddenSize);
        for (int i = 0; i < tokens.length; i++) {
            INDArray embed = embeddingTable.getRow(tokens[i]);
            result.get(NDArrayIndex.point(0), NDArrayIndex.point(i), NDArrayIndex.all()).assign(embed);
        }
        return result;
    }

    private List<Integer> runManualDecode(INDArray prefillEmbeds, long seqLen, long hiddenSize) {
        Map<String, INDArray> inputs = new HashMap<>();
        for (String name : decoder.inputs()) {
            if (name.equals("inputs_embeds")) inputs.put(name, prefillEmbeds);
            else if (name.equals("attention_mask")) inputs.put(name, Nd4j.ones(DataType.LONG, 1, seqLen));
            else if (name.equals("position_ids")) inputs.put(name, Nd4j.arange(seqLen).reshape(1, seqLen).castTo(DataType.LONG));
            else if (name.startsWith("past_key_values.")) inputs.put(name, Nd4j.zeros(DataType.FLOAT, 1, 3, 0, 64));
        }

        Map<String, INDArray> result = decoder.output(inputs, allOutputNames.toArray(new String[0]));

        INDArray logits = result.get(logitsName);
        int firstToken = logits.get(NDArrayIndex.point(0), NDArrayIndex.point(seqLen - 1), NDArrayIndex.all())
                .argMax().getInt(0);

        List<Integer> generated = new ArrayList<>();
        generated.add(firstToken);

        Map<String, INDArray> kvCache = new HashMap<>();
        for (String kvName : kvOutputNames) {
            String pastName = kvName.replace("present", "past_key_values");
            kvCache.put(pastName, result.get(kvName).dup());
        }
        long pastLen = seqLen;

        for (int step = 1; step < MAX_STEPS; step++) {
            int prevToken = generated.get(generated.size() - 1);
            INDArray tokenEmbed = embeddingTable.getRow(prevToken).reshape(1, 1, hiddenSize);

            Map<String, INDArray> decInputs = new HashMap<>();
            for (String name : decoder.inputs()) {
                if (name.equals("inputs_embeds")) decInputs.put(name, tokenEmbed);
                else if (name.equals("input_ids"))
                    decInputs.put(name, Nd4j.createFromArray(new int[]{prevToken}).reshape(1, 1).castTo(DataType.LONG));
                else if (name.equals("attention_mask")) decInputs.put(name, Nd4j.ones(DataType.LONG, 1, pastLen + 1));
                else if (name.equals("position_ids"))
                    decInputs.put(name, Nd4j.createFromArray(new long[]{pastLen}).reshape(1, 1));
                else if (name.startsWith("past_key_values.") && kvCache.containsKey(name))
                    decInputs.put(name, kvCache.get(name));
            }

            result = decoder.output(decInputs, allOutputNames.toArray(new String[0]));
            logits = result.get(logitsName);
            int nextToken = logits.get(NDArrayIndex.point(0), NDArrayIndex.point(0), NDArrayIndex.all())
                    .argMax().getInt(0);
            generated.add(nextToken);

            for (String kvName : kvOutputNames) {
                String pastName = kvName.replace("present", "past_key_values");
                kvCache.put(pastName, result.get(kvName).dup());
            }
            pastLen++;
        }

        return generated;
    }

    private List<Integer> runStaticKvDecode(INDArray prefillEmbeds, long seqLen, long hiddenSize,
                                            List<String> decoderInputNames) {
        List<String> keyNames = new ArrayList<>();
        List<String> valueNames = new ArrayList<>();
        for (String kvName : kvOutputNames) {
            if (kvName.contains(".key")) keyNames.add(kvName);
            else if (kvName.contains(".value")) valueNames.add(kvName);
        }

        Map<String, INDArray> inputs = DecoderUtils.buildDecoderInputMap(
                decoderInputNames, decoder,
                prefillEmbeds, null,
                0, seqLen,
                null, 0, 0,
                false, hiddenSize);

        Map<String, INDArray> result = decoder.output(inputs, allOutputNames.toArray(new String[0]));

        INDArray logits = result.get(logitsName);
        int firstToken = logits.get(NDArrayIndex.point(0), NDArrayIndex.point(seqLen - 1), NDArrayIndex.all())
                .argMax().getInt(0);

        List<Integer> generated = new ArrayList<>();
        generated.add(firstToken);

        long maxKvLen = seqLen + MAX_STEPS;
        Map<String, INDArray> staticKvBuffers = DecoderUtils.padKvCacheToStaticSize(
                result, keyNames, valueNames, maxKvLen);
        Nd4j.getExecutioner().commit();
        long cachePos = seqLen;
        long pastSeqLen = seqLen;

        for (int step = 1; step < MAX_STEPS; step++) {
            int prevToken = generated.get(generated.size() - 1);
            INDArray tokenEmbed = embeddingTable.getRow(prevToken).reshape(1, 1, hiddenSize);
            INDArray inputIds = Nd4j.createFromArray(new int[]{prevToken}).reshape(1, 1).castTo(DataType.LONG);

            Map<String, INDArray> decInputs = DecoderUtils.buildDecoderInputMap(
                    decoderInputNames, decoder,
                    tokenEmbed, inputIds,
                    pastSeqLen, 1,
                    staticKvBuffers, maxKvLen, cachePos,
                    true, hiddenSize,
                    null, false);

            result = decoder.output(decInputs, allOutputNames.toArray(new String[0]));

            logits = result.get(logitsName);
            int nextToken = logits.get(NDArrayIndex.point(0), NDArrayIndex.point(0), NDArrayIndex.all())
                    .argMax().getInt(0);
            generated.add(nextToken);

            DecoderUtils.scatterNewKvEntries(staticKvBuffers, result,
                    keyNames, valueNames, maxKvLen, cachePos);
            cachePos++;
            pastSeqLen++;
        }

        return generated;
    }
}
