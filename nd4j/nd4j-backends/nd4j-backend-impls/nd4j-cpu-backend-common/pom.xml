<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>nd4j-backend-impls</artifactId>
        <groupId>org.eclipse.deeplearning4j</groupId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>nd4j-cpu-backend-common</artifactId>
    <packaging>jar</packaging>

    <name>nd4j-cpu-backend-common</name>

    <properties>
        <skipPublishing>false</skipPublishing>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Java 9 module name does not allow native-->
        <module.name>nd4j.cpu.backend.common</module.name>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.moditect</groupId>
                <artifactId>moditect-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>org.eclipse.deeplearning4j</groupId>
            <artifactId>nd4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.deeplearning4j</groupId>
            <artifactId>nd4j-native-api</artifactId>
        </dependency>
        <!-- Compile the backend-neutral LAPACK delegator here. Runtime backends
             provide their own OpenBLAS platform artifact and native payload. -->
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>openblas</artifactId>
            <version>${openblas.version}-${javacpp-presets.version}</version>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
