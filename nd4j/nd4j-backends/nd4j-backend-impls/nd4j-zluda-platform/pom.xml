<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <artifactId>nd4j-backend-impls</artifactId>
        <groupId>org.eclipse.deeplearning4j</groupId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>nd4j-zluda-12.9-platform</artifactId>
    <name>nd4j-zluda-12.9-platform</name>

    <properties>
        <skipPublishing>false</skipPublishing>
        <!-- CUDA identifies the build-time ABI/toolchain. The runtime payload
             and dependency graph are owned entirely by the ZLUDA artifact. -->
        <cuda.version>12.9</cuda.version>
        <nd4j.backend>nd4j-zluda-${cuda.version}</nd4j.backend>
    </properties>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>nd4j-zluda-12.9</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>zluda-linux-amd64</id>
            <activation>
                <os>
                    <name>Linux</name>
                    <arch>amd64</arch>
                </os>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>${project.groupId}</groupId>
                    <artifactId>${nd4j.backend}</artifactId>
                    <version>${project.version}</version>
                    <classifier>linux-x86_64-zluda</classifier>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>zluda-linux-x86_64</id>
            <activation>
                <os>
                    <name>Linux</name>
                    <arch>x86_64</arch>
                </os>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>${project.groupId}</groupId>
                    <artifactId>${nd4j.backend}</artifactId>
                    <version>${project.version}</version>
                    <classifier>linux-x86_64-zluda</classifier>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>zluda-windows-amd64</id>
            <activation>
                <os>
                    <family>windows</family>
                    <arch>amd64</arch>
                </os>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>${project.groupId}</groupId>
                    <artifactId>${nd4j.backend}</artifactId>
                    <version>${project.version}</version>
                    <classifier>windows-x86_64-zluda</classifier>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>zluda-windows-x86_64</id>
            <activation>
                <os>
                    <family>windows</family>
                    <arch>x86_64</arch>
                </os>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>${project.groupId}</groupId>
                    <artifactId>${nd4j.backend}</artifactId>
                    <version>${project.version}</version>
                    <classifier>windows-x86_64-zluda</classifier>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
