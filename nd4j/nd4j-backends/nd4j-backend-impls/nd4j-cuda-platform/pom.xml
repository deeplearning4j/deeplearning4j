<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.eclipse.deeplearning4j</groupId>
        <artifactId>nd4j-backend-impls</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>nd4j-cuda-12.9-platform</artifactId>
    <name>nd4j-cuda-12.9-platform</name>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <executions>
                    <execution>
                        <id>central-javadoc</id>
                        <configuration>
                            <!-- The aggregator's only source is its package
                                 documentation; point Javadoc at it explicitly. -->
                            <sourcepath>${project.basedir}/src/main/java</sourcepath>
                            <subpackages>org.nd4j.linalg.platform.cuda</subpackages>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <properties>
        <skipPublishing>false</skipPublishing>
        <!-- CUDA version is linked with the artifact name so cannot move to parent pom.xml -->
        <cuda.version>12.9</cuda.version>
        <cudnn.version>9.10</cudnn.version>
        <javacpp-presets.cuda.version>1.5.12</javacpp-presets.cuda.version>
        <nd4j.backend>nd4j-cuda-12.9</nd4j.backend>
    </properties>



    <dependencies>
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>cuda-platform</artifactId>
            <version>${cuda.version}-${cudnn.version}-${javacpp-presets.cuda.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>${nd4j.backend}</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>${nd4j.backend}</artifactId>
            <version>${project.version}</version>
            <classifier>${javacpp.platform.linux-x86_64}</classifier>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>${nd4j.backend}</artifactId>
            <version>${project.version}</version>
            <classifier>${javacpp.platform.windows-x86_64}</classifier>
        </dependency>

    </dependencies>

    <profiles>
        <!-- cuDNN is a backend helper, not a platform extension. -->
        <profile>
            <id>cudnn</id>
            <activation>
                <property>
                    <name>libnd4j.helper</name>
                    <value>cudnn</value>
                </property>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>${project.groupId}</groupId>
                    <artifactId>${nd4j.backend}</artifactId>
                    <version>${project.version}</version>
                    <classifier>${javacpp.platform.linux-x86_64}-cudnn</classifier>
                </dependency>
                <dependency>
                    <groupId>${project.groupId}</groupId>
                    <artifactId>${nd4j.backend}</artifactId>
                    <version>${project.version}</version>
                    <classifier>${javacpp.platform.windows-x86_64}-cudnn</classifier>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

</project>
