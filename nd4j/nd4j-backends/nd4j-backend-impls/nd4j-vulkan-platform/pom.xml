<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.eclipse.deeplearning4j</groupId>
        <artifactId>nd4j-backend-impls</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>nd4j-vulkan-platform</artifactId>
    <name>nd4j-vulkan-platform</name>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <executions>
                    <execution>
                        <id>central-javadoc</id>
                        <configuration>
                            <!-- The aggregator's only source is its package
                                 documentation; point Javadoc at it explicitly. -->
                            <sourcepath>${project.basedir}/src/main/java</sourcepath>
                            <subpackages>org.nd4j.linalg.platform.vulkan</subpackages>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <properties>
        <skipPublishing>false</skipPublishing>
        <nd4j.backend>nd4j-vulkan</nd4j.backend>
    </properties>

    <!--
      JavaCPP's platform detection supplies javacpp.platform from the current
      target OS/ABI (or from an explicit javacpp.platform cross-build target).
      Resolve exactly that classifier instead of making every Android and desktop
      binary a transitive dependency. The selected classifier remains vendor-neutral:
      Android uses its platform Vulkan API and desktop systems use the installed
      Vulkan loader; the Vulkan device API selects AMD, NVIDIA, Intel, or mobile
      hardware at runtime.
    -->
    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>${nd4j.backend}</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>${nd4j.backend}</artifactId>
            <version>${project.version}</version>
            <classifier>${javacpp.platform}${javacpp.platform.extension}</classifier>
        </dependency>
    </dependencies>

</project>
