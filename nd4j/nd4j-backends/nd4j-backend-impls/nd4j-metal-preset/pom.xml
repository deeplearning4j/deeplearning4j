<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.eclipse.deeplearning4j</groupId>
        <artifactId>nd4j-backend-impls</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>nd4j-metal-preset</artifactId>

    <name>nd4j-metal-preset</name>
    <description>JavaCPP Presets for ND4J Metal Backend (Apple Silicon: MLX + MPS + Metal ICB).
Native compile requires macOS arm64 + Xcode + MLX installed via SD_MLX=ON.
The preset class is compilable on all platforms; generated bindings require macOS.</description>

    <properties>
        <skipPublishing>false</skipPublishing>
        <module.name>nd4j.metal.preset</module.name>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.eclipse.deeplearning4j</groupId>
            <artifactId>nd4j-presets-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- NOTE: The standard preset template's ${dependency.*} platform-classified artifact
             dependency is intentionally omitted until a native libnd4j Metal/MLX chip build exists
             (requires macOS arm64 with -Dlibnd4j.helper=mps -DSD_MLX=ON). Restore when the
             Metal/MLX bindings land. Pattern follows nd4j-tpu-preset. -->

        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>javacpp</artifactId>
        </dependency>
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>javacpp</artifactId>
            <classifier>${dependency.platform}</classifier>
        </dependency>

        <dependency>
            <groupId>org.eclipse.deeplearning4j</groupId>
            <artifactId>nd4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.deeplearning4j</groupId>
            <artifactId>nd4j-native-api</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.moditect</groupId>
                <artifactId>moditect-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                        </manifest>
                        <manifestEntries>
                            <Automatic-Module-Name>${module.name}</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Profile for generating JavaCPP bindings on macOS arm64 + Xcode. -->
        <profile>
            <id>javacpp</id>
            <activation>
                <property>
                    <name>javacpp.generate</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.bytedeco</groupId>
                        <artifactId>javacpp</artifactId>
                        <version>${javacpp.version}</version>
                        <executions>
                            <execution>
                                <id>javacpp.parser</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>parse</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.sourceDirectory}</outputDirectory>
                                    <classOrPackageNames>
                                        <classOrPackageName>org.nd4j.presets.metal.Nd4jMetalPresets</classOrPackageName>
                                    </classOrPackageNames>
                                </configuration>
                            </execution>
                            <execution>
                                <id>javacpp.compiler</id>
                                <phase>process-classes</phase>
                                <goals>
                                    <goal>build</goal>
                                </goals>
                                <configuration>
                                    <classOrPackageNames>
                                        <classOrPackageName>org.nd4j.linalg.metal.bindings.Nd4jMetal</classOrPackageName>
                                    </classOrPackageNames>
                                    <copyLibs>true</copyLibs>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
