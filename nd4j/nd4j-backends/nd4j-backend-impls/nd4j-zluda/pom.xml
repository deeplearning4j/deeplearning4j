<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.eclipse.deeplearning4j</groupId>
        <artifactId>nd4j-backend-impls</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>nd4j-zluda-12.9</artifactId>
    <name>nd4j-zluda-12.9</name>
    <description>ND4J ZLUDA Backend - Self-contained CUDA ABI translation for AMD GPUs via HIP/ROCm</description>

    <properties>
        <skipPublishing>false</skipPublishing>
        <!-- ZLUDA executes binaries produced by this exact CUDA toolchain line.
             Keep the version in the published Maven identity. -->
        <cuda.version>12.9</cuda.version>
        <module.name>nd4j.zluda</module.name>
    </properties>

    <dependencies>
        <!-- ND4J API -->
        <dependency>
            <groupId>org.eclipse.deeplearning4j</groupId>
            <artifactId>nd4j-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Shared Java-side CUDA implementation, including the generated Java
             binding. Native payloads are supplied only by -platform. -->
        <dependency>
            <groupId>org.eclipse.deeplearning4j</groupId>
            <artifactId>nd4j-cuda-backend-common</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.moditect</groupId>
                <artifactId>moditect-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>11</source>
                    <target>11</target>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                        </manifest>
                        <manifestEntries>
                            <Automatic-Module-Name>${module.name}</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Re-home the native payload produced by the CUDA compiler under the
             ZLUDA artifact identity. The dependency is build-only: consumers of
             nd4j-zluda never resolve nd4j-cuda or its NVIDIA platform artifacts. -->
        <profile>
            <id>zluda-native-bundle</id>
            <activation>
                <property>
                    <name>libnd4j.zluda</name>
                </property>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>${project.groupId}</groupId>
                    <artifactId>nd4j-cuda-${cuda.version}</artifactId>
                    <version>${project.version}</version>
                    <classifier>${javacpp.platform}${javacpp.platform.extension}</classifier>
                    <scope>provided</scope>
                    <optional>true</optional>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.1.2</version>
                        <executions>
                            <execution>
                                <id>stage-zluda-native-classifier</id>
                                <phase>process-resources</phase>
                                <goals>
                                    <goal>unpack</goal>
                                </goals>
                                <configuration>
                                    <artifactItems>
                                        <artifactItem>
                                            <groupId>${project.groupId}</groupId>
                                            <artifactId>nd4j-cuda-${cuda.version}</artifactId>
                                            <version>${project.version}</version>
                                            <classifier>${javacpp.platform}${javacpp.platform.extension}</classifier>
                                            <type>jar</type>
                                            <overWrite>true</overWrite>
                                            <outputDirectory>${project.build.directory}/zluda-native</outputDirectory>
                                            <includes>org/nd4j/linalg/jcublas/bindings/**,META-INF/native-image/**</includes>
                                        </artifactItem>
                                    </artifactItems>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-zluda-native-classifier</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                                <configuration>
                                    <classesDirectory>${project.build.directory}/zluda-native</classesDirectory>
                                    <classifier>${javacpp.platform}${javacpp.platform.extension}</classifier>
                                    <skipIfEmpty>false</skipIfEmpty>
                                    <archive>
                                        <manifestEntries>
                                            <Automatic-Module-Name>${module.name}.binary</Automatic-Module-Name>
                                            <ND4J-ZLUDA-Target>AMD</ND4J-ZLUDA-Target>
                                            <ND4J-ZLUDA-CUDA-Build-Version>${cuda.version}</ND4J-ZLUDA-CUDA-Build-Version>
                                        </manifestEntries>
                                    </archive>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Profile for AMD GPU target -->
        <profile>
            <id>zluda-amd</id>
            <properties>
                <zluda.target>AMD</zluda.target>
            </properties>
        </profile>

    </profiles>
</project>
