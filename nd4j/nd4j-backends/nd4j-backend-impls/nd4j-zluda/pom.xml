<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.eclipse.deeplearning4j</groupId>
        <artifactId>nd4j-backend-impls</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>nd4j-zluda-12.9</artifactId>
    <name>nd4j-zluda-12.9</name>
    <description>ND4J ZLUDA Backend - Enables CUDA code to run on AMD and Intel GPUs via ZLUDA transpiler</description>

    <properties>
        <skipPublishing>false</skipPublishing>
        <!-- ZLUDA executes binaries produced by this exact CUDA toolchain line.
             Keep the version in the published Maven identity. -->
        <cuda.version>12.9</cuda.version>
        <module.name>nd4j.zluda</module.name>
    </properties>

    <dependencies>
        <!-- ND4J API -->
        <dependency>
            <groupId>org.eclipse.deeplearning4j</groupId>
            <artifactId>nd4j-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Shared Java-side CUDA implementation, including the generated Java
             binding. Native payloads are supplied only by -platform. -->
        <dependency>
            <groupId>org.eclipse.deeplearning4j</groupId>
            <artifactId>nd4j-cuda-backend-common</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.moditect</groupId>
                <artifactId>moditect-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>11</source>
                    <target>11</target>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                        </manifest>
                        <manifestEntries>
                            <Automatic-Module-Name>${module.name}</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Profile for AMD GPU target -->
        <profile>
            <id>zluda-amd</id>
            <properties>
                <zluda.target>AMD</zluda.target>
            </properties>
        </profile>

        <!-- Profile for Intel GPU target -->
        <profile>
            <id>zluda-intel</id>
            <properties>
                <zluda.target>INTEL</zluda.target>
            </properties>
        </profile>
    </profiles>
</project>
