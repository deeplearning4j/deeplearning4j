<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.eclipse.deeplearning4j</groupId>
        <artifactId>nd4j-backend-impls</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>nd4j-zluda-12.9</artifactId>
    <name>nd4j-zluda-12.9</name>
    <description>ND4J ZLUDA Backend - Self-contained CUDA ABI translation for AMD GPUs via HIP/ROCm</description>

    <properties>
        <skipPublishing>false</skipPublishing>
        <!-- ZLUDA executes binaries produced by this exact CUDA toolchain line.
             Keep the version in the published Maven identity. -->
        <cuda.version>12.9</cuda.version>
        <!-- The release plan passes the selected ROCm version so the native
             classifier and manifest identify the exact AMD runtime bundle. -->
        <rocm.version>7.2.4</rocm.version>
        <cudnn.version>9.10</cudnn.version>
        <javacpp-presets.cuda.version>1.5.12</javacpp-presets.cuda.version>
        <javacpp.build.output.path>${project.build.directory}/classes/org/nd4j/linalg/jcublas/bindings/${javacpp.platform}${javacpp.platform.extension}</javacpp.build.output.path>
        <libnd4j.outputPath>${project.build.directory}/../../../../../libnd4j/blasbuild/cuda</libnd4j.outputPath>
        <zluda.runtime.package>${libnd4j.outputPath}/zluda-runtime-package</zluda.runtime.package>
        <!-- The runtime package is produced by CMake and uses the native
             library names of the target platform. Keep these checks in sync
             with the files JavaCPP will extract from the classifier. -->
        <zluda.native.library>libnd4jcuda.so</zluda.native.library>
        <zluda.cuda.abi.library>libcuda.so</zluda.cuda.abi.library>
        <zluda.accelerator.runtime.library>libamdhip64.so</zluda.accelerator.runtime.library>
        <zluda.hsa.runtime.library>libhsa-runtime64.so.1</zluda.hsa.runtime.library>
        <zluda.hsakmt.runtime.library>libhsakmt.so.1</zluda.hsakmt.runtime.library>
        <zluda.jni.library>libjnind4jcuda.so</zluda.jni.library>
        <module.name>nd4j.zluda</module.name>
    </properties>

    <dependencies>
        <!-- ND4J API -->
        <dependency>
            <groupId>org.eclipse.deeplearning4j</groupId>
            <artifactId>nd4j-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Shared Java-side CUDA implementation, including the generated Java
             binding. Native payloads are supplied only by -platform. -->
        <dependency>
            <groupId>org.eclipse.deeplearning4j</groupId>
            <artifactId>nd4j-cuda-backend-common</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <version>${junit.platform.launcher.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.moditect</groupId>
                <artifactId>moditect-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- JavaCPP-generated JNI sources can preserve non-ASCII
                         bytes from native comments. -->
                    <encoding>ISO-8859-1</encoding>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                        </manifest>
                        <manifestEntries>
                            <Automatic-Module-Name>${module.name}</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                    <excludes>
                        <exclude>org/nd4j/linalg/jcublas/bindings/${javacpp.platform}${javacpp.platform.extension}/*</exclude>
                        <exclude>lib/**</exclude>
                        <exclude>*.dll</exclude>
                        <exclude>*.dylib</exclude>
                        <exclude>*.so</exclude>
                        <exclude>META-INF/native-image/${javacpp.platform}${javacpp.platform.extension}/</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Build and attach the ZLUDA JNI/native payload directly.  libnd4j's
             CMake build owns the pinned ZLUDA and AMD runtime closure; this
             module owns the resulting platform classifier. -->
        <profile>
            <id>zluda-native</id>
            <activation>
                <property>
                    <name>libnd4j.zluda</name>
                </property>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>${project.groupId}</groupId>
                    <artifactId>libnd4j</artifactId>
                    <version>${project.version}</version>
                    <type>pom</type>
                    <scope>provided</scope>
                </dependency>
                <dependency>
                    <groupId>${project.groupId}</groupId>
                    <artifactId>nd4j-cuda-${cuda.version}-preset</artifactId>
                    <version>${project.version}</version>
                    <scope>provided</scope>
                    <optional>true</optional>
                </dependency>
                <dependency>
                    <groupId>org.bytedeco</groupId>
                    <artifactId>javacpp</artifactId>
                    <version>${javacpp.version}</version>
                    <classifier>${dependency.platform}</classifier>
                    <scope>provided</scope>
                    <optional>true</optional>
                </dependency>
                <dependency>
                    <groupId>${project.groupId}</groupId>
                    <artifactId>nd4j-native-api</artifactId>
                    <version>${project.version}</version>
                    <scope>provided</scope>
                    <optional>true</optional>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>verify-zluda-cmake-runtime-package</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target name="verify-zluda-cmake-runtime-package">
                                        <fail message="CMake ZLUDA runtime package is missing ${zluda.native.library}">
                                            <condition><not><available file="${zluda.runtime.package}/${zluda.native.library}"/></not></condition>
                                        </fail>
                                        <fail message="CMake ZLUDA runtime package is missing the ZLUDA CUDA ABI (${zluda.cuda.abi.library})">
                                            <condition><not><available file="${zluda.runtime.package}/${zluda.cuda.abi.library}"/></not></condition>
                                        </fail>
                                        <fail message="CMake ZLUDA runtime package is missing its accelerator runtime (${zluda.accelerator.runtime.library})">
                                            <condition><not><available file="${zluda.runtime.package}/${zluda.accelerator.runtime.library}"/></not></condition>
                                        </fail>
                                        <fail message="CMake ZLUDA runtime package is missing the HSA runtime matched to its ROCm SDK (${zluda.hsa.runtime.library})">
                                            <condition>
                                                <and>
                                                    <not><os family="windows"/></not>
                                                    <not><available file="${zluda.runtime.package}/${zluda.hsa.runtime.library}"/></not>
                                                </and>
                                            </condition>
                                        </fail>
                                        <fail message="CMake ZLUDA runtime package is missing the ROCt thunk matched to its HSA runtime (${zluda.hsakmt.runtime.library})">
                                            <condition>
                                                <and>
                                                    <not><os family="windows"/></not>
                                                    <not><available file="${zluda.runtime.package}/${zluda.hsakmt.runtime.library}"/></not>
                                                </and>
                                            </condition>
                                        </fail>
                                        <fail message="CMake ZLUDA runtime package is missing its closure manifest">
                                            <condition><not><available file="${zluda.runtime.package}/shared-runtime-manifest.txt"/></not></condition>
                                        </fail>
                                        <fail message="JavaCPP ZLUDA JNI library was not generated (${zluda.jni.library})">
                                            <condition><not><available file="${javacpp.build.output.path}/${zluda.jni.library}"/></not></condition>
                                        </fail>
                                    </target>
                                </configuration>
                            </execution>
                            <!-- The CMake output directory contains the full native build
                                 tree plus a self-contained classifier package. Once the
                                 runtime package and JNI wrapper have been validated,
                                 discard build-only objects before Maven copies the package
                                 into target/classes; otherwise the duplicate native closure
                                 can exhaust GitHub runner disk during prepare-package. -->
                            <execution>
                                <id>cleanup-zluda-cmake-build</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target name="cleanup-zluda-cmake-build">
                                        <delete includeEmptyDirs="true">
                                            <fileset dir="${libnd4j.outputPath}"
                                                     excludes="zluda-runtime-package/**,javacpp-build-toolchain.properties"/>
                                        </delete>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>copy-zluda-cmake-runtime-package</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${javacpp.build.output.path}</outputDirectory>
                                    <overwrite>true</overwrite>
                                    <resources>
                                        <resource>
                                            <directory>${zluda.runtime.package}</directory>
                                            <filtering>false</filtering>
                                            <includes>
                                                <include>**/*</include>
                                            </includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-zluda-native-classifier</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                                <configuration>
                                    <classifier>${javacpp.platform}${javacpp.platform.extension}</classifier>
                                    <skipIfEmpty>true</skipIfEmpty>
                                    <!-- The module-level exclusions keep native files out of
                                         the unclassified Java JAR. This classified execution must
                                         replace, not inherit, those exclusions. -->
                                    <excludes combine.self="override"/>
                                    <includes>
                                        <include>org/nd4j/linalg/jcublas/bindings/${javacpp.platform}${javacpp.platform.extension}/*</include>
                                        <include>lib/**</include>
                                        <include>META-INF/native-image/${javacpp.platform}${javacpp.platform.extension}/</include>
                                    </includes>
                                    <archive>
                                        <manifestEntries>
                                            <Automatic-Module-Name>${module.name}.binary</Automatic-Module-Name>
                                            <ND4J-ZLUDA-Target>AMD</ND4J-ZLUDA-Target>
                                            <ND4J-ZLUDA-CUDA-Build-Version>${cuda.version}</ND4J-ZLUDA-CUDA-Build-Version>
                                            <ND4J-ZLUDA-ROCm-Version>${rocm.version}</ND4J-ZLUDA-ROCm-Version>
                                        </manifestEntries>
                                    </archive>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.bytedeco</groupId>
                        <artifactId>javacpp</artifactId>
                        <version>${javacpp.version}</version>
                        <dependencies>
                            <dependency>
                                <groupId>${project.groupId}</groupId>
                                <artifactId>nd4j-cuda-${cuda.version}-preset</artifactId>
                                <version>${project.version}</version>
                            </dependency>
                            <dependency>
                                <groupId>${project.groupId}</groupId>
                                <artifactId>nd4j-native-api</artifactId>
                                <version>${project.version}</version>
                            </dependency>
                            <!-- Build-host CUDA headers/classes only.  Runtime
                                 libraries are selected from CMake's ZLUDA/AMD
                                 manifest and copied into this classifier. -->
                            <dependency>
                                <groupId>org.bytedeco</groupId>
                                <artifactId>cuda</artifactId>
                                <version>${cuda.version}-${cudnn.version}-${javacpp-presets.cuda.version}</version>
                                <classifier>${dependency.platform}</classifier>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <properties>${javacpp.platform}</properties>
                            <propertyKeysAndValues>
                                <property>
                                    <name>platform.root</name>
                                    <value>${javacpp.platform.root}</value>
                                </property>
                                <property>
                                    <name>platform.compiler</name>
                                    <value>${javacpp.platform.compiler}</value>
                                </property>
                                <property>
                                    <name>platform.sysroot</name>
                                    <value>${javacpp.platform.sysroot}</value>
                                </property>
                            </propertyKeysAndValues>
                            <classPaths>
                                <classPath>${project.build.outputDirectory}</classPath>
                                <classPath>${project.basedir}/../nd4j-cuda-backend-common/target/classes</classPath>
                            </classPaths>
                            <includePaths>
                                <includePath>${libnd4j.outputPath}/include</includePath>
                                <includePath>${libnd4jhome}/blasbuild/cuda/flatbuffers-src/include/</includePath>
                                <includePath>${libnd4jhome}/blas</includePath>
                                <includePath>${libnd4jhome}/include</includePath>
                                <includePath>${libnd4jhome}/include/helpers</includePath>
                                <includePath>${libnd4jhome}/include/array</includePath>
                                <includePath>${libnd4jhome}/include/cnpy</includePath>
                                <includePath>${libnd4jhome}/include/execution</includePath>
                                <includePath>${libnd4jhome}/include/exceptions</includePath>
                                <includePath>${libnd4jhome}/include/graph</includePath>
                                <includePath>${libnd4jhome}/include/indexing</includePath>
                                <includePath>${libnd4jhome}/include/memory</includePath>
                                <includePath>${libnd4jhome}/include/performance</includePath>
                                <includePath>${env.CUDA_PATH}/include</includePath>
                            </includePaths>
                            <linkPaths>
                                <linkPath>${libnd4jhome}/blasbuild/cuda</linkPath>
                            </linkPaths>
                            <compilerOptions>
                                <compilerOption>-std=c++17</compilerOption>
                                <compilerOption>-I${libnd4j.outputPath}/include</compilerOption>
                                <compilerOption>-Wl,--no-undefined</compilerOption>
                                <compilerOption>-L${libnd4jhome}/blasbuild/cuda</compilerOption>
                            </compilerOptions>
                        </configuration>
                        <executions>
                            <execution>
                                <id>build-zluda-jni</id>
                                <phase>process-classes</phase>
                                <goals>
                                    <goal>build</goal>
                                </goals>
                                <configuration>
                                    <skip>${javacpp.compiler.skip}</skip>
                                    <classOrPackageName>org.nd4j.linalg.jcublas.bindings.Nd4jCuda</classOrPackageName>
                                    <clean>true</clean>
                                    <copyLibs>true</copyLibs>
                                    <copyResources>false</copyResources>
                                    <configDirectory>${project.build.directory}/classes/META-INF/native-image/${javacpp.platform}${javacpp.platform.extension}/</configDirectory>
                                    <outputDirectory>${javacpp.build.output.path}</outputDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- JavaCPP's Windows wrapper must match the /MT CUDA toolkit
             archives linked by the ZLUDA native target. -->
        <profile>
            <id>msvc</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
            </activation>
            <properties>
                <zluda.native.library>nd4jcuda.dll</zluda.native.library>
                <zluda.cuda.abi.library>nvcuda.dll</zluda.cuda.abi.library>
                <zluda.accelerator.runtime.library>nvcudart_hybrid64.dll</zluda.accelerator.runtime.library>
                <zluda.jni.library>jnind4jcuda.dll</zluda.jni.library>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.bytedeco</groupId>
                        <artifactId>javacpp</artifactId>
                        <version>${javacpp.version}</version>
                        <configuration>
                            <compilerOptions>
                                <compilerOption>/MT</compilerOption>
                                <compilerOption>/std:c++17</compilerOption>
                            </compilerOptions>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Profile for AMD GPU target -->
        <profile>
            <id>zluda-amd</id>
            <properties>
                <zluda.target>AMD</zluda.target>
            </properties>
        </profile>

    </profiles>
</project>
