<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.eclipse.deeplearning4j</groupId>
        <artifactId>nd4j-backend-impls</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>nd4j-sdx-preset</artifactId>
    <packaging>jar</packaging>

    <name>nd4j-sdx-preset</name>
    <description>SDX standalone runtime — platform-specific native library packaging</description>

    <properties>
        <libnd4j.chip>cpu</libnd4j.chip>
        <sdx.native.lib.dir>${project.basedir}/../../../../libnd4j/blasbuild/${libnd4j.chip}/sdx-runtime-sdk/lib</sdx.native.lib.dir>
    </properties>

    <build>
        <plugins>
            <!-- Copy the native SDX library into the classifier JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <!-- Default JAR (metadata only, no native) -->
                    <execution>
                        <id>default-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                    <!-- Platform-classified JAR with native library -->
                    <execution>
                        <id>platform-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>${javacpp.platform}</classifier>
                            <classesDirectory>${project.build.directory}/native-staging</classesDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Stage native library into a directory for the classifier JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>stage-native-lib</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/native-staging/org/nd4j/dsp/runtime/${javacpp.platform}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${sdx.native.lib.dir}</directory>
                                    <includes>
                                        <include>libsdx_cpu.so</include>
                                        <include>libsdx_cuda.so</include>
                                        <include>sdx_cpu.dll</include>
                                        <include>sdx_cuda.dll</include>
                                        <include>libsdx_cpu.dylib</include>
                                        <include>libsdx_cuda.dylib</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- CUDA builds set libnd4j.chip=cuda, which resolves the default path correctly -->
        <profile>
            <id>cuda</id>
            <activation>
                <property>
                    <name>libnd4j.chip</name>
                    <value>cuda</value>
                </property>
            </activation>
            <properties>
                <libnd4j.chip>cuda</libnd4j.chip>
            </properties>
        </profile>
    </profiles>

</project>
