<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.eclipse.deeplearning4j</groupId>
        <artifactId>nd4j-tokenizers</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>tokenizers-native</artifactId>
    <packaging>jar</packaging>

    <name>tokenizers-native</name>
    <description>JavaCPP generated native bindings for tokenizers</description>

    <properties>
        <!-- Platform-specific output path for native binaries -->
        <javacpp.build.output.path>${project.build.directory}/classes/org/eclipse/deeplearning4j/tokenizers/bindings/${javacpp.platform}${javacpp.platform.extension}</javacpp.build.output.path>
        <javacpp.platform.library.path>natives/${javacpp.platform}</javacpp.platform.library.path>
        <module.name>org.eclipse.deeplearning4j.tokenizers</module.name>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>javacpp</artifactId>
        </dependency>

        <!-- Preset class for JavaCPP -->
        <dependency>
            <groupId>org.eclipse.deeplearning4j</groupId>
            <artifactId>tokenizers-native-preset</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Native library (base jar) -->
        <dependency>
            <groupId>org.eclipse.deeplearning4j</groupId>
            <artifactId>libtokenizers</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Native library (platform-specific jar with .so/.dll/.dylib) -->
        <dependency>
            <groupId>org.eclipse.deeplearning4j</groupId>
            <artifactId>libtokenizers</artifactId>
            <version>${project.version}</version>
            <classifier>${javacpp.platform}</classifier>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <!-- Execution 1: Default jar (Java classes only, no native libs) -->
                    <execution>
                        <id>default-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <excludes>
                                <exclude>org/eclipse/deeplearning4j/tokenizers/bindings/${javacpp.platform}${javacpp.platform.extension}/*</exclude>
                                <exclude>lib/**</exclude>
                                <exclude>*.dll</exclude>
                                <exclude>*.dylib</exclude>
                                <exclude>*.so</exclude>
                                <exclude>META-INF/native-image/${javacpp.platform}${javacpp.platform.extension}/</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                    <!-- Execution 2: Platform-classified jar (native libs only) -->
                    <execution>
                        <id>${javacpp.platform}${javacpp.platform.extension}</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>${javacpp.platform}${javacpp.platform.extension}</classifier>
                            <skipIfEmpty>true</skipIfEmpty>
                            <includes>
                                <include>org/eclipse/deeplearning4j/tokenizers/bindings/${javacpp.platform}${javacpp.platform.extension}/*</include>
                                <include>lib/**</include>
                                <include>META-INF/native-image/${javacpp.platform}${javacpp.platform.extension}/</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.bytedeco</groupId>
                <artifactId>javacpp</artifactId>
                <version>${javacpp.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>org.eclipse.deeplearning4j</groupId>
                        <artifactId>tokenizers-native-preset</artifactId>
                        <version>${project.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <properties>${javacpp.platform}</properties>
                    <outputDirectory>${javacpp.build.output.path}</outputDirectory>
                    <propertyKeysAndValues>
                        <property>
                            <name>platform.root</name>
                            <value>${javacpp.platform.root}</value>
                        </property>
                        <property>
                            <name>platform.compiler</name>
                            <value>${javacpp.platform.compiler}</value>
                        </property>
                        <property>
                            <name>platform.library.path</name>
                            <value>${javacpp.platform.library.path}</value>
                        </property>
                    </propertyKeysAndValues>
                    <classPaths>
                        <classPath>${project.build.outputDirectory}</classPath>
                    </classPaths>
                    <includePaths>
                        <includePath>${project.basedir}/../libtokenizers/target/native/include</includePath>
                        <includePath>${project.basedir}/../libtokenizers/target/native/include/tokenizers</includePath>
                        <includePath>${project.basedir}/../libtokenizers/include</includePath>
                    </includePaths>
                    <linkPaths>
                        <!-- Primary JavaCPP structure path -->
                        <linkPath>${project.basedir}/../libtokenizers/target/native/org/eclipse/deeplearning4j/tokenizers/${javacpp.platform}</linkPath>
                        <!-- Legacy paths -->
                        <linkPath>${project.basedir}/../libtokenizers/target/native/${javacpp.platform}</linkPath>
                        <linkPath>${project.basedir}/../libtokenizers/target/native/lib64</linkPath>
                        <linkPath>${project.basedir}/../libtokenizers/target/native/lib</linkPath>
                        <linkPath>${project.basedir}/../libtokenizers/build</linkPath>
                        <linkPath>${project.build.directory}/native</linkPath>
                    </linkPaths>
                    <resourcePath>${project.basedir}/../libtokenizers/target/native/${javacpp.platform}</resourcePath>
                    <buildResources>
                        <buildResource>/${javacpp.platform.library.path}/</buildResource>
                        <buildResource>/lib/</buildResource>
                        <buildResource>/</buildResource>
                        <buildResource>${project.basedir}/../libtokenizers/target/native/${javacpp.platform}</buildResource>
                    </buildResources>
                    <includeResources>
                        <includeResource>/${javacpp.platform.library.path}/include/</includeResource>
                    </includeResources>
                    <linkResources>
                        <linkResource>/${javacpp.platform.library.path}/</linkResource>
                        <linkResource>/${javacpp.platform.library.path}/lib/</linkResource>
                        <linkResource>${project.basedir}/../libtokenizers/target/native/org/eclipse/deeplearning4j/tokenizers/${javacpp.platform}</linkResource>
                        <linkResource>${project.basedir}/../libtokenizers/target/native/${javacpp.platform}</linkResource>
                    </linkResources>
                </configuration>
                <executions>
                    <execution>
                        <id>javacpp-parser</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>build</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.sourceDirectory}</outputDirectory>
                            <classOrPackageName>org.eclipse.deeplearning4j.tokenizers.presets.TokenizersPresets</classOrPackageName>
                        </configuration>
                    </execution>
                    <execution>
                        <id>javacpp-compiler</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>build</goal>
                        </goals>
                        <configuration>
                            <classOrPackageName>org.eclipse.deeplearning4j.tokenizers.bindings.TokenizersNative</classOrPackageName>
                            <copyLibs>true</copyLibs>
                            <copyResources>true</copyResources>
                            <configDirectory>${project.build.directory}/classes/META-INF/native-image/${javacpp.platform}${javacpp.platform.extension}/</configDirectory>
                            <outputDirectory>${javacpp.build.output.path}</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Copy libtokenizers_wrapper.so to the same location as libjnitokenizers.so -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>copy-wrapper-lib</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <echo message="Copying native libraries to ${javacpp.build.output.path}"/>
                                <copy todir="${javacpp.build.output.path}" failonerror="false" overwrite="true">
                                    <fileset dir="${project.basedir}/../libtokenizers/target/native/org/eclipse/deeplearning4j/tokenizers/${javacpp.platform}">
                                        <include name="libtokenizers_wrapper.so*"/>
                                        <include name="libtokenizers_wrapper.dylib*"/>
                                        <include name="libtokenizers_wrapper.dll*"/>
                                        <include name="libtokenizers_ffi.so*"/>
                                        <include name="libtokenizers_ffi.dylib*"/>
                                        <include name="libtokenizers_ffi.dll*"/>
                                    </fileset>
                                </copy>
                                <copy todir="${javacpp.build.output.path}" failonerror="false" overwrite="true">
                                    <fileset dir="${project.basedir}/../libtokenizers/target/native/${javacpp.platform}">
                                        <include name="libtokenizers_wrapper.so*"/>
                                        <include name="libtokenizers_wrapper.dylib*"/>
                                        <include name="libtokenizers_wrapper.dll*"/>
                                        <include name="libtokenizers_ffi.so*"/>
                                        <include name="libtokenizers_ffi.dylib*"/>
                                        <include name="libtokenizers_ffi.dll*"/>
                                    </fileset>
                                </copy>
                                <echo message="Native libraries in output directory:"/>
                                <exec executable="ls" failonerror="false">
                                    <arg value="-la"/>
                                    <arg value="${javacpp.build.output.path}"/>
                                </exec>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>linux-x86_64</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>linux</name>
                    <arch>amd64</arch>
                </os>
            </activation>
            <properties>
                <javacpp.platform>linux-x86_64</javacpp.platform>
                <javacpp.platform.root>/usr</javacpp.platform.root>
                <javacpp.platform.compiler>g++</javacpp.platform.compiler>
            </properties>
        </profile>

        <profile>
            <id>windows-x86_64</id>
            <activation>
                <os>
                    <family>windows</family>
                    <arch>amd64</arch>
                </os>
            </activation>
            <properties>
                <javacpp.platform>windows-x86_64</javacpp.platform>
                <javacpp.platform.compiler>cl.exe</javacpp.platform.compiler>
            </properties>
        </profile>

        <profile>
            <id>macosx-x86_64</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>x86_64</arch>
                </os>
            </activation>
            <properties>
                <javacpp.platform>macosx-x86_64</javacpp.platform>
                <javacpp.platform.compiler>clang++</javacpp.platform.compiler>
            </properties>
        </profile>

        <profile>
            <id>macosx-arm64</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <javacpp.platform>macosx-arm64</javacpp.platform>
                <javacpp.platform.compiler>clang++</javacpp.platform.compiler>
            </properties>
        </profile>
    </profiles>

</project>
