{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplearning4j.org/schemas/dsp/manifest.schema.json",
  "title": "DSP Bundle Manifest",
  "description": "Schema for self-contained DSP bundle metadata.",
  "type": "object",
  "required": [
    "formatVersion",
    "modelId",
    "modelPath",
    "compatibility"
  ],
  "properties": {
    "formatVersion": {
      "type": "integer",
      "minimum": 1
    },
    "modelId": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "tool",
        "version"
      ],
      "additionalProperties": true
    },
    "modelPath": {
      "type": "string",
      "minLength": 1
    },
    "graphSignature": {
      "type": "object",
      "properties": {
        "inputs": {
          "type": "array"
        },
        "outputs": {
          "type": "array"
        },
        "shapePolicy": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "segments": {
      "type": "array"
    },
    "weights": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "runtimeRequirements": {
      "type": "array"
    },
    "preferredBackends": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gpuTarget": {
      "type": "string",
      "enum": [
        "AUTO",
        "CUDA",
        "AMD",
        "VULKAN",
        "METAL"
      ]
    },
    "compiledArtifacts": {
      "type": "object",
      "properties": {
        "vulkanSpirv": {
          "type": "string",
          "minLength": 1
        },
        "metalLibrary": {
          "type": "string",
          "minLength": 1
        },
        "hexagonKernels": {
          "type": "string",
          "minLength": 1,
          "description": "Directory of shape-keyed Qualcomm Hexagon/HTP AOT kernels and metadata sidecars."
        },
        "hexagonManifest": {
          "type": "string",
          "minLength": 1,
          "description": "Deterministic manifest for the Hexagon AOT kernel directory."
        },
        "tensorG5LiteRtLm": {
          "type": "object",
          "description": "Tensor G5 direct-NPU derivative compiled from the canonical SameDiff model.",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^artifacts/tensor-g5/[^/]+[.]litertlm$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "textGeneration": {
      "type": "object",
      "description": "Offline text-generation assets. Paths are relative to the bundle root.",
      "properties": {
        "tokenizerPath": {
          "type": "string",
          "minLength": 1,
          "description": "Bundled tokenizer.json used by the portable native chat runtime."
        },
        "configPath": {
          "type": "string",
          "minLength": 1,
          "description": "Bundled text-generation IO, KV-cache, token, and sampling metadata."
        }
      },
      "additionalProperties": false
    },
    "compatibility": {
      "type": "object",
      "required": [
        "minRuntimeAbi",
        "maxRuntimeAbi"
      ],
      "properties": {
        "minRuntimeAbi": {
          "type": "integer",
          "minimum": 1
        },
        "maxRuntimeAbi": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
